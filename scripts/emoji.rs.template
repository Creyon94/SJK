//! Emoji in what players write (`PROTOCOL.md`, "Profile fields"), shared word for word
//! with the hub (`src/emoji.rs` there): which characters are emoji pictures and where
//! the marks that join or change them may stand.
//!
//! GENERATED by `scripts/twemoji_pack.py` in Sol-Vulpes/SJK from the Twemoji pack the
//! client draws (Twemoji @VERSION@): [`PICTOGRAPHS`] holds every code point of U+2000 and
//! above that a Twemoji picture is made of, so a bio or a message holds no emoji SJK
//! cannot draw. Rebuild it with the pack, never edit it by hand.
//!
//! The marks ([`mark`]) only mean something inside an emoji: U+200D joins two pictures
//! (a family), U+FE0F asks for the picture of the character before it, U+20E3 makes a
//! keycap of a digit, `#` or `*`, U+1F3FB..=U+1F3FF give a skin tone and the tags
//! U+E0020..=U+E007F spell a subdivision flag after U+1F3F4. Anywhere else they are
//! invisible characters, which the rules refuse ([`marks_in_place`]).

/// Code points (ranges, inclusive) of U+2000 and above that Twemoji's pictures are made
/// of, the marks left out.
#[rustfmt::skip]
pub const PICTOGRAPHS: &[(u32, u32)] = &[
@RANGES@
];

/// Whether `c` is an emoji picture's own character (not a digit, `#` or `*`, which make
/// a keycap only with U+20E3 after them).
pub fn pictograph(c: char) -> bool {
    let code = u32::from(c);
    PICTOGRAPHS
        .binary_search_by(|&(first, last)| {
            if last < code {
                std::cmp::Ordering::Less
            } else if first > code {
                std::cmp::Ordering::Greater
            } else {
                std::cmp::Ordering::Equal
            }
        })
        .is_ok()
}

/// Whether `c` joins or changes an emoji: the zero-width joiner, the emoji variation
/// selector, the keycap mark, a skin tone or a tag.
pub fn mark(c: char) -> bool {
    matches!(
        u32::from(c),
        0x200D | 0xFE0F | 0x20E3 | 0x1F3FB..=0x1F3FF | 0xE0020..=0xE007F
    )
}

/// Whether every mark of `text` stands inside an emoji: U+FE0F after a picture or a
/// keycap's digit, `#` or `*`; U+20E3 after one of those (or its U+FE0F); a skin tone
/// after a picture; U+200D between a picture (or its marks) and the next picture; a tag
/// after U+1F3F4 or another tag.
pub fn marks_in_place(text: &str) -> bool {
    let chars: Vec<char> = text.chars().collect();
    let keycap_base = |c: char| c.is_ascii_digit() || c == '#' || c == '*';
    let tag = |c: char| matches!(u32::from(c), 0xE0020..=0xE007F);
    for (at, &c) in chars.iter().enumerate() {
        if !mark(c) {
            continue;
        }
        let before = at.checked_sub(1).map(|before| chars[before]);
        let in_place = match c {
            '\u{FE0F}' => before.is_some_and(|b| pictograph(b) || keycap_base(b)),
            '\u{20E3}' => before.is_some_and(|b| {
                keycap_base(b)
                    || (b == '\u{FE0F}'
                        && at >= 2
                        && keycap_base(chars[at - 2]))
            }),
            '\u{200D}' => {
                before.is_some_and(|b| pictograph(b) || (mark(b) && b != '\u{200D}'))
                    && chars.get(at + 1).is_some_and(|&next| pictograph(next))
            }
            c if tag(c) => before.is_some_and(|b| b == '\u{1F3F4}' || tag(b)),
            // A skin tone.
            _ => before.is_some_and(pictograph),
        };
        if !in_place {
            return false;
        }
    }
    true
}

/// `text` without the marks [`marks_in_place`] would refuse, for showing what a hub sent.
pub fn without_stray_marks(text: &str) -> String {
    let mut kept = String::with_capacity(text.len());
    for c in text.chars() {
        let mut trial = kept.clone();
        trial.push(c);
        if !mark(c) || marks_in_place(&trial) {
            kept.push(c);
        }
    }
    // A joiner kept before a picture that never came.
    while kept.ends_with('\u{200D}') {
        kept.pop();
    }
    kept
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn pictographs_are_twemojis_own() {
        for c in ['😀', '🔥', '👍', '❤', '🇫', '🏴', '♥', '⌚', '🫠'] {
            assert!(pictograph(c), "{c}");
        }
        // `™` is one of Twemoji's pictures (and a Windows-1252 character, drawn as text
        // unless U+FE0F follows); `©` is below U+2000, an emoji only with U+FE0F.
        assert!(pictograph('™'));
        for c in ['a', '1', '#', '©', 'Ж', '日', '한', '\u{200D}', '\u{1F3FD}'] {
            assert!(!pictograph(c), "{c}");
        }
        assert!(PICTOGRAPHS.windows(2).all(|pair| pair[0].1 < pair[1].0));
    }

    #[test]
    fn marks_stand_only_inside_emoji() {
        for text in [
            "👍🏽",
            "👨\u{200D}👩\u{200D}👧",
            "❤\u{FE0F} gg",
            "1\u{FE0F}\u{20E3}",
            "#\u{20E3}",
            "🏳\u{FE0F}\u{200D}🌈",
            "🏴\u{E0067}\u{E0062}\u{E0073}\u{E0063}\u{E0074}\u{E007F}",
            "🧑🏽\u{200D}💻",
            "plain text",
        ] {
            assert!(marks_in_place(text), "{text:?}");
        }
        for text in [
            "a\u{200D}b",
            "😀\u{200D}",
            "\u{200D}😀",
            "x\u{FE0F}",
            "a\u{1F3FD}",
            "a\u{E0067}",
            "\u{20E3}",
        ] {
            assert!(!marks_in_place(text), "{text:?}");
        }
        assert_eq!(without_stray_marks("a\u{200D}b😀\u{200D}"), "ab😀");
        assert_eq!(without_stray_marks("👍🏽 x\u{FE0F}"), "👍🏽 x");
    }
}
