// The cardboard box toy's carton (SJK; see README.md): plain board, lit by the
// world's light as a player model is, seen from both sides so the open bottom
// never shows a hole through the far wall.
models/sjk/cardboard_box
{
	cull none
	{
		map models/sjk/cardboard_box
		rgbGen lightingDiffuse
	}
}
