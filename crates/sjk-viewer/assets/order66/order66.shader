// The Order 66 toy's confetti scraps (SJK; see README.md): opaque coloured paper,
// both sides drawn, tinted and faded by the effect.

gfx/sjk/order66/confetti_red
{
	nopicmip
	cull none
	{
		map gfx/sjk/order66/confetti_red
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		rgbGen vertex
		alphaGen vertex
	}
}

