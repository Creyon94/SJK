// The falling blossoms' petals (SJK; saber_petals.rs, scripts/petal_assets.py): a blossom
// petal, both sides drawn, faded by the particle.

gfx/sjk/petals/blossom_pink
{
	nopicmip
	cull none
	{
		map gfx/sjk/petals/blossom_pink
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		rgbGen vertex
		alphaGen vertex
	}
}

gfx/sjk/petals/blossom_pale
{
	nopicmip
	cull none
	{
		map gfx/sjk/petals/blossom_pale
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		rgbGen vertex
		alphaGen vertex
	}
}

gfx/sjk/petals/blossom_white
{
	nopicmip
