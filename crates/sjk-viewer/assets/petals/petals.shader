// The falling blossoms' petals (SJK; saber_petals.rs, scripts/petal_assets.py): a blossom
// petal, both sides drawn, faded by the particle. The Thousand Cranes' paper crane, flying
// right and flying left, white paper the particle tints. The Hearth's ash, grey and glowing.

gfx/sjk/petals/blossom_pink
{
	nopicmip
	cull none
	{
		map gfx/sjk/petals/blossom_pink
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		rgbGen vertex
		alphaGen vertex
	}
}

