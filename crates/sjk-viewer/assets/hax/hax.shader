// The Hax toy's digital rain round a hacked player (SJK; see README.md): white glyphs
// glowing additively, tinted green and faded by the effect.

gfx/sjk/hax/glyph_0
{
	nopicmip
	cull none
	{
		map gfx/sjk/hax/glyph_0
		blendFunc GL_SRC_ALPHA GL_ONE
		rgbGen vertex
		alphaGen vertex
	}
}

