// Puzzle Holocron: a Jedi holocron's puzzle as a blade. The blade is cut into segments with glowing
// seams; one at a time a segment lights, shifts and unlocks, light seeping out round it and a ring
// of light opening at each of its seams; small motes of holocron light rise off it. A clash flares it.
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let seg = floor(b.y / 3.0);
    let cyc = uTime * 0.25;
    let k = floor(cyc);
    let q = fract(cyc);
    let active_ = 1.0 - step(0.5, abs(seg - glsl_mod(k * 5.0, 13.0)));
    let turn = sin(3.1416 * smoothstep(0.0, 0.6, q)) * active_;
    let seam = halo((0.5 - abs(fract(b.y / 3.0) - 0.5)) * 3.0, 0.05);
    let slide = halo(abs(b.x - 0.25 * turn), 0.06) * active_;
    return recol(g, vec3<f32>(0.6, 0.8, 1.0)) * (0.85 + 0.25 * h11(seg)) + lvl(g) * vec3<f32>(0.7, 0.9, 1.0) * (seam * 1.2 + slide * 0.8) * part(0.0);
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c;
}

// the effects, flat round the blade as Sol's are
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let y0 = L * 0.2;
    let y1 = L * 0.97;
    var fx: vec3<f32> = vec3<f32>(0.0);
    let c: vec3<f32> = vec3<f32>(0.6, 0.8, 1.0);
    let k = floor(t * 0.25);
    let q = fract(t * 0.25);
    let ya = 3.0 * glsl_mod(k * 5.0, 13.0);
    let open = sin(3.1416 * q);
    if ya >= y0 - 3.0 {
        fx += fxAura(ro, rd, ya, ya + 3.0, 1.5, c) * open * 1.4 * part(0.0);
        // the unlocking segment's two seams open into rings of light
        let r = 0.6 + 1.4 * smoothstep(0.0, 0.6, q);
        let d = min(ringD(ro, rd, ya, r), ringD(ro, rd, ya + 3.0, r));
        fx += (vec3<f32>(1.0) * halo(d, max(0.04, px)) * 0.9 + c * halo(d, 0.3) * 0.5) * open * part(1.0);
    }
    fx += fxMotes(ro, rd, px, y0, y1, 0.6, 2.4, 14.0, 0.035, 4.2, c) * 0.8 * part(2.0);
    return fx * uFx;
}
