// Liquid Beskar: Mandalorian steel kept molten, as a blade (Creyon's round 9: its droplets and
// sparks in 3D). A thin blade of liquid mirror: a chrome surface reflecting a cool sky and warm
// floor, ripples racing up it, beads of beskar rolling up to the tip and dripping off. Round it in
// 3D, droplets of molten beskar orbit and drip, forge sparks fly and the air shimmers with heat. A
// swing flings a spray of silver droplets off the blade that arc away in 3D; a clash throws a ring
// of droplets out with a shock ring; ignition pours the metal up from the hilt. Round 15 (Creyon:
// it needed more; round 16: no forge fire): tendrils of liquid beskar reach out of the mirror,
// curl and flow back into it, bright with reflections, as living metal.
fn qs_w(y: f32) -> f32 {
    let L = uLength;
    return 0.5 * smoothstep(-0.3, 0.5, y) * (1.0 - smoothstep(L - 0.9, L + 0.05, y)) + 0.05;
}

// fake chrome: what the curved mirror reflects at a slope n (-1..1 across) and height y
fn qs_env(n: f32, y: f32, t: f32) -> vec3<f32> {
    let h = n * 0.9 + 0.12 * sin(y * 0.35 - t * 1.3);
    let sky = mix(vec3<f32>(0.55, 0.65, 0.85), vec3<f32>(0.95, 0.97, 1.0), smoothstep(-0.1, 0.6, h));
    let floor_ = mix(vec3<f32>(0.12, 0.1, 0.12), vec3<f32>(0.4, 0.33, 0.3), smoothstep(-1.0, -0.3, h));
    var c = mix(floor_, sky, smoothstep(-0.25, 0.05, h));
    c += vec3<f32>(1.0) * exp(-pow((h - 0.45) / 0.06, 2.0)) * 1.2;
    // the horizon highlight
    return c;
}

// a mercury drop: sphere shading with a highlight, returns (rgb, coverage)
fn qs_drop(q: vec2<f32>, rad: f32, px: f32) -> vec4<f32> {
    let d = length(q);
    let cov = fillD(d - rad, px);
    if cov <= 0.0 {
        return vec4<f32>(0.0);
    }
    let n = q / max(rad, 1.0e-3);
    var c = qs_env(n.x, n.y * 3.0, 0.0) * (0.65 + 0.35 * sqrt(max(1.0 - dot(n, n), 0.0)));
    c += vec3<f32>(1.0) * exp(-dot(n - vec2<f32>(-0.35, 0.4), n - vec2<f32>(-0.35, 0.4)) * 18.0) * 1.3;
    return vec4(c, cov);
}

// flung droplet k (spray off the blade): position and radius, alive amount
fn qs_fling(fk: f32, t: f32) -> vec4<f32> {
    let L = uLength;
    let rate = 0.4 + 0.25 * h11(fk * 2.3);
    let ph = t * rate + h11(fk * 8.1);
    let cy = floor(ph);
    let f = fract(ph);
    let live = step(h11(cy * 2.9 + fk), 0.45 + 0.55 * uSwing + 0.5 * uClash);
    let s = select(1.0, -1.0, h11(cy * 4.1 + fk) < 0.5);
    let y0 = (0.15 + 0.8 * h11(cy * 1.7 + fk * 3.0)) * L;
    let v = vec2(s * (4.0 + 4.0 * h11(cy + fk * 5.0)), 2.5 * (h11(cy * 6.0 + fk) - 0.2));
    let p = vec2(s * 0.4, y0) + v * f - vec2(0.0, 3.5 * f * f);
    return vec4(p, (0.3 + 0.25 * h11(fk * 4.4)) * (1.0 - 0.4 * f), live * (1.0 - smoothstep(0.8, 1.0, f)));
}

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px_in: f32) -> vec3<f32> {
    var px = px_in;
    let L = uLength;
    px = min(px, 0.06);
    let on = smoothstep(-0.6, 0.3, b.y);
    let edge = 1.0 - smoothstep(6.0, 8.5, abs(b.x));
    let yc = clamp(b.y, 0.0, L - 0.2);
    let d = length(vec2(b.x, b.y - yc));
    // a cool silver sheen round the mirror, ripples brightening it as they pass
    let rip = 0.5 + 0.5 * sin(b.y * 1.6 - uTime * 9.0);
    var light = vec3<f32>(0.75, 0.82, 0.95) * halo(d, 0.9) * (0.35 + 0.25 * rip) * on + vec3<f32>(0.6, 0.7, 0.9) * halo(d, 2.0) * 0.08 * on;
    light *= edge * (1.0 - smoothstep(L + 2.0, L + 6.0, b.y)) * smoothstep(-3.0, -0.5, b.y);
    return (1.0 - exp(-light * 1.1)) * 1.05 * clamp(uIgn * 1.5, 0.0, 1.0);
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return vec3<f32>(0.0);
}

fn sig_solid(o: vec4<f32>, b: vec2<f32>, px_in: f32) -> vec4<f32> {
    var px = px_in;
    px = min(px, 0.06);
    let L = uLength;
    let ign = smoothstep(0.0, 1.5, uAge);
    let fillTo = mix(-0.5, L + 0.1, ign);
    // ignition: the metal pours up
    // ripples bulge the surface: the width wobbles where a ripple passes
    let rip = sin(b.y * 1.6 - uTime * 9.0) * 0.5 + 0.5;
    let w = qs_w(b.y) * (1.0 + 0.12 * rip);
    let cov = fillD(abs(b.x) - w, px) * step(-0.3, b.y) * fillD(b.y - min(L + 0.05, fillTo), px);
    var acc = o;
    if cov > 0.0 {
        let n = b.x / max(w, 0.01);
        let slope = n + 0.25 * cos(b.y * 1.6 - uTime * 9.0);
        // ripples tilt what it reflects
        var c = qs_env(slope, b.y, uTime);
        c *= 0.6 + 0.4 * sqrt(max(1.0 - n * n, 0.0));
        c += vec3<f32>(1.0) * exp(-pow((b.y - glsl_mod(uTime * 14.0, L + 10.0) + 4.0) / 0.6, 2.0)) * 0.5;
        // a sliding glint
        acc = vec4(mix(acc.rgb, c, cov), max(acc.a, cov));
    }
    // beads rolling up the blade, swelling at the tip and dripping off
    for (var k = 0; k < 5; k++) {
        let fk = f32(k);
        let per = 3.0 + fk * 0.7;
        let tt = glsl_mod(uTime + fk * 1.37, per) / per;
        let y = tt * (L + 1.0) - 0.5;
        let side = select(-1.0, 1.0, glsl_mod(fk, 2.0) < 0.5);
        let rad = 0.38 + 0.12 * h11(fk);
        var p = vec2(side * qs_w(y) * 0.9, y);
        // past the tip: it drips off and falls away in an arc
        let past = max(y - L, 0.0);
        p += vec2(side * past * 1.4, past * 0.3 - past * past * 0.9);
        var dr = qs_drop(b - p, rad * (1.0 + 0.4 * smoothstep(L - 3.0, L, y)), px);
        dr.a *= (1.0 - smoothstep(L + 0.5, L + 1.0, y)) * ign;
        acc = vec4(mix(acc.rgb, dr.rgb, dr.a), max(acc.a, dr.a));
    }
    acc.a *= clamp(uIgn * 1.5, 0.0, 1.0);
    return acc;
}

// ---- round 9: the droplets in 3D, mirror spheres ----
// droplet k flung off the blade: centre (xyz) and radius (w); alive when w > 0
fn qs_fling3(fk: f32) -> vec4<f32> {
    let L = uLength;
    let rate = 0.4 + 0.25 * h11(fk * 2.3);
    let ph = uTime * rate + h11(fk * 8.1);
    let cy = floor(ph);
    let f = fract(ph);
    let live = step(h11(cy * 2.9 + fk), 0.25 + 0.75 * uSwing + 0.5 * uClash) * (1.0 - smoothstep(0.8, 1.0, f));
    let a = h11(cy * 4.1 + fk);
    let y0 = (0.2 + 0.75 * h11(cy * 1.7 + fk * 3.0)) * L;
    let dir = vec3(sin(6.2832 * a), 0.5 * (h11(cy * 6.0 + fk) - 0.2), cos(6.2832 * a));
    let p = vec3(0.0, y0, 0.0) + dir * 0.5 + dir * (4.0 + 4.0 * h11(cy + fk * 5.0)) * f - vec3(0.0, 3.5 * f * f, 0.0);
    return vec4(p, (0.3 + 0.25 * h11(fk * 4.4)) * (1.0 - 0.4 * f) * live);
}

// droplet k orbiting slowly round the blade, bobbing like molten metal held by the heat
fn qs_orbit3(fk: f32) -> vec4<f32> {
    let L = uLength;
    let a = h11(fk * 1.9) + uTime * (0.06 + 0.05 * h11(fk * 3.1));
    let y = (0.22 + 0.72 * fract(fk * 0.413 + 0.11)) * L + 0.7 * sin(uTime * 0.8 + fk * 2.0);
    return vec4(around(2.0 + 2.5 * h11(fk * 5.7), a, y), 0.22 + 0.2 * h11(fk * 7.3));
}

// a mirror sphere: (rgb, coverage) where the ray hits it, t its distance
fn qs_sphere(ro: vec3<f32>, rd: vec3<f32>, c: vec4<f32>, px: f32, th: ptr<function, f32>) -> vec4<f32> {
    let d = rayPt(ro, rd, c.xyz, th);
    if c.w <= 0.0 || d > c.w + px {
        return vec4<f32>(0.0);
    }
    let cov = clamp((c.w - d) / max(px, 1.0e-3) + 0.5, 0.0, 1.0);
    let back = sqrt(max(c.w * c.w - d * d, 0.0));
    let n = normalize(ro + rd * ((*th) - back) - c.xyz);
    var col = qs_env(clamp(n.y * 0.9 + n.x * 0.3, -1.0, 1.0), c.y, uTime) * (0.55 + 0.45 * max(dot(n, -rd), 0.0));
    col += vec3<f32>(1.0) * pow(max(dot(reflect(rd, n), normalize(vec3<f32>(-0.3, 0.8, 0.5))), 0.0), 40.0) * 1.5;
    return vec4(col, cov);
}

fn base_vol_solid(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec4<f32> {
    var acc: vec4<f32> = vec4<f32>(0.0);
    if uFx < 0.01 || fxNear(ro, rd, uLength * 0.1, uLength) > 9.0 {
        return acc;
    }
    var best: f32 = 1.0e5;
    var th: f32;
    for (var k = 0; k < 12; k++) {
        let c = qs_fling3(f32(k));
        let dr = qs_sphere(ro, rd, c, px, &th);
        if dr.a > 0.0 && th < best {
            best = th;
            acc = dr;
        }
    }
    // a clash: a ring of droplets blown out
    let cl = clamp(uClash, 0.0, 1.0);
    if cl > 0.01 {
        let a = 1.0 - cl;
        for (var k = 0; k < 10; k++) {
            let fk = f32(k);
            let p = vec3(0.0, uLength * 0.55, 0.0) + around(0.8 + 6.0 * (1.0 - exp(-3.0 * a)), fk / 10.0, -2.0 * a * a);
            let dr = qs_sphere(ro, rd, vec4(p, 0.3 * (1.0 - 0.5 * a)), px, &th);
            if dr.a > 0.0 && th < best {
                best = th;
                acc = dr;
            }
        }
    }
    acc.a *= clamp(uIgn * 1.5, 0.0, 1.0);
    return acc;
}

fn base_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let y0 = L * 0.2;
    let y1 = L * 0.97;
    let silver: vec3<f32> = vec3<f32>(0.8, 0.88, 1.0);
    let forge: vec3<f32> = vec3<f32>(1.0, 0.55, 0.2);
    var col: vec3<f32> = vec3<f32>(0.0);
    col += fxSparks(ro, rd, px, y0, y1, 16.0 + 14.0 * sw, 6.0, 1.0, 3.7, forge);
    col += fxAura(ro, rd, y0, y1, 2.6, silver) * 0.6;
    col += fxShock(ro, rd, px, L * 0.55, 1.0 - cl, 9.0, silver) * 1.5;
    return col * uFx;
}

// round 10: the droplets circling the blade, in true 3D (only orbits are; the rest is flat)
fn base_orbit_solid(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec4<f32> {
    var acc: vec4<f32> = vec4<f32>(0.0);
    if uFx < 0.01 || fxNear(ro, rd, uLength * 0.1, uLength) > 9.0 {
        return acc;
    }
    var best: f32 = 1.0e5;
    var th: f32;
    for (var k = 0; k < 10; k++) {
        let dr = qs_sphere(ro, rd, qs_orbit3(f32(k)), px, &th);
        if dr.a > 0.0 && th < best {
            best = th;
            acc = dr;
        }
    }
    acc.a *= clamp(uIgn * 1.5, 0.0, 1.0);
    return acc;
}

// round 11: sig_vol gated by part 0
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    if part(0.0) < 0.5 {
        return vec3<f32>(0.0);
    }
    return base_vol(ro, rd, px);
}

// round 11: sig_vol_solid gated by part 1
fn sig_vol_solid(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec4<f32> {
    var acc: vec4<f32> = vec4<f32>(0.0);
    if part(3.0) > 0.5 && uFx > 0.01 {
        acc = qs_tendrils(ro, rd, px);
    }
    if part(1.0) < 0.5 {
        return acc;
    }
    let d = base_vol_solid(ro, rd, px);
    return vec4(mix(acc.rgb, d.rgb, d.a), max(acc.a, d.a));
}

// round 11: sig_orbit_solid gated by part 2
fn sig_orbit_solid(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec4<f32> {
    if part(2.0) < 0.5 {
        return vec4<f32>(0.0);
    }
    return base_orbit_solid(ro, rd, px);
}

// round 16 (Creyon: no fire; another effect): tendrils of liquid beskar reach out of the blade,
// curl and flow back into it, each a tapering mirror stroke catching a bright reflection that
// slides along it; drawn flat facing the camera with the mirror's shading, over the glow
fn qs_tendrils(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec4<f32> {
    var acc: vec4<f32> = vec4<f32>(0.0);
    let L = uLength;
    let t = uTime;
    var s: f32;
    if fxNear(ro, rd, L * 0.15, L) > 5.0 {
        return acc;
    }
    for (var j = 0; j < 4; j++) {
        let fj = f32(j);
        let cyc = t * 0.3 + h11(fj * 3.7);
        let k = floor(cyc);
        let q = fract(cyc);
        let reach = sin(3.1416 * q);
        let side = select(1.0, -1.0, glsl_mod(fj, 2.0) < 0.5);
        let y0 = L * (0.25 + 0.6 * h11(k * 2.1 + fj));
        var prev = vec3(side * 0.3, y0, 0.0);
        var best: f32 = 1.0e3;
        var bs: f32 = 0.0;
        for (var i = 1; i <= 10; i++) {
            let u = f32(i) / 10.0 * reach;
            let curl = u * u * 2.2 * (select(-1.0, 1.0, h11(k * 5.3 + fj) < 0.5));
            let p = vec3(side * (0.3 + 2.6 * u * cos(curl * 0.5)), y0 + 1.6 * u * sin(curl * 0.5 + 0.6) + 0.3 * sin(t * 2.0 + u * 6.0), 0.0);
            let d = raySeg(ro, rd, prev, p, &s);
            if d < best {
                best = d;
                bs = (f32(i) - 1.0 + s) / 10.0;
            }
            prev = p;
        }
        let w = mix(0.22, 0.05, bs) * (0.4 + 0.6 * reach);
        let cov = fillD(best - w, px) * step(0.02, reach);
        if cov <= 0.0 {
            continue;
        }
        let n = clamp(best / max(w, 1.0e-3), 0.0, 1.0);
        var c = qs_env(n * 0.9 - 0.2, y0 + bs * 4.0, t) * (0.7 + 0.3 * sqrt(max(1.0 - n * n, 0.0)));
        c += vec3<f32>(1.0) * exp(-pow((bs - fract(t * 0.8 + fj * 0.3)) / 0.08, 2.0)) * 0.8;
        acc = vec4(mix(acc.rgb, c, cov), max(acc.a, cov));
    }
    return acc;
}
