// Quicksilver: Creyon's Blade Lab design, reworked in full. A thin blade of liquid mirror: a chrome
// surface reflecting a cool sky and warm floor, ripples racing up it, beads of mercury rolling up to
// the tip and dripping off in falling droplets. A swing flings a spray of silver droplets off the
// blade that arc away and splash into smaller beads; a clash throws a ring of mercury splashing out
// with a bright ripple running both ways; ignition pours the metal up from the hilt.
fn qs_w(y: f32) -> f32 {
    let L = uLength;
    return 0.5 * smoothstep(-0.3, 0.5, y) * (1.0 - smoothstep(L - 0.9, L + 0.05, y)) + 0.05;
}

// fake chrome: what the curved mirror reflects at a slope n (-1..1 across) and height y
fn qs_env(n: f32, y: f32, t: f32) -> vec3<f32> {
    let h = n * 0.9 + 0.12 * sin(y * 0.35 - t * 1.3);
    let sky = mix(vec3<f32>(0.55, 0.65, 0.85), vec3<f32>(0.95, 0.97, 1.0), smoothstep(-0.1, 0.6, h));
    let floor_ = mix(vec3<f32>(0.12, 0.1, 0.12), vec3<f32>(0.4, 0.33, 0.3), smoothstep(-1.0, -0.3, h));
    var c = mix(floor_, sky, smoothstep(-0.25, 0.05, h));
    c += vec3<f32>(1.0) * exp(-pow((h - 0.45) / 0.06, 2.0)) * 1.2;
    // the horizon highlight
    return c;
}

// a mercury drop: sphere shading with a highlight, returns (rgb, coverage)
fn qs_drop(q: vec2<f32>, rad: f32, px: f32) -> vec4<f32> {
    let d = length(q);
    let cov = fillD(d - rad, px);
    if cov <= 0.0 {
        return vec4<f32>(0.0);
    }
    let n = q / max(rad, 1.0e-3);
    var c = qs_env(n.x, n.y * 3.0, 0.0) * (0.65 + 0.35 * sqrt(max(1.0 - dot(n, n), 0.0)));
    c += vec3<f32>(1.0) * exp(-dot(n - vec2<f32>(-0.35, 0.4), n - vec2<f32>(-0.35, 0.4)) * 18.0) * 1.3;
    return vec4(c, cov);
}

// flung droplet k (spray off the blade): position and radius, alive amount
fn qs_fling(fk: f32, t: f32) -> vec4<f32> {
    let L = uLength;
    let rate = 0.4 + 0.25 * h11(fk * 2.3);
    let ph = t * rate + h11(fk * 8.1);
    let cy = floor(ph);
    let f = fract(ph);
    let live = step(h11(cy * 2.9 + fk), 0.45 + 0.55 * uSwing + 0.5 * uClash);
    let s = select(1.0, -1.0, h11(cy * 4.1 + fk) < 0.5);
    let y0 = (0.15 + 0.8 * h11(cy * 1.7 + fk * 3.0)) * L;
    let v = vec2(s * (4.0 + 4.0 * h11(cy + fk * 5.0)), 2.5 * (h11(cy * 6.0 + fk) - 0.2));
    let p = vec2(s * 0.4, y0) + v * f - vec2(0.0, 3.5 * f * f);
    return vec4(p, (0.3 + 0.25 * h11(fk * 4.4)) * (1.0 - 0.4 * f), live * (1.0 - smoothstep(0.8, 1.0, f)));
}

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px_in: f32) -> vec3<f32> {
    var px = px_in;
    let L = uLength;
    px = min(px, 0.06);
    let on = smoothstep(-0.6, 0.3, b.y);
    let edge = 1.0 - smoothstep(6.0, 8.5, abs(b.x));
    let yc = clamp(b.y, 0.0, L - 0.2);
    let d = length(vec2(b.x, b.y - yc));
    // a cool silver sheen round the mirror, ripples brightening it as they pass
    let rip = 0.5 + 0.5 * sin(b.y * 1.6 - uTime * 9.0);
    var light = vec3<f32>(0.75, 0.82, 0.95) * halo(d, 0.9) * (0.35 + 0.25 * rip) * on + vec3<f32>(0.6, 0.7, 0.9) * halo(d, 2.0) * 0.08 * on;
    // glints on the flung droplets and dripping beads
    for (var k = 0; k < 10; k++) {
        let fl = qs_fling(f32(k), uTime);
        if fl.w <= 0.0 {
            continue;
        }
        light += vec3<f32>(0.85, 0.9, 1.0) * halo(length(b - fl.xy), fl.z * 1.8) * 0.25 * fl.w;
    }
    // clash: a bright ripple ring and a splash crown
    if uClash > 0.01 {
        let a = 1.0 - uClash;
        let o = vec2(0.0, L * 0.55);
        let ring = abs(length((b - o) * vec2<f32>(1.0, 0.6)) - 0.5 - 7.0 * a);
        light += vec3<f32>(0.9, 0.95, 1.0) * halo(ring, 0.12) * uClash * 1.3;
        light += vec3<f32>(0.9, 0.95, 1.0) * halo(abs(b.y - o.y) - 12.0 * a, 0.3) * fillD(abs(b.x) - 0.9, px) * uClash;
    }
    light *= edge * (1.0 - smoothstep(L + 2.0, L + 6.0, b.y)) * smoothstep(-3.0, -0.5, b.y);
    return (1.0 - exp(-light * 1.1)) * 1.05 * clamp(uIgn * 1.5, 0.0, 1.0);
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return vec3<f32>(0.0);
}

fn sig_solid(o: vec4<f32>, b: vec2<f32>, px_in: f32) -> vec4<f32> {
    var px = px_in;
    px = min(px, 0.06);
    let L = uLength;
    let ign = smoothstep(0.0, 1.5, uAge);
    let fillTo = mix(-0.5, L + 0.1, ign);
    // ignition: the metal pours up
    // ripples bulge the surface: the width wobbles where a ripple passes
    let rip = sin(b.y * 1.6 - uTime * 9.0) * 0.5 + 0.5;
    let w = qs_w(b.y) * (1.0 + 0.12 * rip);
    let cov = fillD(abs(b.x) - w, px) * step(-0.3, b.y) * fillD(b.y - min(L + 0.05, fillTo), px);
    var acc = o;
    if cov > 0.0 {
        let n = b.x / max(w, 0.01);
        let slope = n + 0.25 * cos(b.y * 1.6 - uTime * 9.0);
        // ripples tilt what it reflects
        var c = qs_env(slope, b.y, uTime);
        c *= 0.6 + 0.4 * sqrt(max(1.0 - n * n, 0.0));
        c += vec3<f32>(1.0) * exp(-pow((b.y - glsl_mod(uTime * 14.0, L + 10.0) + 4.0) / 0.6, 2.0)) * 0.5;
        // a sliding glint
        acc = vec4(mix(acc.rgb, c, cov), max(acc.a, cov));
    }
    // beads rolling up the blade, swelling at the tip and dripping off
    for (var k = 0; k < 5; k++) {
        let fk = f32(k);
        let per = 3.0 + fk * 0.7;
        let tt = glsl_mod(uTime + fk * 1.37, per) / per;
        let y = tt * (L + 1.0) - 0.5;
        let side = select(-1.0, 1.0, glsl_mod(fk, 2.0) < 0.5);
        let rad = 0.38 + 0.12 * h11(fk);
        var p = vec2(side * qs_w(y) * 0.9, y);
        // past the tip: it drips off and falls away in an arc
        let past = max(y - L, 0.0);
        p += vec2(side * past * 1.4, past * 0.3 - past * past * 0.9);
        var dr = qs_drop(b - p, rad * (1.0 + 0.4 * smoothstep(L - 3.0, L, y)), px);
        dr.a *= (1.0 - smoothstep(L + 0.5, L + 1.0, y)) * ign;
        acc = vec4(mix(acc.rgb, dr.rgb, dr.a), max(acc.a, dr.a));
    }
    // droplets flung off the blade
    for (var k = 0; k < 10; k++) {
        let fl = qs_fling(f32(k), uTime);
        if fl.w <= 0.0 {
            continue;
        }
        var dr = qs_drop(b - fl.xy, fl.z, px);
        acc = vec4(mix(acc.rgb, dr.rgb, dr.a * fl.w), max(acc.a, dr.a * fl.w));
    }
    // clash: a ring of mercury drops splashing out
    if uClash > 0.01 {
        let a = 1.0 - uClash;
        for (var k = 0; k < 10; k++) {
            let fk = f32(k);
            let an = fk * 0.628 + 0.3 * h11(fk);
            var p = vec2(0.0, L * 0.55) + vec2(cos(an), sin(an)) * (0.8 + 6.0 * (1.0 - exp(-3.0 * a))) - vec2(0.0, 2.0 * a * a);
            var dr = qs_drop(b - p, 0.3 * (1.0 - 0.5 * a), px);
            acc = vec4(mix(acc.rgb, dr.rgb, dr.a), max(acc.a, dr.a));
        }
    }
    acc.a *= clamp(uIgn * 1.5, 0.0, 1.0);
    return acc;
}

// GLSL's mod: x - y * floor(x / y) (WGSL's % truncates)
fn glsl_mod(x: f32, y: f32) -> f32 {
    return x - y * floor(x / y);
}
