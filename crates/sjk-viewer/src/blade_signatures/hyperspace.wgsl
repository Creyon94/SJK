// Hyperspace: the jump to lightspeed, as a blade. The blade is a blue-white shaft of light that
// shudders with the strain of the jump. Round it, at several distances, the stars are stretched
// into streaks rushing up past the blade toward the tip, the nearer ones faster, inside a blue
// tunnel of light that twists round the blade like the hyperspace corridor. Seen from above the
// streaks fly out of the tip like a starfield. Ignition is the jump itself: the stars sit as points,
// then stretch into lines. A swing punches the jump harder: the streaks grow long and bright and a
// flash races up. A clash drops out of hyperspace: a white reversion flash and a ring of light.
// how stretched the stars are: 0 points, 1 full streaks (the jump on ignition, a drop on a clash)
fn hy_stretch() -> f32 {
    let jump = smoothstep(0.05, 0.55, uAge);
    let drop = 1.0 - smoothstep(0.0, 0.5, uClash) * 0.85;
    return jump * drop * (1.0 + 1.2 * clamp(uSwing, 0.0, 1.0));
}

fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let blue: vec3<f32> = vec3<f32>(0.25, 0.5, 1.0);
    let ice: vec3<f32> = vec3<f32>(0.7, 0.86, 1.0);
    let white: vec3<f32> = vec3<f32>(1.0);
    let top = L * clamp(uAge / 0.45, 0.0, 1.0);
    // The blade is Sol's glow and core from the file, flickering (sig_glow, sig_core); here
    // only the effects, each a piece placed round it in 3D.
    var light: vec3<f32> = vec3<f32>(0.0);
    var ta: f32;
    let axd = rayPt(ro, rd, vec3(0.0, clamp(ro.y + rd.y * dot(-ro, rd), 0.0, L), 0.0), &ta);
    // nearest approach of the ray to the axis segment (for culling and depth)
    var sa: f32;
    let near = raySeg(ro, rd, vec3<f32>(0.0, 0.0, 0.0), vec3(0.0, L, 0.0), &sa);
    let fx = uFx;
    if near < 7.0 && fx > 0.0 {
        let S = hy_stretch();
        var fxl: vec3<f32> = vec3<f32>(0.0);
        // ---- the streaks: stars on cylinders round the blade, rushing up
        for (var i = 0; i < 36; i++) {
            let fi = f32(i);
            let layer = floor(fi / 12.0);
            // 0 inner, 1 middle, 2 outer
            let r = 1.3 + 1.4 * layer + 0.9 * h11(fi * 1.37);
            let nearF = 1.0 - layer * 0.3;
            let speed = (26.0 + 12.0 * h11(fi * 5.1)) * nearF;
            let span = L + 14.0;
            let ph = t * speed / span + h11(fi * 9.13);
            let cyc = floor(ph);
            let y = fract(ph) * span - 6.0;
            // the head
            let a = h11(fi * 3.71 + cyc * 1.618) + fi / 12.0;
            let rr = r + 0.6 * (h11(cyc * 2.3 + fi) - 0.5);
            let len = 0.15 + (2.5 + 5.0 * nearF) * S * (1.0 + 0.6 * sw);
            let hd = around(rr, a, y);
            let tl = around(rr, a, y - len);
            var s: f32;
            let d = raySeg(ro, rd, tl, hd, &s);
            if d > 0.8 {
                continue;
            }
            let ym = y - len * (1.0 - s);
            let on = smoothstep(-1.0, 3.0, ym) * (1.0 - smoothstep(top - 4.0, top + 2.0, ym));
            let w = max(0.035 + 0.025 * nearF, px * 0.8);
            let c = mix(blue, white, 0.35 + 0.65 * s);
            fxl += c * (halo(d, w) * 1.7 + halo(d, 0.22) * 0.25) * (0.3 + 0.7 * s) * on * (0.6 + 0.4 * nearF) * (1.0 + 0.8 * sw);
        }
        // ---- the tunnel: bands of blue light spiralling round the blade, rushing up
        for (var k = 0; k < 6; k++) {
            let fk = f32(k);
            let a0 = fk / 6.0 - t * 0.35;
            let y0 = glsl_mod(t * 14.0 + fk * (L + 10.0) / 6.0, L + 10.0) - 5.0;
            var prev = around(3.3, a0, y0);
            for (var j = 1; j <= 6; j++) {
                let u = f32(j) / 6.0;
                let q = around(3.3 + 0.3 * sin(u * 6.0 + fk), a0 + u * 0.35, y0 + u * 6.0);
                var s: f32;
                let d = raySeg(ro, rd, prev, q, &s);
                let on = smoothstep(-0.5, 3.0, q.y) * (1.0 - smoothstep(top - 5.0, top + 1.5, q.y));
                fxl += vec3<f32>(0.16, 0.38, 1.0) * (halo(d, 0.18) * 0.8 + halo(d, 0.7) * 0.25) * sin(3.1416 * (u - 0.08)) * on * min(S, 1.0);
                prev = q;
            }
        }
        // ---- a swing's flash racing up the blade
        let yf = fract(t * 1.3) * (L + 8.0) - 4.0;
        let sy = ro.y + rd.y * ta;
        fxl += ice * halo(abs(sy - yf), 2.0) * halo(axd, 1.6) * sw * 1.2;
        // ---- a clash: the reversion flash and a ring of light expanding round the blade
        if cl > 0.01 {
            let o = vec3(0.0, L * 0.55, 0.0);
            var to: f32;
            let dc = rayPt(ro, rd, o, &to);
            let R = 0.8 + 5.0 * (1.0 - cl);
            let shellL = halo(R - dc, 0.25 + 0.4 * (1.0 - cl)) * smoothstep(R + 0.3, R - 0.2, dc);
            fxl += white * shellL * cl * 1.1 + ice * halo(dc, 3.0) * pow(cl, 3.0) * 1.4;
            let h = rayAt(ro, rd, o.y);
            if h.z > 0.0 {
                fxl += white * halo(abs(length(h.xy) - R * 1.1), 0.15 + 0.3 * (1.0 - cl)) * cl * 1.4;
            }
        }
        light += fxl * fx;
    }
    return light;
}

// the blade: Sol's glow and core from the file, flickering as it shudders, flashing on a swing
// and a clash
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let t = uTime;
    let fl = 0.9 + 0.1 * sin(t * 37.0) + 0.06 * sin(t * 71.0 + b.y * 0.3);
    return g * fl * (1.0 + 0.4 * clamp(uSwing, 0.0, 1.0) + 0.8 * clamp(uClash, 0.0, 1.0));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c * (0.95 + 0.05 * sin(uTime * 61.0));
}

// GLSL's mod: x - y * floor(x / y) (WGSL's % truncates)
fn glsl_mod(x: f32, y: f32) -> f32 {
    return x - y * floor(x / y);
}
