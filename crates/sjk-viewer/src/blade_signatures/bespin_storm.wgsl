            let d = raySeg(ro, rd, vec3(x, y, z), vec3(x + 1.8 + 1.2 * sw, y - 0.3, z + 0.3), &s);
            fx += vec3<f32>(1.0, 0.95, 0.9) * (halo(d, max(0.03, px)) * 0.6 + halo(d, 0.2) * 0.1) * sin(3.1416 * f) * part(1.0);
