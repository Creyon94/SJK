            let f = fract(t * 0.5 * (0.7 + 0.6 * h11(fi * 2.3)) + h11(fi * 5.9));
            let y = mix(y0, y1, h11(fi * 1.7 + floor(t * 0.5 + h11(fi * 5.9))));
