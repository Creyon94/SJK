    fx += fxSmoke(ro, rd, y0 + 4.0, y1, 3.0, 0.8, 7.5, gold) * 0.35 * part(0.0);
    var s: f32;
    if fxNear(ro, rd, y0, y1) < 7.0 {
        for (var i = 0; i < 16; i++) {
