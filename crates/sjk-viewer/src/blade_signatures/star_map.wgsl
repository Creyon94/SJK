// Star Map: an old Jedi star chart as a blade. Seven stars light up beside it one after another and
// lines of light link them into a figure; the chart holds, fades and a new one forms, each time a
// different figure (round 15, Creyon: a hyperspace route, a ring round the blade, a triangle, a
// spiral arm, a diamond, a crown and a lightning route, in a shuffled turn). A glint sits on the tip.
// A clash flares it.
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    return g;
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c;
}

// the effects, flat round the blade as Sol's are
// round 15 (Creyon: "let it pick other symbols"): star i (0 to 6) of figure `shape` (0 to 6), x
// across the blade in units, y along it from -1 to 1 of the chart's height; `side` mirrors it
fn sm_star(shape: f32, fi: f32, k: f32, side: f32) -> vec2<f32> {
    let a = fi / 7.0;
    var p: vec2<f32>;
    if shape < 0.5 {
        // a hyperspace route zigzagging up beside the blade
        p = vec2(1.0 + 1.8 * h11(fi * 3.1 + k * 7.7), -0.9 + 1.8 * (fi + h11(fi * 1.3 + k)) / 7.0);
        p.x *= select(1.0, -1.0, h11(fi * 5.7 + k * 2.3) < 0.5);
        return p;
    }
    if shape < 1.5 {
        return vec2(2.3 * sin(6.2832 * a), 0.8 * cos(6.2832 * a));
    }
    // a ring round it
    if shape < 2.5 {
        // a triangle
        let e = a * 3.0;
        let f = fract(e);
        let v0: vec2<f32> = vec2<f32>(-2.2, -0.75);
        let v1: vec2<f32> = vec2<f32>(2.2, -0.75);
        let v2: vec2<f32> = vec2<f32>(0.0, 0.9);
        let pa = select((select(v2, v1, e < 2.0)), v0, e < 1.0);
        let pb = select((select(v0, v2, e < 2.0)), v1, e < 1.0);
        return mix(pa, pb, f) * vec2(side, 1.0);
    }
    if shape < 3.5 {
        // a spiral arm
        let r = 0.5 + 0.36 * fi;
        return vec2(side * r * cos(fi * 1.05), 0.36 * r * sin(fi * 1.05) * 1.6);
    }
    if shape < 4.5 {
        // a diamond
        let e = a * 4.0;
        let f = fract(e);
        let v0: vec2<f32> = vec2<f32>(0.0, -0.95);
        let v1: vec2<f32> = vec2<f32>(2.0, 0.0);
        let v2: vec2<f32> = vec2<f32>(0.0, 0.95);
        let v3: vec2<f32> = vec2<f32>(-2.0, 0.0);
        let pa = select((select((select(v3, v2, e < 3.0)), v1, e < 2.0)), v0, e < 1.0);
        let pb = select((select((select(v0, v3, e < 3.0)), v2, e < 2.0)), v1, e < 1.0);
        return mix(pa, pb, f);
    }
    if shape < 5.5 {
        // a crown
        let up = select(0.55, -0.2, glsl_mod(fi, 2.0) < 0.5);
        return vec2(-2.4 + 0.8 * fi, select(up, -0.75, (fi == 0.0 || fi == 6.0)));
    }
    // a lightning route: hard zigzags climbing the blade's one side
    return vec2(side * (select(2.6, 0.9, glsl_mod(fi, 2.0) < 0.5)), -0.95 + 0.3 * fi);
}

// whether a figure closes on its first star (the ring, the triangle and the diamond)
fn sm_closed(shape: f32) -> f32 {
    return select(0.0, 1.0, (shape > 0.5 && shape < 2.5) || (shape > 3.5 && shape < 4.5));
}

fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let y0 = L * 0.2;
    let y1 = L * 0.97;
    var fx: vec3<f32> = vec3<f32>(0.0);
    let c: vec3<f32> = vec3<f32>(0.7, 0.8, 1.0);
    var ta: f32;
    var s: f32;
    let cyc = t * 0.12;
    let k = floor(cyc);
    let q = fract(cyc);
    // a different figure each time, all seven in turn in a shuffled order (0, 3, 6, 2, 5, 1, 4)
    let shape = glsl_mod(k * 3.0, 7.0);
    let side = select(1.0, -1.0, h11(k * 9.1) < 0.5);
    let yc = mix(y0, y1, 0.5) + (h11(k * 4.3) - 0.5) * (y1 - y0) * 0.15;
    let hy = (y1 - y0) * 0.4;
    var prev: vec3<f32> = vec3<f32>(0.0);
    var first: vec3<f32> = vec3<f32>(0.0);
    if fxNear(ro, rd, y0, y1) < 4.5 {
        for (var i = 0; i < 7; i++) {
            let fi = f32(i);
            let f2 = sm_star(shape, fi, k, side);
            let p = vec3(f2.x, yc + f2.y * hy, 0.0);
            let on = smoothstep(fi / 9.0, fi / 9.0 + 0.05, q) * (1.0 - smoothstep(0.85, 1.0, q));
            let d = rayPt(ro, rd, p, &ta);
            let tw = 0.75 + 0.25 * sin(t * 3.0 + fi * 2.0);
            fx += (vec3<f32>(1.0) * halo(d, max(0.06, px)) * 1.6 + c * halo(d, 0.4) * 0.4) * on * tw;
            if i > 0 {
                let dl = raySeg(ro, rd, prev, p, &s);
                let grow = smoothstep(fi / 9.0, fi / 9.0 + 0.08, q);
                fx += c * halo(dl, max(0.025, px)) * 0.6 * on * step(s, grow);
            } else {
                first = p;
            }
            prev = p;
        }
        // a closed figure: the last line back to its first star
        let dl = raySeg(ro, rd, prev, first, &s);
        let grow = smoothstep(7.0 / 9.0, 7.0 / 9.0 + 0.06, q);
        fx += c * halo(dl, max(0.025, px)) * 0.6 * step(s, grow) * (1.0 - smoothstep(0.85, 1.0, q)) * sm_closed(shape);
    }
    // round 14 (Creyon): a chroma for the blade only; its effects keep their own colours
    uKeep += fx * uFx * part(0.0);
    return vec3<f32>(0.0);
}
