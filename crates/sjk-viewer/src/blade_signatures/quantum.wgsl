// Quantum: Creyon's Blade Lab design, reworked in full. A blade in superposition: ghost copies of it
// stand at other angles, quantum foam (particle pairs) pops in and out round it, electrons tunnel
// round two tilted orbits. A swing collapses the copies into one; a clash is a wave-function
// collapse: the copies snap in with a bright flash and a burst of particles.
// drawn in game: LAB_THIN 1.0
fn o_sstep(a: f32, b: f32, x: f32) -> f32 {
    let t = clamp((x - a) / (b - a), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

fn o_hash(n: f32) -> f32 {
    return fract(sin(n) * 43758.5453);
}

fn o_hash2(p: vec2<f32>) -> f32 {
    return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);
}

fn o_noise(p: vec2<f32>) -> f32 {
    let i = floor(p);
    var f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(o_hash2(i), o_hash2(i + vec2<f32>(1.0, 0.0)), f.x), mix(o_hash2(i + vec2<f32>(0.0, 1.0)), o_hash2(i + vec2<f32>(1.0)), f.x), f.y);
}

fn o_fbm(p_in: vec2<f32>) -> f32 {
    var p = p_in;
    var s: f32 = 0.0;
    var a: f32 = 0.5;
    for (var i = 0; i < 4; i++) {
        s += a * o_noise(p);
        p *= 2.03;
        a *= 0.5;
    }
    return s;
}

fn o_hsv(h: f32, s: f32, v: f32) -> vec3<f32> {
    let k = clamp(abs(glsl_mod_vec3_float(h * 6.0 + vec3<f32>(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0, vec3(0.0), vec3(1.0));
    return v * mix(vec3<f32>(1.0), k, s);
}

fn o_seg(x: f32, y: f32, L: f32) -> f32 {
    return length(vec2(max(0.0, max(-x, x - L)), y));
}

fn o_saber(g: vec3<f32>, c: vec3<f32>, d: f32, cr: f32, k: f32) -> vec3<f32> {
    let core = o_sstep(cr, cr * 0.35, d);
    let glow_ = exp(-d * k) * 0.55 + exp(-d * k * 0.3) * 0.16;
    return c * core + g * glow_ * (1.0 - core * 0.6);
}

fn q_blade(x: f32, y: f32, L: f32, t: f32, k: f32) -> vec3<f32> {
    let jit = (o_hash(floor(t * 12.0) + k) - 0.5) * 0.004 * (1.0 - uSwing);
    let yy = y - jit;
    let dd = o_seg(x, yy, L);
    let h = 0.5 + 0.5 * sin(x * 14.0 - t * 3.0);
    let g = mix(vec3<f32>(0.25, 0.85, 1.0), vec3<f32>(0.7, 0.35, 1.0), h);
    let wave = 0.75 + 0.25 * cos(x * 38.0 - sin(t * 0.7) * 3.0) * cos(t * 2.3);
    var c = o_saber(g, vec3<f32>(0.92, 0.97, 1.0), dd, 0.015, 22.0) * wave;
    c *= 0.82 + 0.18 * cos(yy * 480.0 - t * 6.0 + x * 20.0);
    var blips: f32 = 0.0;
    for (var i = 0; i < 4; i++) {
        let fi = f32(i);
        let cy = floor(t * 3.0 + o_hash(fi * 3.7));
        let at = vec2(o_hash(cy * 1.31 + fi * 7.1) * L, (o_hash(cy * 2.7 + fi) - 0.5) * 0.02);
        blips += exp(-length(vec2(x, y) - at) / 0.004) * step(0.4, o_hash(cy + fi * 11.0));
    }
    return c + g * blips * 1.2;
}

fn o_fx(x: f32, y: f32, L: f32, d: f32, t: f32) -> vec3<f32> {
    return q_blade(x, y, L, t, 0.0);
}

// the quantum show round the blade (SJK units)
fn qm_show(b: vec2<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let cA: vec3<f32> = vec3<f32>(0.25, 0.85, 1.0);
    let cB: vec3<f32> = vec3<f32>(0.7, 0.35, 1.0);
    var light: vec3<f32> = vec3<f32>(0.0);
    // quantum foam: particle pairs appear together, fly apart, swing back and annihilate in a flash
    for (var i = 0; i < 12; i++) {
        let fi = f32(i);
        let ph = t * (0.55 + 0.35 * h11(fi * 2.3)) + h11(fi * 6.1);
        let cy = floor(ph);
        let f = fract(ph);
        var c = vec2((h11(cy * 3.1 + fi) - 0.5) * 7.0, (0.06 + 0.9 * h11(cy * 1.9 + fi * 4.0)) * L);
        c.x += sign(c.x) * 1.0;
        c *= vec2(1.0 + 0.8 * sw, 1.0);
        let an = 6.2832 * h11(cy * 5.3 + fi);
        let dir = vec2(cos(an), sin(an));
        let sep = sin(f * 3.14159) * (0.9 + 0.8 * h11(fi * 9.0));
        let p1 = c + dir * sep;
        let p2 = c - dir * sep;
        let life = smoothstep(0.0, 0.08, f) * (1.0 - smoothstep(0.85, 1.0, f));
        light += cA * halo(length(b - p1), 0.09) * life * 1.6 + cB * halo(length(b - p2), 0.09) * life * 1.6;
        light += mix(cA, cB, 0.5) * halo(sdSeg(b, p1, p2), 0.025) * life * 0.35;
        let ann = exp(-pow((f - 0.94) / 0.035, 2.0));
        // the annihilation flash
        light += vec3<f32>(0.9, 0.95, 1.0) * (halo(length(b - c), 0.18) * 1.8 + halo(length(b - c), 0.8) * 0.3) * ann;
    }
    // two tilted orbits round the blade, electrons tunnelling (jumping) between places on them
    for (var k = 0; k < 2; k++) {
        let fk = f32(k);
        let oy = L * (0.35 + 0.35 * fk) + 3.0 * sin(t * 0.4 + fk * 2.0);
        let tilt = 0.5 + 0.3 * sin(t * 0.3 + fk);
        var q = b - vec2(0.0, oy);
        q = vec2(q.x, q.y * cos(tilt) - q.x * sin(tilt) * 0.6);
        let ra = 3.6 + 0.6 * fk;
        let rb: f32 = 1.0;
        let e = length(q / vec2(ra, rb));
        let dd = abs(e - 1.0) * rb;
        light += mix(cA, cB, fk) * (exp(-pow(dd / 0.035, 2.0)) * 0.35 + halo(dd, 0.15) * 0.08) * (1.0 - 0.6 * sw);
        for (var j = 0; j < 2; j++) {
            let jump = floor(t * 2.2 + f32(j) * 0.5 + fk * 0.3);
            // tunnelling: no path between
            let a = 6.2832 * h11(jump * 1.7 + f32(j) * 3.0 + fk) + t * 1.5;
            let ep = vec2(ra * cos(a), rb * sin(a));
            let w = vec2(ep.x, (ep.y + ep.x * sin(tilt) * 0.6) / cos(tilt));
            let pop = 1.0 - fract(t * 2.2 + f32(j) * 0.5 + fk * 0.3);
            light += vec3<f32>(0.95, 0.98, 1.0) * halo(length(b - vec2(0.0, oy) - w), 0.11) * (1.2 + 1.5 * pow(pop, 6.0));
        }
    }
    // clash: the collapse, a flash and a burst of probability out of the strike point
    if cl > 0.01 {
        let a = 1.0 - cl;
        let o = vec2(0.0, L * 0.6);
        light += vec3<f32>(0.9, 0.95, 1.0) * halo(length(b - o), 1.5) * pow(cl, 3.0) * 1.6;
        for (var k = 0; k < 14; k++) {
            let fk = f32(k);
            let an = fk * 0.449 + 0.3 * h11(fk);
            let p = o + vec2(cos(an), sin(an)) * (0.5 + 8.0 * (1.0 - exp(-3.0 * a)));
            light += mix(cA, cB, h11(fk * 3.0)) * halo(length(b - p), 0.12) * cl * 1.8;
        }
    }
    let edge = 1.0 - smoothstep(7.0, 9.5, abs(b.x));
    light *= edge * smoothstep(-0.5, 1.0, b.y) * (1.0 - smoothstep(L + 0.5, L + 4.0, b.y));
    return (1.0 - exp(-light * 1.2)) * 1.05;
}

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let S: f32 = 1.08 / 40.0;
    let x = b.y * S;
    let y = b.x * S;
    let L = uLength * S;
    let d = o_seg(x, y, L);
    let c = o_fx(x, y, L, d, uTime);
    let R: f32 = 0.1;
    let e = 1.0 - o_sstep(R * 0.45, R * 0.98, max(d, abs(y)));
    var light = max(c, vec3<f32>(0.0)) * e;
    let held = mix(0.45, 1.0, 1.0 - clamp(uSwing * 2.0, 0.0, 1.0));
    for (var k = 0; k < 2; k++) {
        let fk = f32(k);
        let side = select(-1.0, 1.0, k == 0);
        let a = (0.1 + 0.04 * sin(uTime * 1.3 + fk)) * held * side * (0.6 + 0.4 * cos(uTime * 0.7 + fk * 2.4));
        let cs = cos(a);
        let sn = sin(a);
        let gx = x * cs - y * sn;
        let gy = x * sn + y * cs;
        let gd = o_seg(gx, gy, L);
        let ge = 1.0 - o_sstep(0.025, 0.06, max(gd, abs(gy)));
        light += max(q_blade(gx, gy, L, uTime, fk + 1.0), vec3<f32>(0.0)) * 0.42 * held * (0.85 + 0.15 * sin(uTime * 9.0 + fk * 3.0)) * ge;
    }
    light += qm_show(b, min(px, 0.06));
    return light * clamp(uIgn * 1.5, 0.0, 1.0);
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return vec3<f32>(0.0);
}

// GLSL's mod: x - y * floor(x / y) (WGSL's % truncates)
fn glsl_mod_vec3_float(x: vec3<f32>, y: f32) -> vec3<f32> {
    return x - y * floor(x / y);
}
