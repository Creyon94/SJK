// Fractal: a thin iridescent blade that keeps growing fractals. Glowing fractal trees branch off it
// (each limb splitting in two again and again), grow out, shimmer through the rainbow and dissolve;
// Koch-snowflake outlines spin round it, shrinking down into the blade as if zooming forever.
// A swing grows a burst of branches; a clash fires a ring of snowflakes outward.
fn fr_rot(a: f32) -> mat2x2<f32> {
    let c = cos(a);
    let s = sin(a);
    return mat2x2<f32>(c, -s, s, c);
}

// a fractal tree folded from one trunk: distance to its limbs (q in tree units, trunk along +y)
fn fr_tree(q_in: vec2<f32>, spread: f32, depthF: f32) -> f32 {
    var q = q_in;
    var d = sdSeg(q, vec2<f32>(0.0), vec2<f32>(0.0, 1.0));
    var sc: f32 = 1.0;
    for (var i = 0; i < 6; i++) {
        if f32(i) > depthF {
            break;
        }
        q.y -= 1.0;
        q.x = abs(q.x);
        q = fr_rot(spread) * q;
        q *= 1.45;
        sc *= 1.45;
        d = min(d, sdSeg(q, vec2<f32>(0.0), vec2<f32>(0.0, 1.0)) / sc);
    }
    return d;
}

// distance to a fractal snowflake outline of radius rad: a six-point star with smaller stars on its points
fn fr_star(p: vec2<f32>, rad: f32) -> f32 {
    let a = atan2(p.y, p.x);
    let r = length(p);
    let edge = rad * (0.72 + 0.28 * pow(abs(cos(a * 3.0)), 3.0));
    return abs(r - edge);
}

fn fr_koch(p: vec2<f32>, rad: f32) -> f32 {
    var d = fr_star(p, rad);
    let a = atan2(p.y, p.x);
    let sector = floor(a / 1.0472 + 0.5) * 1.0472;
    let tip = vec2(cos(sector), sin(sector)) * rad * 0.95;
    d = min(d, fr_star(fr_rot(0.5236) * (p - tip), rad * 0.32));
    return d;
}

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px_in: f32) -> vec3<f32> {
    var px = px_in;
    let L = uLength;
    px = min(px, 0.06);
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let on = smoothstep(-0.5, 0.3, b.y);
    let yc = clamp(b.y, 0.0, L - 0.35);
    let d = length(vec2(b.x, b.y - yc));
    // the blade: white core, iridescent rainbow sheath shifting along it
    let iri = hsv(fract(b.y * 0.04 - uTime * 0.15), 0.6, 1.0);
    var light = vec3<f32>(1.0, 0.97, 1.0) * exp(-pow(d / 0.3, 2.0)) * 1.5 * on + iri * halo(d, 0.8) * 0.6 * on + iri * halo(d, 2.0) * 0.08 * on;
    // fractal trees growing off the blade, both sides, growing then dissolving
    for (var i = 0; i < 5; i++) {
        let fi = f32(i);
        let ph = uTime * (0.22 + 0.06 * h11(fi * 3.3)) + h11(fi * 8.1);
        let cy = floor(ph);
        let f = fract(ph);
        let s = select(1.0, -1.0, h11(cy * 2.7 + fi) < 0.5);
        let root = vec2(s * 0.35, (0.1 + 0.75 * h11(cy * 1.9 + fi * 3.0)) * L);
        let size = 1.3 + 0.7 * h11(cy + fi * 5.0);
        let dir = normalize(vec2(s, 0.55));
        let perp = vec2(-dir.y, dir.x);
        let rel = b - root;
        let q = vec2(dot(rel, perp), dot(rel, dir)) / size;
        let grow = smoothstep(0.0, 0.5, f) * 6.0;
        let td = fr_tree(q, 0.42 + 0.1 * sin(uTime + fi), grow) * size;
        let fade = (1.0 - smoothstep(0.65, 1.0, f));
        let tc = hsv(fract(h11(cy + fi) + length(q) * 0.2 - uTime * 0.2), 0.7, 1.0);
        light += tc * (exp(-pow(td / 0.035, 2.0)) * 1.4 + halo(td, 0.2) * 0.18) * fade;
    }
    // snowflake outlines spinning round the blade, shrinking down into it (an endless zoom)
    for (var i = 0; i < 4; i++) {
        let fi = f32(i);
        let f = fract(uTime * 0.18 + fi / 4.0);
        let rad = 4.5 * (1.0 - f) + 0.3;
        let c = vec2(0.0, (0.2 + 0.2 * fi) * L);
        let q = fr_rot(uTime * 0.5 * (select(-1.0, 1.0, glsl_mod(fi, 2.0) < 0.5)) + fi) * (b - c);
        let kd = fr_koch(q, rad);
        let kc = hsv(fract(fi * 0.25 + uTime * 0.1), 0.55, 1.0);
        light += kc * (exp(-pow(kd / 0.04, 2.0)) * 1.1 + halo(kd, 0.2) * 0.12) * smoothstep(0.0, 0.15, f) * (1.0 - smoothstep(0.85, 1.0, f));
    }
    // clash: a ring of snowflakes bursting out
    if cl > 0.01 {
        let a = 1.0 - cl;
        let o = vec2(0.0, L * 0.6);
        for (var i = 0; i < 8; i++) {
            let fi = f32(i);
            let an = fi * 0.785;
            let p = o + vec2(cos(an), sin(an)) * (1.0 + 6.5 * (1.0 - exp(-3.0 * a)));
            let kd = fr_koch(fr_rot(uTime * 3.0) * (b - p), 0.6);
            light += hsv(fi * 0.125, 0.6, 1.0) * (exp(-pow(kd / 0.04, 2.0)) * 1.5) * cl;
        }
        light += vec3<f32>(1.0) * halo(length(b - o), 1.5) * pow(cl, 3.0);
    }
    let edge = 1.0 - smoothstep(8.5, 10.2, abs(b.x));
    light *= edge * (1.0 - smoothstep(L + 0.5, L + 3.5, b.y)) * smoothstep(-3.0, -0.5, b.y);
    return (1.0 - exp(-light * 1.15)) * 1.05;
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return vec3<f32>(0.0);
}

// GLSL's mod: x - y * floor(x / y) (WGSL's % truncates)
fn glsl_mod(x: f32, y: f32) -> f32 {
    return x - y * floor(x / y);
}
