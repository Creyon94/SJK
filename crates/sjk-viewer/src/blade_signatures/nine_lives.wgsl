// @room 8
// @palette {"corona.rim_cool":[0.55,0.40,0.95],"corona.rim_hot":[0.95,0.70,1.0],"corona.inner":[1.0,0.95,1.0],"core.white":[1.0,0.98,1.0],"core.fringe_cool":[0.75,0.60,1.0],"core.fringe_hot":[1.0,0.85,1.0],"light.color":[0.80,0.65,1.0],"trail":[0.78,0.62,1.0]}

// Nine Lives: a thin moonlit lavender blade with a gang of glowing cats round it, drawn as bright
// neon-line figures in different poses: one sitting with its tail curled, walkers prowling, a
// leaper mid-pounce, a sleepy curled-up cat drifting by. They circle the blade in front and behind,
// paw prints walk up its edge, and pairs of cat eyes blink open in the dark around it.
// A swing makes the cats pounce outward; a clash bursts out nine cat-spirit heads (nine lives);
// ignition: a cat strolls up the blade leaving prints.
// a triangle (for ears): distance to the triangle a b c
fn ct_tri(p: vec2<f32>, a: vec2<f32>, b: vec2<f32>, c: vec2<f32>) -> f32 {
    let e0 = b - a;
    let e1 = c - b;
    let e2 = a - c;
    let v0 = p - a;
    let v1 = p - b;
    let v2 = p - c;
    let pq0 = v0 - e0 * clamp(dot(v0, e0) / dot(e0, e0), 0.0, 1.0);
    let pq1 = v1 - e1 * clamp(dot(v1, e1) / dot(e1, e1), 0.0, 1.0);
    let pq2 = v2 - e2 * clamp(dot(v2, e2) / dot(e2, e2), 0.0, 1.0);
    let s = sign(e0.x * e2.y - e0.y * e2.x);
    let d = min(min(vec2(dot(pq0, pq0), s * (v0.x * e0.y - v0.y * e0.x)), vec2(dot(pq1, pq1), s * (v1.x * e1.y - v1.y * e1.x))), vec2(dot(pq2, pq2), s * (v2.x * e2.y - v2.y * e2.x)));
    return -sqrt(d.x) * sign(d.y);
}

fn ct_smin(a: f32, b: f32, k: f32) -> f32 {
    let h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
    return mix(b, a, h) - k * h * (1.0 - h);
}

// a cat's head at c (radius r) with two ears, facing +x
fn ct_head(q: vec2<f32>, c: vec2<f32>, r: f32) -> f32 {
    var d = length(q - c) - r;
    d = min(d, ct_tri(q, c + vec2<f32>(-0.55, 0.55) * r, c + vec2<f32>(-0.05, 0.75) * r, c + vec2<f32>(-0.6, 1.45) * r));
    d = min(d, ct_tri(q, c + vec2<f32>(0.15, 0.78) * r, c + vec2<f32>(0.7, 0.5) * r, c + vec2<f32>(0.55, 1.4) * r));
    return d;
}

// the cat figures in their own frame (+x forward, +y up), about 2.4 long; kind 0 sit, 1 walk,
// 2 leap, 3 curled asleep. Returns a signed distance.
fn ct_cat(q: vec2<f32>, kind: f32, t: f32) -> f32 {
    var d: f32;
    if kind < 0.5 {
        // sitting, tail curled round
        let body = sdEll(q - vec2<f32>(-0.05, 0.62), vec2<f32>(0.5, 0.72));
        let chest = sdEll(q - vec2<f32>(0.22, 0.95), vec2<f32>(0.28, 0.42));
        d = ct_smin(body, chest, 0.15);
        d = ct_smin(d, ct_head(q, vec2<f32>(0.28, 1.55), 0.36), 0.08);
        let sw = 0.15 * sin(t * 2.0);
        d = min(d, sdSeg(q, vec2<f32>(-0.45, 0.08), vec2(-0.85, 0.25 + sw)) - 0.08);
        d = min(d, sdSeg(q, vec2(-0.85, 0.25 + sw), vec2(-0.75, 0.75 + sw * 1.5)) - 0.075);
        d = min(d, sdSeg(q, vec2<f32>(0.25, 0.0), vec2<f32>(0.3, 0.6)) - 0.09);
    } else if kind < 1.5 {
        // walking, legs stepping
        let body = sdEll(q - vec2<f32>(0.0, 0.78), vec2<f32>(0.95, 0.33));
        d = ct_smin(body, ct_head(q, vec2<f32>(1.02, 1.1), 0.32), 0.12);
        let s = sin(t * 7.0);
        d = min(d, sdSeg(q, vec2<f32>(0.62, 0.62), vec2(0.62 + 0.22 * s, 0.0)) - 0.08);
        d = min(d, sdSeg(q, vec2<f32>(0.48, 0.62), vec2(0.48 - 0.22 * s, 0.0)) - 0.08);
        d = min(d, sdSeg(q, vec2<f32>(-0.6, 0.62), vec2(-0.6 - 0.22 * s, 0.0)) - 0.09);
        d = min(d, sdSeg(q, vec2<f32>(-0.74, 0.62), vec2(-0.74 + 0.22 * s, 0.0)) - 0.09);
        let tw = 0.2 * sin(t * 3.0);
        d = min(d, sdSeg(q, vec2<f32>(-0.9, 0.85), vec2(-1.3, 1.25 + tw)) - 0.07);
        d = min(d, sdSeg(q, vec2(-1.3, 1.25 + tw), vec2(-1.25, 1.7 + tw)) - 0.065);
    } else if kind < 2.5 {
        // leaping: stretched out, paws reaching
        let r = vec2(q.x * 0.97 + q.y * 0.26, -q.x * 0.26 + q.y * 0.97);
        let body = sdEll(r - vec2<f32>(0.0, 0.7), vec2<f32>(1.05, 0.28));
        d = ct_smin(body, ct_head(r, vec2<f32>(1.15, 0.95), 0.3), 0.1);
        d = min(d, sdSeg(r, vec2<f32>(0.7, 0.6), vec2<f32>(1.45, 0.45)) - 0.075);
        // front paws forward
        d = min(d, sdSeg(r, vec2<f32>(0.6, 0.55), vec2<f32>(1.3, 0.3)) - 0.07);
        d = min(d, sdSeg(r, vec2<f32>(-0.7, 0.6), vec2<f32>(-1.45, 0.35)) - 0.085);
        // back legs pushing
        d = min(d, sdSeg(r, vec2<f32>(-0.6, 0.55), vec2<f32>(-1.3, 0.15)) - 0.08);
        d = min(d, sdSeg(r, vec2<f32>(-0.95, 0.8), vec2<f32>(-1.7, 1.1)) - 0.065);
    } else {
        // curled asleep, tail wrapped round
        let breathe = 1.0 + 0.04 * sin(t * 1.5);
        let body = sdEll(q - vec2<f32>(-0.1, 0.45), vec2(0.9, 0.45 * breathe));
        // the head tucked in at the front, ears up, resting on its paws
        let head = ct_head(q, vec2<f32>(0.62, 0.55), 0.34);
        d = ct_smin(body, head, 0.08);
        d = min(d, sdEll(q - vec2<f32>(0.75, 0.12), vec2<f32>(0.35, 0.1)));
        // front paws
        // the tail wrapped round the front, its tip curling up
        d = min(d, sdSeg(q, vec2<f32>(-0.95, 0.25), vec2<f32>(-0.6, 0.02)) - 0.09);
        d = min(d, sdSeg(q, vec2<f32>(-0.6, 0.02), vec2<f32>(0.35, -0.02)) - 0.085);
        d = min(d, sdSeg(q, vec2<f32>(0.35, -0.02), vec2<f32>(0.6, 0.12)) - 0.08);
    }
    return d;
}

// cat i: its place (xy), depth (z), heading sign (s), pose kind, size
fn ct_place(fi: f32, kind: ptr<function, f32>, size: ptr<function, f32>, hs: ptr<function, f32>) -> vec4<f32> {
    let L = uLength;
    (*kind) = glsl_mod(fi, 4.0);
    (*size) = mix(1.6, 2.1, h11(fi * 3.3));
    var R = 4.2 + 1.4 * h11(fi * 5.1);
    let sp = (0.28 + 0.12 * h11(fi * 2.7)) * (select(1.0, 0.5, (*kind) > 2.5));
    let a = uTime * sp + fi * 1.37;
    let y = L * (0.15 + 0.75 * fract(fi * 0.618 + 0.21)) + 1.5 * sin(uTime * 0.4 + fi);
    // swing: they pounce outward
    let pounce = smoothstep(0.0, 1.0, uSwing);
    R += 2.0 * pounce;
    // ignition: they spring out from the blade
    R *= smoothstep(0.0, 1.6, uAge - 0.12 * fi) * 0.85 + 0.15;
    let p = vec2(R * sin(a), y + 0.6 * sin(a) * 0.0);
    (*hs) = select(-1.0, 1.0, cos(a) >= 0.0);
    // moving right in front, left behind
    return vec4(p, cos(a), 0.0);
}

fn ct_color(fi: f32) -> vec3<f32> {
    let k = glsl_mod(fi, 6.0);
    if k < 1.0 {
        return vec3<f32>(1.0, 0.55, 0.8);
    }
    if k < 2.0 {
        return vec3<f32>(0.5, 1.0, 0.8);
    }
    if k < 3.0 {
        return vec3<f32>(1.0, 0.82, 0.4);
    }
    if k < 4.0 {
        return vec3<f32>(0.75, 0.6, 1.0);
    }
    if k < 5.0 {
        return vec3<f32>(0.5, 0.8, 1.0);
    }
    return vec3<f32>(1.0, 0.7, 0.55);
}

// a paw print at c (pad + four toes), pointing along dir, size s
fn ct_paw(b: vec2<f32>, c: vec2<f32>, s: f32) -> f32 {
    let q = (b - c) / s;
    var d = sdEll(q - vec2<f32>(0.0, -0.1), vec2<f32>(0.42, 0.34));
    d = min(d, length(q - vec2<f32>(-0.42, 0.35)) - 0.15);
    d = min(d, length(q - vec2<f32>(-0.15, 0.55)) - 0.16);
    d = min(d, length(q - vec2<f32>(0.15, 0.55)) - 0.16);
    d = min(d, length(q - vec2<f32>(0.42, 0.35)) - 0.15);
    return d * s;
}

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px_in: f32) -> vec3<f32> {
    var px = px_in;
    let L = uLength;
    px = min(px, 0.06);
    let on = smoothstep(-0.6, 0.3, b.y);
    let edge = 1.0 - smoothstep(9.2, 10.6, abs(b.x));
    // the blade: white core, soft lavender glow with a slow moonlight shimmer
    let yc = clamp(b.y, 0.0, L - 0.35);
    let d = length(vec2(b.x, b.y - yc));
    var light = vec3<f32>(1.0, 0.97, 1.0) * exp(-pow(d / 0.36, 2.0)) * 1.5 * on;
    light += vec3<f32>(0.75, 0.55, 1.0) * halo(d, 0.85) * (0.55 + 0.1 * sin(b.y * 0.5 - uTime * 1.5)) * on + vec3<f32>(0.6, 0.45, 1.0) * halo(d, 2.0) * 0.1 * on;
    // the cats: neon outlines with a soft fill, dimmer when behind the blade
    for (var i = 0; i < 6; i++) {
        let fi = f32(i);
        var kind: f32;
        var size: f32;
        var hs: f32;
        let P = ct_place(fi, &kind, &size, &hs);
        var q = (b - P.xy) / size;
        if abs(q.x) > 2.4 || q.y < -1.2 || q.y > 1.9 {
            continue;
        }
        q.x *= hs;
        q += vec2<f32>(0.0, 0.9);
        let cd = ct_cat(q, kind, uTime + fi * 1.3) * size;
        let depth = mix(0.45, 1.0, smoothstep(-0.4, 0.4, P.z));
        let cc = ct_color(fi);
        let line = exp(-pow(cd / 0.06, 2.0)) * 1.6 + halo(abs(cd), 0.25) * 0.35;
        let fillc = fillD(cd, px) * 0.3;
        // eyes: two bright slits, blinking now and then
        let hc = select((select((select(vec2<f32>(0.62, 0.55), vec2<f32>(1.12, 1.25), kind < 2.5)), vec2<f32>(1.02, 1.1), kind < 1.5)), vec2<f32>(0.28, 1.55), kind < 0.5);
        let blink = select(step(0.08, fract(uTime * 0.3 + fi * 0.37)), 0.0, kind > 2.5);
        var eye = (fillD(length((q - hc - vec2<f32>(0.12, 0.05)) * vec2<f32>(3.0, 1.2)) - 0.12, px * 3.0 / size) + fillD(length((q - hc - vec2<f32>(-0.08, 0.05)) * vec2<f32>(3.0, 1.2)) - 0.1, px * 3.0 / size)) * blink;
        if kind > 2.5 {
            // asleep: two closed-eye arcs
            let e1 = q - hc - vec2<f32>(0.13, 0.02);
            let e2 = q - hc - vec2<f32>(-0.07, 0.02);
            let arc = min(abs(length(e1 + vec2<f32>(0.0, 0.08)) - 0.09) + 10.0 * step(0.0, -e1.y - 0.0), abs(length(e2 + vec2<f32>(0.0, 0.08)) - 0.08) + 10.0 * step(0.0, -e2.y));
            eye = halo(arc * size, 0.03) * 0.8;
        }
        light += (cc * (line + fillc) + vec3<f32>(1.0, 1.0, 0.85) * eye * 1.4) * depth;
        // a little Zz over the sleeper
        if kind > 2.5 {
            let zq = q - vec2(0.9, 1.3 + 0.4 * fract(uTime * 0.5));
            let z = min(min(sdSeg(zq, vec2<f32>(0.0, 0.2), vec2<f32>(0.2, 0.2)), sdSeg(zq, vec2<f32>(0.2, 0.2), vec2<f32>(0.0, 0.0))), sdSeg(zq, vec2<f32>(0.0, 0.0), vec2<f32>(0.2, 0.0)));
            light += cc * halo(z * size, 0.04) * (1.0 - fract(uTime * 0.5)) * depth;
        }
    }
    // paw prints walking up the blade's edge, each lighting then fading
    let stepL: f32 = 1.7;
    let n = floor((b.y + 1.0) / stepL);
    for (var k = 0; k < 2; k++) {
        let nk = n + f32(k);
        let side = select(-1.0, 1.0, glsl_mod(nk, 2.0) < 0.5);
        let c = vec2(side * 1.05, nk * stepL - 0.2);
        let walker = glsl_mod(uTime * 4.0, L / stepL + 10.0) - 3.0;
        // the stroller's position, in steps
        let age = walker - nk;
        let vis = smoothstep(0.0, 0.2, age) * (1.0 - smoothstep(2.0, 6.0, age)) * step(0.0, c.y) * step(c.y, L - 1.0);
        let pd = ct_paw(b, c, 0.55);
        light += vec3<f32>(1.0, 0.7, 0.95) * (fillD(pd, px) * 0.9 + halo(max(pd, 0.0), 0.12) * 0.4) * vis;
    }
    // cat eyes blinking open in the dark round the blade
    for (var k = 0; k < 4; k++) {
        let fk = f32(k);
        let ph = uTime * 0.22 + h11(fk * 4.1);
        let cy = floor(ph);
        let f = fract(ph);
        let c = vec2((select(1.0, -1.0, h11(cy * 3.3 + fk) < 0.5)) * (4.5 + 2.0 * h11(cy * 1.7 + fk)), (0.15 + 0.75 * h11(cy * 2.9 + fk * 3.0)) * L);
        var open = smoothstep(0.1, 0.2, f) * (1.0 - smoothstep(0.55, 0.65, f));
        open *= 1.0 - step(0.3, f) * step(f, 0.33);
        // one blink
        let ec = select(vec3<f32>(1.0, 0.8, 0.3), vec3<f32>(0.7, 1.0, 0.4), h11(cy + fk * 7.0) < 0.5);
        for (var e = 0; e < 2; e++) {
            var q = b - c - vec2((f32(e) - 0.5) * 0.75, 0.0);
            let eyeD = length(q * vec2(1.0, 1.0 / max(open, 0.05))) - 0.2;
            let slit = abs(q.x) - 0.04;
            light += ec * (fillD(eyeD, px) * (0.3 + 0.7 * smoothstep(0.0, 0.05, slit)) + halo(max(eyeD, 0.0), 0.25) * 0.4) * open * 1.3;
        }
    }
    // clash: nine cat-spirit heads burst out of the strike point and fade
    if uClash > 0.01 {
        let a = 1.0 - uClash;
        let o = vec2(0.0, L * 0.6);
        light += vec3<f32>(0.9, 0.8, 1.0) * halo(length(b - o), 1.2) * pow(uClash, 3.0) * 1.2;
        for (var k = 0; k < 9; k++) {
            let fk = f32(k);
            let an = fk * 0.698 + 0.2;
            let c = o + vec2(cos(an), sin(an)) * (0.6 + 6.5 * (1.0 - exp(-3.0 * a)));
            let hd = ct_head(b, c, 0.55);
            light += ct_color(fk) * (exp(-pow(hd / 0.06, 2.0)) * 1.5 + halo(abs(hd), 0.2) * 0.3) * uClash;
        }
    }
    light *= edge * (1.0 - smoothstep(L + 2.0, L + 5.5, b.y)) * smoothstep(-3.5, -1.0, b.y);
    return (1.0 - exp(-light * 1.15)) * 1.05;
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return vec3<f32>(0.0);
}

// GLSL's mod: x - y * floor(x / y) (WGSL's % truncates)
fn glsl_mod(x: f32, y: f32) -> f32 {
    return x - y * floor(x / y);
}
