// Generated by scripts/blade_signatures.py from serpent.glsl: edit that file and run the
// script again.
// @full 1
// @room 8

// Serpent: Creyon's Blade Lab design, reworked in full. A golden energy serpent coiled round an emerald
// blade, now slithering forward (its coils travel up toward its head at the tip). Golden scales shed off
// it and flutter away, venom drips from its fangs and hiss rings spread when its jaws open. A swing
// makes a spirit serpent strike out from the blade; a clash bursts its shed scales out in a ring.
// drawn in game: LAB_THIN 1.4
fn o_sstep(a: f32, b: f32, x: f32) -> f32 {
    let t = clamp((x - a) / (b - a), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

fn o_hash(n: f32) -> f32 {
    return fract(sin(n) * 43758.5453);
}

fn o_hash2(p: vec2<f32>) -> f32 {
    return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);
}

fn o_noise(p: vec2<f32>) -> f32 {
    let i = floor(p);
    var f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(o_hash2(i), o_hash2(i + vec2<f32>(1.0, 0.0)), f.x), mix(o_hash2(i + vec2<f32>(0.0, 1.0)), o_hash2(i + vec2<f32>(1.0)), f.x), f.y);
}

fn o_fbm(p_in: vec2<f32>) -> f32 {
    var p = p_in;
    var s: f32 = 0.0;
    var a: f32 = 0.5;
    for (var i = 0; i < 4; i++) {
        s += a * o_noise(p);
        p *= 2.03;
        a *= 0.5;
    }
    return s;
}

fn o_hsv(h: f32, s: f32, v: f32) -> vec3<f32> {
    let k = clamp(abs(glsl_mod_vec3_float(h * 6.0 + vec3<f32>(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0, vec3(0.0), vec3(1.0));
    return v * mix(vec3<f32>(1.0), k, s);
}

fn o_seg(x: f32, y: f32, L: f32) -> f32 {
    return length(vec2(max(0.0, max(-x, x - L)), y));
}

fn o_saber(g: vec3<f32>, c: vec3<f32>, d: f32, cr: f32, k: f32) -> vec3<f32> {
    let core = o_sstep(cr, cr * 0.35, d);
    let glow_ = exp(-d * k) * 0.55 + exp(-d * k * 0.3) * 0.16;
    return c * core + g * glow_ * (1.0 - core * 0.6);
}

fn o_fx(x: f32, y: f32, L: f32, d: f32, t: f32) -> vec3<f32> {
    let bl = o_saber(vec3<f32>(0.1, 1.0, 0.45), vec3<f32>(0.9, 1.0, 0.92), d, 0.014, 22.0);
    let A: f32 = 0.034;
    let k: f32 = 26.0;
    let w: f32 = 2.2;
    let xh = L * 0.9 + sin(t * 1.1) * 0.01;
    let ph = k * x - t * w;
    let yc = A * sin(ph);
    let z = cos(ph);
    let slope = A * k * cos(ph);
    let dy = abs(y - yc) / sqrt(1.0 + slope * slope);
    let tail = o_sstep(0.02, 0.25, x);
    let thk = 0.0085 * mix(0.35, 1.0, tail);
    let bodyOn = step(0.02, x) * step(x, xh - 0.008);
    let body = o_sstep(thk, thk * 0.5, dy) * bodyOn;
    let scales = 0.72 + 0.28 * sin(x * 260.0 - t * w * 260.0 / k) * sin((y - yc) * 900.0);
    let vis = mix(0.28, 1.0, step(0.0, z));
    let gold: vec3<f32> = vec3<f32>(1.0, 0.78, 0.25);
    let bc = gold * body * scales * vis * 1.25 + gold * exp(-dy * 120.0) * 0.22 * bodyOn * vis;
    let hph = k * xh - t * w;
    let hy = A * sin(hph);
    let hp = vec2(x - xh, y - hy);
    let jaw = o_sstep(0.7, 1.0, 0.5 + 0.5 * sin(t * 1.7));
    let hq = hp / vec2<f32>(0.028, 0.0145);
    var head = o_sstep(1.0, 0.75, length(hq - vec2<f32>(-0.1, 0.0)));
    let mouth = step(0.3, hq.x) * step(abs(hq.y), 0.5 * jaw);
    head *= 1.0 - mouth;
    let e = exp(-length(hp - vec2<f32>(0.005, 0.0058)) * 900.0) + exp(-length(hp - vec2<f32>(0.005, -0.0058)) * 900.0);
    let tongue = exp(-abs(hp.y - sin(t * 40.0) * 0.002) * 1600.0) * step(0.025, hp.x) * step(hp.x, 0.05) * step(0.5, jaw);
    return bl * (1.0 - body * step(0.0, z) * 0.6) + bc + gold * head * 1.3 + vec3<f32>(1.0, 0.08, 0.04) * e * 2.2 + vec3<f32>(1.0, 0.35, 0.4) * tongue;
}

// the serpent's show off the blade (SJK units)
fn sv_show(b: vec2<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let t = uTime;
    let S: f32 = 1.08 / 40.0;
    let A: f32 = 0.034;
    let k: f32 = 26.0;
    let w: f32 = 2.2;
    let xh = L * S * 0.9 + sin(t * 1.1) * 0.01;
    let hy = A * sin(k * xh - t * w);
    let head = vec2(hy / (S * 1.4), xh / S);
    // the head, in SJK units
    let jaw = o_sstep(0.7, 1.0, 0.5 + 0.5 * sin(t * 1.7));
    let gold: vec3<f32> = vec3<f32>(1.0, 0.78, 0.25);
    let em: vec3<f32> = vec3<f32>(0.15, 1.0, 0.45);
    var light: vec3<f32> = vec3<f32>(0.0);
    // the spirit serpent: a huge spectral emerald snake coiled round the blade, slithering up head first
    {
        let yH = L * 0.86 + 1.2 * sin(t * 0.5);
        let R = 3.3 + 1.2 * smoothstep(0.1, 0.6, uSwing) - 1.2 * uClash;
        let spin = t * 1.1;
        var best: f32 = 1.0e3;
        var bu: f32 = 0.0;
        var bz: f32 = 0.0;
        var pa: vec2<f32> = vec2<f32>(0.0);
        var headP: vec2<f32> = vec2<f32>(0.0);
        var headDir: vec2<f32> = vec2<f32>(0.0, 1.0);
        for (var j = 0; j <= 18; j++) {
            let u = f32(j) / 18.0;
            let a = -spin - u * 4.4;
            let pb = vec2(R * sin(a) * (1.0 - 0.25 * u), yH - u * 25.0);
            if j == 0 {
                headP = pb;
            }
            if j == 1 {
                headDir = normalize(headP - pb);
            }
            if j > 0 {
                let ba_ = pb - pa;
                let pa_ = b - pa;
                let hh = clamp(dot(pa_, ba_) / dot(ba_, ba_), 0.0, 1.0);
                let dd = length(pa_ - ba_ * hh);
                if dd < best {
                    best = dd;
                    bu = u - (1.0 - hh) / 18.0;
                    bz = cos(a);
                }
            }
            pa = pb;
        }
        let th = mix(0.85, 0.1, smoothstep(0.05, 1.0, bu)) * smoothstep(0.0, 0.06, bu + 0.02);
        let depth = mix(0.35, 1.0, smoothstep(-0.3, 0.3, bz));
        let body = smoothstep(th, th * 0.4, best);
        // diamond scales: a lattice along and across the body
        let sa_ = bu * 120.0;
        let sx_ = best / max(th, 0.05) * 3.0;
        let scl = 0.55 + 0.45 * smoothstep(0.15, 0.45, abs(fract(sa_ + sx_) - 0.5) + abs(fract(sa_ - sx_) - 0.5) - 0.3);
        let rim = exp(-pow((best - th * 0.85) / 0.07, 2.0));
        let sc = mix(vec3<f32>(0.1, 0.9, 0.45), vec3<f32>(0.6, 1.0, 0.35), 0.5 + 0.5 * sin(bu * 30.0 - t * 3.0));
        light += (sc * body * scl * 1.0 + vec3<f32>(0.7, 1.0, 0.75) * rim * 1.3 + em * halo(max(best - th, 0.0), 0.5) * 0.25) * depth * (1.0 - smoothstep(0.85, 1.0, bu));
        // its head: a broad wedge with two burning gold eyes, jaws opening to hiss
        var hq = (b - headP) / 1.45;
        hq = vec2(dot(hq, vec2(headDir.y, -headDir.x)), dot(hq, headDir));
        let hw = 0.75 * (1.0 - smoothstep(-0.6, 1.3, hq.y)) + 0.25;
        var hd = max(abs(hq.x) - hw, abs(hq.y - 0.3) - 1.0);
        let open = jaw * 0.5;
        hd = max(hd, -(abs(hq.x) - open * (hq.y - 0.3)) * step(0.3, hq.y));
        // the gaping mouth
        let hdepth = mix(0.35, 1.0, smoothstep(-0.3, 0.3, cos(-spin)));
        light += (em * fillD(hd, px) * 0.6 + vec3<f32>(0.7, 1.0, 0.75) * exp(-pow(hd / 0.06, 2.0)) * 1.2) * hdepth;
        let eyes = fillD(length((vec2(abs(hq.x), hq.y) - vec2<f32>(0.38, 0.55)) * vec2<f32>(1.0, 0.6)) - 0.12, px);
        light += vec3<f32>(1.0, 0.85, 0.2) * (eyes * 2.0 + halo(length(vec2(abs(hq.x), hq.y) - vec2<f32>(0.38, 0.55)), 0.35) * 0.6) * hdepth;
    }
    // golden scales shedding off the coils, tumbling away and fading
    for (var i = 0; i < 16; i++) {
        let fi = f32(i);
        let rate = 0.35 + 0.25 * h11(fi * 2.3);
        let ph = t * rate + h11(fi * 6.7);
        let cy = floor(ph);
        let f = fract(ph);
        let y0 = (0.08 + 0.78 * h11(cy * 1.9 + fi)) * L;
        let x0 = A * sin(k * y0 * S - t * w) / (S * 1.4);
        let sd = select(-1.0, 1.0, x0 >= 0.0);
        let v = vec2(sd * (2.0 + 3.0 * h11(cy + fi * 4.0)) * (1.0 + uSwing), 1.0 + 1.5 * h11(cy * 3.0 + fi));
        let p = vec2(x0, y0) + v * f;
        var q = b - p;
        let an = t * (4.0 + 3.0 * h11(fi)) + fi;
        q = vec2(q.x * cos(an) - q.y * sin(an), q.x * sin(an) + q.y * cos(an));
        let flip = abs(sin(t * 6.0 + fi * 2.0));
        // turning over as it flutters: it flashes
        let dia = (abs(q.x) / max(0.38 * flip, 0.06) + abs(q.y) / 0.5) - 1.0;
        let fade = (1.0 - f) * smoothstep(0.0, 0.1, f);
        light += gold * (clamp(-dia * 3.0, 0.0, 1.0) * (0.6 + 0.8 * flip) + halo(max(dia, 0.0) * 0.25, 0.08) * 0.4) * fade;
    }
    // venom dripping from the fangs while the jaws are open, and hiss rings spreading from the head
    for (var i = 0; i < 6; i++) {
        let fi = f32(i);
        let f = fract(t * 0.9 + fi / 6.0);
        let p = head + vec2<f32>(0.4, 1.0) + vec2(0.8 + 1.5 * f + 0.3 * h11(fi), -4.5 * f * f + 0.6 * f);
        let on = 0.35 + 0.65 * step(0.5, o_sstep(0.7, 1.0, 0.5 + 0.5 * sin((t - f / 0.9) * 1.7)));
        light += em * (fillD(length((b - p) * vec2<f32>(1.0, 0.75)) - 0.22 * (1.0 - 0.5 * f), px) + halo(length(b - p), 0.3) * 0.4) * (1.0 - f) * on * 1.3;
    }
    let hiss = fract(t * 1.7 / 6.2832 + 0.25);
    let ring = abs(length(b - head - vec2<f32>(0.0, 1.0)) - 0.6 - 5.0 * hiss);
    light += em * (halo(ring, 0.08 + 0.1 * hiss) * 1.6 + halo(ring, 0.5) * 0.3) * (1.0 - hiss) * (0.3 + 0.7 * jaw);
    // swing: a spirit serpent strikes out of the blade, jaws first, and fades
    let stv = smoothstep(0.45, 0.85, uSwing);
    if stv > 0.01 {
        let y0 = L * 0.55;
        let reach = 7.0 * stv;
        var dmin: f32 = 1.0e3;
        var along: f32 = 0.0;
        for (var j = 0; j < 12; j++) {
            let u0 = f32(j) / 12.0;
            let u1 = f32(j + 1) / 12.0;
            let a0 = vec2(u0 * reach, y0 + 1.6 * sin(u0 * 9.0 - t * 14.0) * u0 + u0 * 3.0);
            let a1 = vec2(u1 * reach, y0 + 1.6 * sin(u1 * 9.0 - t * 14.0) * u1 + u1 * 3.0);
            let dd = sdSeg(b, a0, a1);
            if dd < dmin {
                dmin = dd;
                along = u0;
            }
        }
        let th = 0.12 + 0.25 * along;
        let tipP = vec2(reach, y0 + 1.6 * sin(9.0 - t * 14.0) + 3.0);
        var hd = length((b - tipP) * vec2<f32>(0.8, 1.1)) - 0.55;
        light += mix(em, gold, along) * (exp(-pow(dmin / th, 2.0)) * 1.3 + halo(dmin, 0.5) * 0.25) * stv;
        light += gold * (fillD(hd, px) * 1.2 + halo(max(hd, 0.0), 0.4) * 0.5) * stv;
    }
    // clash: the shed skin bursts off in a ring of scales
    if uClash > 0.01 {
        let a = 1.0 - uClash;
        let o = vec2(0.0, L * 0.6);
        light += em * halo(length(b - o), 1.3) * pow(uClash, 3.0) * 1.2;
        for (var i = 0; i < 12; i++) {
            let fi = f32(i);
            let an = fi * 0.5236 + 0.3 * h11(fi);
            let p = o + vec2(cos(an), sin(an)) * (0.6 + 6.5 * (1.0 - exp(-3.0 * a)));
            var q = b - p;
            let dia = (abs(q.x) + abs(q.y)) / 0.3 - 1.0;
            light += gold * (clamp(-dia * 3.0, 0.0, 1.0) + halo(max(dia, 0.0) * 0.3, 0.1) * 0.5) * uClash * 1.3;
        }
    }
    let edge = 1.0 - smoothstep(8.5, 10.2, abs(b.x));
    light *= edge * smoothstep(-0.5, 1.0, b.y) * (1.0 - smoothstep(L + 1.5, L + 5.0, b.y));
    return (1.0 - exp(-light * 1.2)) * 1.05;
}

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let S: f32 = 1.08 / 40.0;
    let x = b.y * S;
    let y = b.x * S * 1.4;
    let L = uLength * S;
    let d = o_seg(x, y, L);
    let c = o_fx(x, y, L, d, uTime);
    let R: f32 = 0.11;
    let e = 1.0 - o_sstep(R * 0.45, R * 0.98, max(d, abs(y)));
    return (max(c, vec3<f32>(0.0)) * e + sv_show(b, min(px, 0.06))) * clamp(uIgn * 1.5, 0.0, 1.0);
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return vec3<f32>(0.0);
}

// GLSL's mod: x - y * floor(x / y) (WGSL's % truncates)
fn glsl_mod_vec3_float(x: vec3<f32>, y: f32) -> vec3<f32> {
    return x - y * floor(x / y);
}
