// Wraithlight: a pale haunted blade, like the light of a Force ghost. The blade is translucent and
// cold blue-white, brighter at its edges than its heart, like a glass rod full of moonlight, and
// it shimmers as slow ripples of light pass up it. Cold spirit mist pours off it and sinks toward
// the hilt in soft drifting veils, and faint echoes of the blade itself, its afterglows, hang in
// the air round it, drifting slowly, fading in and out of sight. Swinging leaves more echoes
// behind; a clash makes the blade flare and blows the mist out in a soft ring.
const WL_COL: vec3<f32> = vec3<f32>(0.42, 0.66, 1.0);

const WL_PALE: vec3<f32> = vec3<f32>(0.82, 0.92, 1.0);

fn wl_top() -> f32 {
    let g = clamp(uAge / 0.45, 0.0, 1.0);
    return uLength * (1.0 - (1.0 - g) * (1.0 - g));
}

// the translucent blade: brighter at the rim (light passes through more of a shell there)
fn wl_body(ro: vec3<f32>, rd: vec3<f32>, px: f32, top: f32, dax: ptr<function, f32>) -> vec3<f32> {
    var s: f32;
    (*dax) = raySeg(ro, rd, vec3<f32>(0.0, -0.6, 0.0), vec3(0.0, top, 0.0), &s);
    let y = s * (top + 0.6) - 0.6;
    var rip = 0.5 + 0.5 * sin(y * 0.45 - uTime * 2.2);
    rip = rip * rip;
    let shim = 0.85 + 0.15 * sin(y * 2.3 + uTime * 7.0) * sin(y * 0.7 - uTime * 3.1);
    let R = 0.42 + 0.04 * sin(y * 1.1 - uTime * 2.6);
    let Rp = max(R, px * 1.5);
    let in2 = Rp * Rp - (*dax) * (*dax);
    // the shell's limb: soft, never a hard line
    var limb = select(0.0, Rp / sqrt(in2 + Rp * Rp * 0.06), in2 > 0.0);
    limb *= smoothstep(-0.02, 0.06 * Rp, in2 / Rp);
    limb += exp(-pow(((*dax) - Rp) / (Rp * 0.25 + px), 2.0)) * 2.0;
    let heart = exp(-pow((*dax) / max(Rp * 0.3, px * 0.7), 2.0));
    let tipf = 1.0 - smoothstep(top - 1.0, top + 0.2, y);
    var c = WL_PALE * (limb * 0.28 * (0.8 + 0.6 * rip) + heart * 0.55) * shim;
    c += WL_COL * halo((*dax), 0.9) * (0.45 + 0.35 * rip) + WL_COL * halo((*dax), 2.6) * 0.1;
    return c;
}

// spirit mist density at p: pours off the blade and sinks, spreading as it falls
fn wl_mist(p: vec3<f32>, top: f32) -> f32 {
    let y = p.y;
    let r = length(p.xz);
    let a = atan2(p.x, p.z) / 6.2832;
    let down = clamp(1.0 - y / uLength, 0.0, 1.0);
    let spread = 1.2 + 1.5 * down + 1.6 * uClash;
    let n = fbm3(vec2(a * 4.0 + r * 0.3 + uTime * 0.03, y * 0.11 + uTime * 0.5 + r * 0.3));
    let n2 = vn(vec2(a * 9.0 - uTime * 0.05, y * 0.22 + uTime * 0.8));
    var d = smoothstep(0.38, 0.8, n * 0.85 + n2 * 0.25);
    d *= exp(-pow(r / spread, 2.0)) * smoothstep(0.2, 0.6, r + 0.3);
    d *= smoothstep(top + 1.0, top - 2.0, y) * smoothstep(-2.0, 6.0, y);
    return d;
}

// one echo of the blade: a faint copy drifting round it, fading in and out
fn wl_echo(ro: vec3<f32>, rd: vec3<f32>, i: f32, px: f32, top: f32) -> vec3<f32> {
    let per = 7.0 + 2.0 * h11(i * 3.1);
    let ph = fract(uTime / per + h11(i * 7.7));
    var life = sin(ph * 3.1416);
    life = life * life;
    let rad = 1.1 + 1.5 * h11(i * 2.3) + ph * 0.9 + uSwing * 1.2;
    let ang = h11(i * 5.9) + uTime * 0.025 * (select(-1.0, 1.0, h11(i) > 0.5)) + ph * 0.08;
    let y0 = 1.0 + 6.0 * h11(i * 4.4) + ph * 1.5;
    let len = top * (0.5 + 0.35 * h11(i * 9.1));
    let a = around(rad, ang, y0);
    let b = around(rad + 0.6 * (h11(i * 1.9) - 0.5), ang + 0.03 * (h11(i * 6.1) - 0.5), y0 + len);
    var s: f32;
    let d = raySeg(ro, rd, a, b, &s);
    let ends = smoothstep(0.0, 0.25, s) * (1.0 - smoothstep(0.7, 1.0, s));
    let flick = 0.75 + 0.25 * sin(uTime * (2.0 + h11(i) * 3.0) + s * 9.0 - uTime * 2.0);
    return (WL_PALE * halo(d, max(px * 0.8, 0.07)) * 0.45 + WL_COL * halo(d, 0.35) * 0.22 + WL_COL * halo(d, 1.0) * 0.05) * ends * life * flick * (0.9 + 0.7 * uSwing);
}

fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let top = wl_top();
    let cl = clamp(uClash, 0.0, 1.0);
    var dax: f32;
    var col = wl_body(ro, rd, px, top, &dax) * (1.0 + cl * 1.2);
    // spirit mist, marched
    if dax < 5.5 {
        let ms = marchSteps(ro, rd, 5.0, -5.0, top + 1.0, 22.0);
        if ms.z > 0.0 {
            let dt = ms.z;
            var t = ms.x + dt * h21(rd.xy * 517.0 + rd.z * 91.0);
            var acc: f32 = 0.0;
            var accw: f32 = 0.0;
            for (var i = 0; i < 22; i++) {
                let p = ro + rd * t;
                let d = wl_mist(p, top);
                let near = exp(-length(p.xz) * 0.5);
                acc += d * dt;
                accw += d * near * dt;
                t += dt;
            }
            let m = acc / (1.0 + acc * 0.35);
            let mw = accw / (1.0 + accw * 0.35);
            col += (WL_COL * m * 0.42 + WL_PALE * mw * 0.38) * uFx;
        }
    }
    // echoes of the blade
    if dax < 5.0 {
        var e: vec3<f32> = vec3<f32>(0.0);
        for (var i = 0; i < 6; i++) {
            e += wl_echo(ro, rd, f32(i), px, top);
        }
        col += e * uFx;
    }
    // clash: a soft ring of mist blown out
    if cl > 0.0 {
        let h = rayAt(ro, rd, uLength * 0.55);
        if h.z > 0.0 {
            let rr = length(h.xy);
            let aa = atan2(h.x, h.y);
            let R = 0.6 + (1.0 - cl) * 4.5;
            let n = 0.6 + 0.4 * vn(vec2(aa * 3.0, rr * 2.0));
            col += WL_PALE * halo(abs(rr - R), 0.6) * cl * n * 0.9 * uFx;
        }
    }
    return (1.0 - exp(-col * 1.1)) * 1.05;
}

