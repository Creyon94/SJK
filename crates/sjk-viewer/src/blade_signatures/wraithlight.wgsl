// Generated by scripts/blade_signatures.py from wraithlight.glsl: edit that file and run the
// script again.
// @room 8
// @ghosts {"count":4,"spacing":40.0,"fade":0.5}
// @palette {"corona.rim_cool":[0.30,0.95,0.80],"corona.rim_hot":[0.70,1.0,0.92],"corona.inner":[0.88,1.0,0.97],"core.white":[0.92,1.0,0.97],"core.fringe_cool":[0.35,0.95,0.82],"core.fringe_hot":[0.75,1.0,0.94],"light.color":[0.35,0.95,0.78],"trail":[0.35,0.95,0.78]}

// Wraithlight: a pale haunted blade of the Force's spirits. Cold spirit mist pours DOWN from its tip like dry ice and
// spills off at the hilt, and three soul-lights with comet tails climb it in a slow spiral, fade
// out at the tip and are born again at the hilt. A clash scatters the souls and blows the mist
// out in a ring; a swing leaves fading copies of the blade behind it.
// soft at both ends, so the copies a swing leaves (which have no hilt in front) end cleanly
fn wl_on(b: vec2<f32>) -> f32 {
    return smoothstep(-0.8, 0.6, b.y) * (1.0 - smoothstep(uLength - 0.5, uLength + 1.2, b.y));
}

fn wraithlight_glow0(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let on = wl_on(b);
    let L = uLength;
    let cl = clamp(uClash, 0.0, 1.0);
    let sw = clamp(uSwing, 0.0, 1.0);
    let spirit: vec3<f32> = vec3<f32>(0.35, 0.95, 0.78);
    let pale: vec3<f32> = vec3<f32>(0.85, 1.0, 0.96);
    // --- the blade: a pale, faintly see-through core whose edge wavers like breath on glass
    let wav = 0.06 * sin(b.y * 1.3 - uTime * 3.0) + 0.04 * sin(b.y * 3.1 + uTime * 5.0);
    let d = abs(b.x + wav) + max(b.y - L, 0.0) * 0.7;
    let veil = 0.75 + 0.25 * vn(vec2(b.x * 3.0, b.y * 0.6 - uTime * 1.5));
    let blade = pale * fillD(d - 0.18, px) * 1.1 * veil + spirit * halo(d, 0.4) * 0.75 + spirit * halo(d, 1.3) * 0.15;
    // --- spirit mist pouring down from the tip, thickening toward the hilt and spilling out sideways
    let fall = uTime * 3.0;
    let down = clamp(1.0 - b.y / L, 0.0, 1.0);
    // 0 at the tip, 1 at the hilt
    let spread = 0.75 + 1.1 * down * down + 0.9 * cl;
    // it widens as it falls
    let q = vec2(b.x / spread * 1.4, b.y * 0.28 + fall * 0.3);
    let n = fbm(q + vec2(fbm3(q * 0.8 - uTime * 0.15) * 1.2, 0.0));
    let curl = (1.0 - smoothstep(spread * 0.35, spread, abs(b.x))) * (1.0 - smoothstep(1.8, 2.4, abs(b.x)));
    let mist = smoothstep(0.34, 0.7, n) * curl * (0.6 + 0.4 * down);
    // little curls breaking off at the hilt end and drifting out
    let puff = smoothstep(0.55, 0.9, fbm3(vec2(b.x * 0.8 - sign(b.x) * uTime * 0.6, b.y * 0.5 + uTime * 0.4))) * (1.0 - smoothstep(1.8, 2.4, abs(b.x))) * smoothstep(8.0, 0.0, b.y) * 0.6;
    let fog = mix(spirit, pale, 0.25) * (mist * 1.5 + puff * 0.7);
    // --- three soul-lights climbing the blade in a spiral, each with a fading tail
    var souls: vec3<f32> = vec3<f32>(0.0);
    for (var i = 0; i < 3; i++) {
        let fi = f32(i);
        let per = 6.0 + fi * 1.3;
        let ph = fract(uTime / per + fi / 3.0);
        let yc = ph * (L - 2.0) + 1.0;
        let ang = ph * 12.566 + fi * 2.094 + uTime * 0.8;
        let rad = (1.15 + 0.15 * sin(uTime * 1.7 + fi)) * (1.0 + 0.6 * cl);
        // a clash flings them out
        let depth = 0.55 + 0.45 * cos(ang);
        // behind the blade: dimmer
        let life = smoothstep(0.0, 0.08, ph) * (1.0 - smoothstep(0.85, 1.0, ph));
        let c = vec2(sin(ang) * rad, yc);
        let od = length(b - c);
        let orb = fillD(od - 0.26, px) * 1.6 + halo(od, 0.5) * 1.3 + halo(od, 1.0) * 0.4;
        // the tail: the path it came along, fading over the last stretch
        var tail: f32 = 0.0;
        for (var k = 1; k < 7; k++) {
            let fk = f32(k);
            let pp = ph - fk * 0.016;
            let tc = vec2(sin(pp * 12.566 + fi * 2.094 + (uTime - fk * 0.07) * 0.8) * rad, pp * (L - 2.0) + 1.0);
            tail += halo(length(b - tc), 0.34 - fk * 0.03) * (1.0 - fk / 7.0) * 0.8;
        }
        souls += mix(spirit, pale, 0.5) * (orb + tail) * depth * life * 1.4;
    }
    // --- a clash: a ring of mist bursting outward from the blade
    let ring = halo(abs(abs(b.x) - (1.0 - cl) * 2.0), 0.35) * cl * step(0.0, b.y) * step(b.y, L) * 0.6;
    let light = (blade + fog + spirit * ring) * on + souls;
    return light * clamp(uIgn * 1.4, 0.0, 1.0);
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return vec3<f32>(0.0);
}

// ==== show (added) ====
// Wraithlight show: ghostly spirits drift up and away from the blade, each a wispy hooded shape with
// hollow glowing eyes and a trailing tail; pale green spirit flames lick off its sides; cold fog
// rolls round its base. A swing tears spirits loose; a clash makes them shriek outward in a ring.
fn wraithlight_show(b: vec2<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let spirit: vec3<f32> = vec3<f32>(0.45, 1.0, 0.8);
    let pale: vec3<f32> = vec3<f32>(0.85, 1.0, 0.95);
    var light: vec3<f32> = vec3<f32>(0.0);
    for (var i = 0; i < 6; i++) {
        let fi = f32(i);
        let ph = uTime * (0.15 + 0.06 * h11(fi * 2.3)) + h11(fi * 7.1);
        let cy = floor(ph);
        let f = fract(ph);
        let s = select(1.0, -1.0, h11(cy * 3.3 + fi) < 0.5);
        let p = vec2(s * (1.0 + 5.0 * f + 0.6 * sin(f * 8.0 + fi)), (0.1 + 0.6 * h11(cy * 1.7 + fi)) * L + 6.0 * f);
        var q = (b - p) / 1.2;
        q.x += 0.25 * sin(q.y * 3.0 - uTime * 4.0) * smoothstep(0.0, -1.5, q.y);
        let head = length(q - vec2<f32>(0.0, 0.3)) - 0.45;
        let body = length(vec2(q.x * (1.0 + 0.5 * max(-q.y, 0.0)), max(-q.y - 0.0, 0.0) * 0.35 + min(q.y, 0.0))) - 0.45 + max(-q.y, 0.0) * 0.18;
        var g = min(head, max(body, q.y - 0.3));
        g = max(g, -2.5 - q.y);
        let eyes = fillD(length(vec2(abs(q.x) - 0.17, q.y - 0.35) * vec2<f32>(1.0, 0.7)) - 0.09, px * 2.0);
        let mouth = fillD(length((q - vec2<f32>(0.0, 0.08)) * vec2<f32>(1.6, 0.8)) - 0.09, px * 2.0);
        let fade = smoothstep(0.0, 0.15, f) * (1.0 - smoothstep(0.7, 1.0, f));
        let core = fillD(g * 1.2, px) * 0.35;
        light += (spirit * (core + exp(-pow(max(g, 0.0) / 0.05, 2.0)) * 0.8 + halo(max(g, 0.0), 0.35) * 0.25) - spirit * (eyes + mouth) * 0.4 + pale * (eyes + mouth) * 0.0) * fade;
        light += vec3<f32>(0.0) * eyes;
    }
    for (var i = 0; i < 6; i++) {
        let fi = f32(i);
        let ph = uTime * (0.55 + 0.3 * h11(fi * 2.7)) + h11(fi * 6.1);
        let cy = floor(ph);
        let f = fract(ph);
        let s = select(1.0, -1.0, h11(cy * 3.1 + fi) < 0.5);
        let y0 = (0.1 + 0.8 * h11(cy * 1.9 + fi)) * L;
        let u = (b.x * s - 0.4) / 2.0;
        if u < 0.0 || u > 1.0 {
            continue;
        }
        let dy = b.y - y0 - 1.6 * u * u - 0.35 * sin(u * 7.0 - uTime * 10.0) * u;
        light += mix(pale, spirit, u) * exp(-pow(dy / (0.22 * (1.0 - u) + 0.03), 2.0)) * (1.0 - u) * (1.0 - f) * smoothstep(0.0, 0.1, f) * 1.2;
    }
    let fog = fbm(vec2(b.x * 0.3 + uTime * 0.15, b.y * 0.25 - uTime * 0.05));
    light += spirit * smoothstep(0.45, 0.8, fog) * exp(-max(b.y, 0.0) / 5.0) * smoothstep(0.8, 2.0, abs(b.x)) * (1.0 - smoothstep(5.0, 8.0, abs(b.x))) * 0.4;
    if cl > 0.01 {
        let o = vec2(0.0, L * 0.6);
        light += pale * halo(abs(length(b - o) - 1.0 - 7.0 * (1.0 - cl)), 0.15) * cl * 1.5;
    }
    let edge = 1.0 - smoothstep(8.5, 10.2, abs(b.x));
    light *= edge * (1.0 - smoothstep(L + 0.5, L + 3.5, b.y)) * smoothstep(-3.0, -0.5, b.y);
    return (1.0 - exp(-light * 1.15)) * 1.05;
}

// ==== the spirits (round 7) ====
// Force spirits round the blade: cold spectral flames lick up both its edges, three souls spiral
// round it on long glowing tails reaching four units out, and spirit flames break off the edges
// and rise away. A swing whips the souls out wide; a clash flashes every spirit at once.
fn wl_spirits(b: vec2<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let t = uTime;
    let ax = abs(b.x);
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let spirit: vec3<f32> = vec3<f32>(0.45, 1.0, 0.85);
    let pale: vec3<f32> = vec3<f32>(0.85, 1.0, 0.97);
    let along = smoothstep(-0.5, 1.5, b.y) * (1.0 - smoothstep(L - 1.0, L + 1.5, b.y));
    var light: vec3<f32> = vec3<f32>(0.0);
    // spectral flames up both edges
    let fl = fbm3(vec2(ax * 1.4 - t * 0.3, b.y * 0.45 - t * 2.2) + vec2(step(0.0, b.x) * 7.0, 0.0));
    let flame = smoothstep(0.35, 0.9, fl * 1.4 - (ax - 0.4) * 0.45) * smoothstep(0.25, 0.7, ax);
    light += spirit * flame * 0.9 * along + pale * flame * flame * 0.6 * along;
    // three souls spiralling round on long tails
    for (var k = 0; k < 3; k++) {
        let fk = f32(k);
        let y = fract(t * 0.09 + fk / 3.0) * (L + 4.0) - 2.0;
        let R = 3.0 + 1.5 * sw + 0.5 * sin(t + fk);
        for (var j = 0; j < 16; j++) {
            let fj = f32(j);
            let yy = y - fj * 0.45;
            let h = helix(yy, R * (1.0 - fj * 0.03), 0.8, t * 0.25 + fk / 3.0);
            let d = length(b - vec2(h.x, yy));
            let w = select(0.38 - fj * 0.02, 0.55, j == 0);
            light += mix(pale, spirit, fj / 16.0) * halo(d, max(w, 0.05)) * (select(0.55 * (1.0 - fj / 16.0), 2.6, j == 0)) * (0.45 + 0.55 * smoothstep(-0.6, 0.6, h.y));
        }
    }
    // spirit flames breaking off the edges and rising away, curling as they fade
    for (var i = 0; i < 10; i++) {
        let fi = f32(i);
        let ph = t * (0.35 + 0.2 * h11(fi * 2.9)) + h11(fi * 6.3);
        let cyc = floor(ph);
        let f = fract(ph);
        let sd = select(1.0, -1.0, h11(cyc + fi * 3.0) < 0.5);
        let p = vec2(sd * (0.8 + 5.0 * f + 0.9 * sin(f * 7.0 + fi)), (0.08 + 0.8 * h11(cyc * 1.7 + fi)) * L + 6.0 * f);
        let q = b - p;
        let tongue = length(vec2(q.x * 1.4, max(q.y, 0.0) * 0.35 + min(q.y, 0.0) * 1.3)) - 0.55 * (1.0 - f) - 0.1 * sin(t * 12.0 + fi + q.y * 5.0);
        light += (pale * fillD(tongue + 0.25, px) * 0.9 + spirit * halo(max(tongue, 0.0), 0.35) * 0.8) * (1.0 - f) * smoothstep(0.0, 0.1, f) * (1.0 + cl);
    }
    let edge = 1.0 - smoothstep(8.5, 10.0, ax);
    light *= edge * (1.0 - smoothstep(L + 1.0, L + 4.0, b.y)) * smoothstep(-2.5, -0.5, b.y);
    return (1.0 - exp(-max(light, vec3<f32>(0.0)) * 1.15)) * 1.05;
}

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px_in: f32) -> vec3<f32> {
    var px = px_in;
    px = min(px, 0.06);
    return wraithlight_glow0(g, b, r, px) + wraithlight_show(b, px) + wl_spirits(b, px);
}
