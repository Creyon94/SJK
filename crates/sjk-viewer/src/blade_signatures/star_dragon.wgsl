// Star Dragon: the power of the Duinuogwuin, the star dragons of legend, held as a blade. No dragon
// is drawn: the blade itself is the dragon. Its body is sheathed in overlapping scales of gold light
// that wrap all the way round it and ripple upward like a living hide; a deep inner fire pulses
// slowly up its heart. Dragon breath of stardust-fire rolls up the blade and peels off it near the
// tip, full of glinting star sparks, and dark-gold smoke curls round the hilt. A swing makes the
// scales flare open and blaze and the breath roar; a clash flashes the whole hide white-hot.
// the scale hide at point p on the shell: light of the scale that covers p (shingled, free edges
// toward the hilt), flare = how far they stand open
fn sdr_scale(p: vec3<f32>, flare: f32, aa: f32) -> f32 {
    let N: f32 = 6.0;
    let u = (atan2(p.x, p.z) / 6.28318 + 0.5 + p.y * 0.012) * N;
    let v = (p.y - uTime * 0.35) / 0.85;
    var best: f32 = 0.0;
    var found: f32 = 0.0;
    let r0 = floor(v * 2.0);
    for (var m = 2; m >= -1; m--) {
        let rr = r0 + f32(m);
        let off = 0.5 * glsl_mod(rr, 2.0);
        let cu = floor(u - off + 0.5) + off;
        let q = vec2(u - cu, (v - rr * 0.5) * 1.25);
        let d = length(q) / 0.62;
        if found < 0.5 && d < 1.0 {
            found = 1.0;
            let rid = h21(vec2(glsl_mod(cu, N), rr));
            let edge = smoothstep(0.62, 0.93, d) * (1.0 - smoothstep(0.93, 1.0, d + aa * 0.5));
            let body = 0.10 + 0.28 * d * d + 0.12 * rid;
            // a lengthwise ridge down each scale
            let ridge = halo(abs(q.x), 0.05 + aa) * smoothstep(0.1, 0.8, d) * 0.35;
            best = body + edge * (1.1 + 1.6 * flare) + ridge;
            // under an opened scale the inner fire shows through its lower half
            best += flare * smoothstep(0.2, 0.9, d) * step(q.y, 0.0) * 0.6;
        }
    }
    return best;
}

fn r8_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let top = L * clamp(uAge / 0.45, 0.0, 1.0);
    let fxOn = uFx * smoothstep(0.3, 1.2, uAge);
    let gold: vec3<f32> = vec3<f32>(1.0, 0.66, 0.20);
    let ember: vec3<f32> = vec3<f32>(1.0, 0.45, 0.10);
    let hot: vec3<f32> = vec3<f32>(1.0, 0.90, 0.65);
    let flare = clamp(sw * 0.9 + cl, 0.0, 1.0);
    // The body and its scale hide are Sol's glow and core from the file (sig_glow); here only
    // the effects, each a piece placed round it in 3D.
    var s: f32;
    var light: vec3<f32> = vec3<f32>(0.0);
    let roar = sw * 0.8 + cl * 0.5;
    // dragon breath: tongues of stardust-fire rolling up the blade and peeling off near the tip
    for (var i = 0; i < 22; i++) {
        let fi = f32(i);
        let rate = 0.35 + 0.2 * h11(fi * 2.9);
        let f = fract(uTime * rate * (1.0 + roar) + h11(fi * 6.1));
        let cy = floor(uTime * rate * (1.0 + roar) + h11(fi * 6.1));
        let y0 = L * (0.06 + 0.7 * h11(fi * 3.3 + cy));
        let yy = y0 + f * (6.0 + 4.0 * roar);
        if yy > top {
            continue;
        }
        let yl = clamp(yy / L, 0.0, 1.0);
        let p = around(0.8 + (1.8 + 3.6 * yl * yl + 1.5 * roar) * f, h11(fi * 7.7 + cy) + 0.2 * f, yy);
        var tt: f32;
        let d = rayPt(ro, rd, p, &tt);
        if d > 3.0 {
            continue;
        }
        let heat = 1.0 - f;
        let w = 0.5 + 1.0 * f;
        light += mix(ember, mix(gold, hot, heat), 0.4 + 0.6 * heat) * (halo(d, w) * 0.7 + halo(d, w * 2.0) * 0.15) * sin(3.1416 * f) * (0.8 + 0.4 * roar) * fxOn;
    }
    // star sparks riding the breath up and off the blade
    for (var i = 0; i < 22; i++) {
        let fi = f32(i);
        let rate = 0.18 + 0.12 * h11(fi * 3.7);
        let f = fract(uTime * rate * (1.0 + roar) + h11(fi * 1.9));
        let y0 = L * (0.3 + 0.5 * h11(fi * 5.3));
        let q = around(0.7 + 3.4 * f * f + roar * 1.5 * f, h11(fi * 7.1) + f * 0.45, y0 + f * (9.0 + 5.0 * h11(fi)));
        if q.y < top {
            var tt: f32;
            let d = rayPt(ro, rd, q, &tt);
            let tw = sin(f * 3.1416) * (0.6 + 0.4 * sin(uTime * 13.0 + fi * 4.0));
            let w = max(px * 1.1, 0.05);
            light += (vec3<f32>(1.0) * halo(d, w) * 2.4 + hot * halo(d, w * 4.0) * 0.5) * tw * fxOn;
        }
    }
    // smoke curling up from the hilt: dim warm puffs
    for (var i = 0; i < 8; i++) {
        let fi = f32(i);
        let f = fract(uTime * 0.3 + fi / 8.0);
        let p = around(0.9 + 0.8 * f, fi * 0.37 + f * 0.5 - uTime * 0.1, -0.3 + 4.0 * f);
        var tt: f32;
        let d = rayPt(ro, rd, p, &tt);
        light += vec3<f32>(0.55, 0.38, 0.18) * halo(d, 0.5 + 0.6 * f) * 0.25 * sin(3.1416 * f) * fxOn;
    }
    // a clash: a burst of light off the hide
    var tc: f32;
    light += hot * halo(rayPt(ro, rd, vec3(0.0, L * 0.6, 0.0), &tc), 3.0) * cl * 0.5 * fxOn;
    return light;
}

// the blade: Sol's glow and core from the file sheathed in the dragon's scale hide: shingled
// scales of gold light rippling up it, a slow inner fire pulsing up its heart, the scales
// flaring open and blazing on a swing, white-hot on a clash
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let flare = clamp(sw * 0.9 + cl, 0.0, 1.0);
    var pulse = 0.5 + 0.5 * sin(b.y * 0.35 - uTime * 2.2);
    pulse = pulse * pulse * pulse;
    let Rs = 0.85 + 0.2 * flare;
    var sc: f32 = 0.0;
    if abs(b.x) < Rs {
        let p = vec3(b.x, b.y, sqrt(Rs * Rs - b.x * b.x));
        sc = sdr_scale(p, flare, px / 0.4) * smoothstep(-0.4, 0.4, b.y) * (1.0 - smoothstep(uLength - 1.6, uLength - 0.2, b.y));
        let rip = smoothstep(0.75, 1.0, sin(b.y * 0.25 - uTime * 1.8));
        sc *= 0.55 * (0.8 + 0.6 * rip + 0.4 * pulse) * (1.0 - smoothstep(Rs * 0.8, Rs, abs(b.x)));
    }
    let gold: vec3<f32> = vec3<f32>(1.0, 0.66, 0.20);
    let hot: vec3<f32> = vec3<f32>(1.0, 0.90, 0.65);
    return g * (0.8 + 0.4 * pulse + 0.4 * flare) + mix(gold, hot, clamp(sc - 0.8, 0.0, 1.0) + cl * 0.6) * sc;
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c * (1.0 + 0.5 * clamp(uClash, 0.0, 1.0));
}

// ---- round 9: the big effects layer ----
// Round 11 (Creyon): its own look, Sol's way: its round-8 effects as part 0, its own parts
// (`part(k)`, the `// @part` lines) and Sol's pieces from its file; nothing shared with the others.
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let col = r8_vol(ro, rd, px) * part(0.0);
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let y0 = L * 0.2;
    let y1 = L * 0.97;
    var fx: vec3<f32> = vec3<f32>(0.0);
    fx += fxSparks(ro, rd, px, y0, y1, 16.0, 6.0, 0.8, 7.1, vec3<f32>(1.0, 0.92, 0.75)) * part(1.0);
    return col + fx * uFx;
}
