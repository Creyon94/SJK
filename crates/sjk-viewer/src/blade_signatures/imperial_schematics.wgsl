// Imperial Schematics: the schematics of an Imperial battle station, as a blade. Bands of a technical drawing
// light up the blade as a drawing head climbs it, and two measuring lines with tick marks draw
// themselves up beside it, then fade and start again. A clash flares it.
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let cyc = glsl_mod(uTime * 6.0, uLength + 10.0);
    let head = min(cyc, uLength);
    let fade = 1.0 - smoothstep(uLength, uLength + 10.0, cyc);
    let line = halo(abs(b.y - 2.5 * floor(b.y / 2.5 + 0.5)), 0.08) * step(b.y, head) * fade;
    return g * (0.85 + 0.6 * line * part(0.0)) + lvl(g) * vec3<f32>(0.8, 0.9, 1.0) * halo(abs(b.y - head), 0.5) * 0.5 * part(0.0);
}

