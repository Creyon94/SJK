// @room 10
// @palette {"corona.rim_cool":[0.45,0.70,1.0],"corona.rim_hot":[1.0,0.12,0.08],"corona.inner":[1.0,0.92,0.85],"core.white":[1.0,1.0,1.0],"core.fringe_cool":[0.45,0.75,1.0],"core.fringe_hot":[1.0,0.10,0.08],"light.color":[0.85,0.55,0.75],"trail":[0.9,0.45,0.6]}

// Balance: the light side and the dark side of the Force, held in one blade (Creyon's round 9
// rework). The blade is Sol's glow and core from the file, its glow split into long waves of
// calm blue-white and crimson that roll against each other up and down it, white where they
// meet. Round it the Force itself is divided: on one side the light, long straight beams of
// white-gold light, a slow halo ring and motes of light rising serenely; on the other the dark,
// red lightning crackling out and back in, crimson sparks and dark embers whirling. The two
// sides turn slowly round the blade, and every few seconds one surges and floods across the
// other before balance returns, with a flash on the seam. A swing feeds both sides; a clash
// bursts them outward together in a white ring.
const BA_BLUE: vec3<f32> = vec3<f32>(0.5, 0.75, 1.0);

const BA_GOLD: vec3<f32> = vec3<f32>(1.0, 0.92, 0.72);

const BA_RED: vec3<f32> = vec3<f32>(1.0, 0.09, 0.05);

// the light side's middle (turns round the blade); the dark side is half a turn on
fn ba_spin() -> f32 {
    return uTime * 0.05;
}

// the surge: > 0 the light floods across, < 0 the dark
fn ba_surge() -> f32 {
    let c = uTime / 7.0;
    let k = floor(c);
    let q = fract(c);
    let side = select(1.0, -1.0, h11(k * 3.7 + uSeed * 9.0) < 0.5);
    return side * smoothstep(0.55, 0.7, q) * (1.0 - smoothstep(0.8, 1.0, q));
}

// how much of the light side a direction at angle a (turns) is in: 1 light, 0 dark
fn ba_light(a: f32) -> f32 {
    let d = abs(fract(a - ba_spin() + 0.5) - 0.5);
    return 1.0 - smoothstep(0.2 - 0.12 * ba_surge(), 0.3 - 0.12 * ba_surge(), d);
}

// the waves of the blade's glow at height y: 1 light, 0 dark
fn ba_wave(y: f32) -> f32 {
    return smoothstep(-0.25, 0.25, sin(y * 0.16 - uTime * 0.9) + 0.6 * ba_surge());
}

fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let y0 = L * 0.2;
    let y1 = L * 0.97;
    var col: vec3<f32> = vec3<f32>(0.0);
    if fxNear(ro, rd, y0, y1) > 10.0 {
        return col;
    }
    let sp = ba_spin();
    let su = ba_surge();
    let lw = 1.0 + 0.8 * max(su, 0.0) + 0.5 * sw;
    let dw = 1.0 + 0.8 * max(-su, 0.0) + 0.5 * sw;
    var s: f32;
    var ta: f32;
    // ---- the light side: long, straight beams of white-gold light, slowly flaring ----
    for (var i = 0; i < 12; i++) {
        let fi = f32(i);
        let cyc = t * 0.35 * (0.8 + 0.4 * h11(fi * 3.1)) + h11(fi * 7.7);
        let k = floor(cyc);
        let q = fract(cyc);
        let a = sp + (h11(k * 2.3 + fi) - 0.5) * 0.42 * (1.0 + 0.6 * max(su, 0.0));
        let y = mix(y0, y1, h11(k * 5.1 + fi * 1.9));
        let dir = normalize(vec3(sin(6.2832 * a), 0.25 * (h11(k + fi * 4.0) - 0.5), cos(6.2832 * a)));
        let len = (5.5 + 3.0 * h11(k * 1.7 + fi)) * smoothstep(0.0, 0.35, q);
        let a0 = vec3(0.0, y, 0.0) + dir * 0.4;
        let d = raySeg(ro, rd, a0, a0 + dir * max(len, 0.01), &s);
        let w = mix(0.28, 0.08, s);
        col += (vec3<f32>(1.0) * halo(d, max(w * 0.45, px)) * 1.3 + BA_GOLD * halo(d, w * 3.0) * 0.9 + BA_BLUE * halo(d, w * 9.0) * 0.2) * (1.0 - 0.7 * s) * sin(3.1416 * q) * lw;
    }
    // its motes of light rising serenely
    for (var i = 0; i < 20; i++) {
        let fi = f32(i);
        let f = fract(t * (0.05 + 0.03 * h11(fi * 2.9)) + h11(fi * 5.1));
        let a = sp + (h11(fi * 1.9) - 0.5) * 0.45;
        let p = around(1.0 + 4.0 * h11(fi * 3.7), a, mix(y0 - 1.0, y1 + 2.0, f));
        let d = rayPt(ro, rd, p, &ta);
        col += mix(BA_BLUE, vec3<f32>(1.0), 0.5) * (halo(d, max(0.07, px)) * 1.8 + halo(d, 0.35) * 0.2) * sin(3.1416 * f) * lw;
    }
    // a slow halo ring of light round the blade's upper part, brightest on the light side
    {
        let yh = L * 0.72 + 1.5 * sin(t * 0.5);
        let h = rayAt(ro, rd, yh);
        if h.z > 0.0 {
            let d = abs(length(h.xy) - 3.0);
            let a = atan2(h.x, h.y) / 6.2832;
            col += (vec3<f32>(1.0) * halo(d, max(0.05, px)) * 0.8 + BA_GOLD * halo(d, 0.3) * 0.4) * ba_light(a) * lw;
        }
    }
    // ---- the dark side: red lightning crackling out and back, crimson sparks, embers ----
    for (var i = 0; i < 7; i++) {
        let fi = f32(i);
        let cyc = t * (1.6 + 1.5 * sw) * (0.7 + 0.6 * h11(fi * 1.9)) + h11(fi * 3.3) * 5.0;
        let k = floor(cyc);
        let q = fract(cyc);
        let a = sp + 0.5 + (h11(k * 4.1 + fi * 2.0) - 0.5) * 0.42 * (1.0 + 0.6 * max(-su, 0.0));
        let ya = mix(y0, y1 - 3.0, h11(k * 1.9 + fi * 2.7));
        let yb = ya + 3.0 + 5.0 * h11(k * 2.3 + fi);
        let R = 3.0 + 3.0 * h11(k * 7.7 + fi);
        let mid = around(R, a, (ya + yb) * 0.5 + (h11(k * 9.1 + fi) - 0.5) * 2.0);
        if rayPt(ro, rd, mid, &ta) > R + 5.0 {
            continue;
        }
        let env = (1.0 - q) * (1.0 - q) * (0.6 + 0.4 * step(0.5, fract(q * 9.0 + fi)));
        let d = min(bolt3(ro, rd, around(0.25, a, ya), mid, k + fi * 1.37, 0.5), bolt3(ro, rd, mid, around(0.25, a, yb), k + fi * 1.37 + 0.5, 0.5));
        let fork = mid + around(R * 0.5, a + 0.1 * (h11(k + fi) - 0.5), (h11(k * 3.3 + fi) - 0.5) * 3.0);
        let d2 = bolt3(ro, rd, mid, fork, k * 2.1 + fi, 0.6);
        col += (boltLight(d, BA_RED, px) + boltLight(d2, BA_RED, px) * 0.55) * env * dw;
    }
    for (var i = 0; i < 18; i++) {
        let fi = f32(i);
        let f = fract(t * (0.09 + 0.05 * h11(fi * 2.3)) + h11(fi * 6.1));
        let a = sp + 0.5 + (h11(fi * 1.3) - 0.5) * 0.45 + f * 0.3;
        let p = around(1.2 + 4.0 * h11(fi * 4.7) * (0.6 + 0.4 * f), a, mix(y1 + 1.0, y0 - 1.0, f));
        let d = rayPt(ro, rd, p, &ta);
        let tw = 0.5 + 0.5 * sin(t * 9.0 + fi * 2.3);
        col += mix(BA_RED, vec3<f32>(1.0, 0.45, 0.2), 0.3) * (halo(d, max(0.06, px)) * 2.0 + halo(d, 0.3) * 0.25) * sin(3.1416 * f) * tw * dw;
    }
    // ---- the seam: where the two sides meet, a churning line of white light up the blade ----
    for (var j = 0; j < 2; j++) {
        let a = sp + 0.25 + 0.5 * f32(j);
        var best: f32 = 1.0e3;
        var bf: f32 = 0.0;
        var prev = around(1.1, a, y0);
        for (var i = 1; i <= 14; i++) {
            let f = f32(i) / 14.0;
            let p = around(1.1 + 0.4 * sin(f * 17.0 - t * 3.0 + f32(j) * 2.0), a + 0.03 * sin(f * 11.0 + t * 2.0), mix(y0, y1, f));
            let d = raySeg(ro, rd, prev, p, &s);
            if d < best {
                best = d;
                bf = f;
            }
            prev = p;
        }
        let flick = 0.6 + 0.4 * vn(vec2(bf * 20.0 - t * 6.0, f32(j) * 7.0));
        col += (vec3<f32>(1.0) * halo(best, max(0.04, px)) * 0.9 + mix(BA_BLUE, BA_RED, f32(j)) * halo(best, 0.35) * 0.5) * flick * (0.6 + 1.4 * abs(su));
    }
    // the wide aura: blue on one side, crimson on the other
    let dAx = fxNear(ro, rd, y0, y1);
    let hp = ro + rd * max(dot(-ro, rd), 0.0);
    let ha = atan2(hp.x, hp.z) / 6.2832;
    col += mix(BA_RED, BA_BLUE, ba_light(ha)) * (halo(dAx, 3.0) * 0.3 + halo(dAx, 1.2) * 0.2);
    // a clash: both sides burst outward in one white ring
    col += fxShock(ro, rd, px, L * 0.55, 1.0 - cl, 10.0, mix(BA_BLUE, BA_RED, 0.5)) * 1.8;
    return col * uFx;
}

// the blade: Sol's glow from the file in long waves of blue-white and crimson, white at the seams
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let l = max(g.r, max(g.g, g.b));
    let w = ba_wave(b.y);
    let c = mix(BA_RED * 1.25, mix(BA_BLUE, vec3<f32>(1.0), 0.2), w) + vec3<f32>(1.0, 0.9, 0.95) * 4.0 * w * (1.0 - w) * 0.5;
    return l * c * (1.0 + 0.3 * clamp(uSwing, 0.0, 1.0) + clamp(uClash, 0.0, 1.0));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    let w = ba_wave(b.y);
    return c * mix(vec3<f32>(1.0, 0.8, 0.8), vec3<f32>(0.88, 0.94, 1.0), w);
}
