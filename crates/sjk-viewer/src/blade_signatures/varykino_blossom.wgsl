// Varykino Blossom: the spring gardens of Varykino, Naboo's lake retreat, as a blade (Kushina's
// idea, 15/10/2026; the Mythical sibling of the Naboo Blossom). A soft blossom-pink blade, its
// palette locked, with pale petals of light opening and fading along it; lavender and white mist
// curls off it, blossoms drift down round it, and a branch of cherry wood with one flower grows
// from where the blade leaves the hilt. Swinging it sheds real blossoms that flutter to the
// ground behind it (`@petals`, `saber_petals.rs`); a clash bursts a ring of petals.
const VB_PINK: vec3<f32> = vec3<f32>(1.0, 0.48, 0.72);

const VB_PALE: vec3<f32> = vec3<f32>(1.0, 0.82, 0.92);

const VB_LILAC: vec3<f32> = vec3<f32>(0.72, 0.6, 1.0);

const VB_WOOD: vec3<f32> = vec3<f32>(0.32, 0.19, 0.12);

const VB_BARK: vec3<f32> = vec3<f32>(0.58, 0.38, 0.26);

// a five-petal blossom's shape at q (its own plane, radius 1): 0 outside, 1 inside a petal
fn vb_flower(q: vec2<f32>, px: f32) -> f32 {
    let a = atan2(q.y, q.x);
    let r = length(q);
    // five rounded petals, each with the little notch at its end a cherry blossom has
    let petal = 0.62 + 0.38 * abs(cos(2.5 * a));
    let notch = 0.12 * pow(abs(cos(2.5 * a)), 24.0);
    return fillD(r - (petal - notch), px);
}

// the blade: Sol's glow from the file in blossom pink, pale petals of light opening and fading
// along it, a slow breath of white blushing up from the hilt
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let l = lvl(g);
    var col = recol(g, VB_PINK) * 1.15;
    let blush = 0.5 + 0.5 * sin(b.y * 0.18 - uTime * 0.9);
    col += l * VB_PALE * blush * 0.35;
    // petals of light in the glow: cells along the blade, each a soft oval that opens and fades
    let cell = floor(b.y * 0.45);
    let f = fract(uTime * 0.25 + h11(cell * 7.1));
    let c = vec2((h11(cell * 3.3) - 0.5) * 0.9 * r, (cell + 0.5) / 0.45);
    let q = rot(h11(cell * 5.7) * 6.2832 + uTime * 0.3) * (b - c);
    let pd = length(q / vec2<f32>(0.55, 0.3));
    col += l * VB_PALE * halo(pd - 0.6, 0.25) * sin(3.1416 * f) * 0.6;
    return col;
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c * vec3<f32>(1.0, 0.72, 0.86);
}

// blossoms drifting down round the blade: each a five-petal flower facing the camera, turning
// and swaying as it falls, pink or white
fn vb_petals(ro: vec3<f32>, rd: vec3<f32>, px: f32, y0: f32, y1: f32) -> vec3<f32> {
    var acc: vec3<f32> = vec3<f32>(0.0);
    if fxNear(ro, rd, y0 - 4.0, y1) > 4.0 {
        return acc;
    }
    var ta: f32;
    let fu = normalize(cross(rd, select(vec3<f32>(1.0, 0.0, 0.0), vec3<f32>(0.0, 1.0, 0.0), abs(rd.y) < 0.9)));
    let fv = cross(rd, fu);
    for (var i = 0; i < 14; i++) {
        let fi = f32(i);
        let f = fract(uTime * 0.07 * (0.7 + 0.6 * h11(fi * 2.7)) + h11(fi * 6.1));
        let p = around(0.8 + 2.0 * h11(fi * 3.9) + 0.5 * sin(uTime * 0.8 + fi * 2.0), h11(fi * 5.3) + 0.04 * uTime, mix(y1, y0 - 4.0, f));
        let d = rayPt(ro, rd, p, &ta);
        if d > 1.6 + px {
            continue;
        }
        let q = ro + rd * ta - p;
        // tumbling: the flower's width shrinks and grows as it turns edge on and back
        let tumble = 0.45 + 0.55 * abs(sin(uTime * (0.8 + 0.6 * h11(fi * 1.9)) + fi));
        let e = rot(uTime * 0.9 + fi * 1.7) * vec2(dot(q, fu), dot(q, fv));
        let size = 0.55 + 0.2 * h11(fi * 8.3);
        let shape = vb_flower(e / vec2(size, size * tumble), px / size);
        let tint = mix(VB_PINK, VB_PALE, step(0.55, h11(fi * 4.4)));
        let life = smoothstep(0.0, 0.08, f) * (1.0 - smoothstep(0.85, 1.0, f));
        acc += (tint * shape * 0.9 + tint * halo(d, 0.7) * 0.06) * life;
    }
    return acc;
}

// lavender and white mist curling up off the blade, two soft clouds woven together
fn vb_mist(ro: vec3<f32>, rd: vec3<f32>, y0: f32, y1: f32) -> vec3<f32> {
    return fxSmoke(ro, rd, y0, y1, 2.8, 1.6, 3.0, VB_LILAC) * 1.1 + fxSmoke(ro, rd, y0 + 2.0, y1, 2.0, 2.2, 11.0, vec3<f32>(1.0, 0.94, 0.98)) * 0.6;
}

// the effects round the blade
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let cl = clamp(uClash, 0.0, 1.0);
    let y0 = L * 0.15;
    let y1 = L * 0.97;
    var fx: vec3<f32> = vec3<f32>(0.0);
    fx += vb_mist(ro, rd, y0, y1) * part(1.0);
    fx += vb_petals(ro, rd, px, y0, y1) * part(2.0);
    // a clash: a ring of petals bursting out across the blade
    if cl > 0.0 {
        let y = L * 0.6;
        var ring: vec3<f32> = vec3<f32>(0.0);
        var ta: f32;
        for (var i = 0; i < 10; i++) {
            let fi = f32(i);
            let R = 0.8 + (1.0 - cl) * 4.0;
            let p = around(R, fi / 10.0 + 0.05 * h11(fi), y + (1.0 - cl) * (h11(fi * 2.3) - 0.5) * 2.0);
            let d = rayPt(ro, rd, p, &ta);
            ring += mix(VB_PINK, VB_PALE, h11(fi * 3.1)) * (halo(d, 0.28) * 0.9 + halo(d, 0.9) * 0.15);
        }
        fx += ring * cl * 1.3;
    }
    return fx * uFx;
}

// an open blossom at fp, size across, facing the camera, turned by turn: pale at its heart,
// pink at its petals' ends, a gold heart of stamens, over what res holds
fn vb_bloom(res_in: vec4<f32>, ro: vec3<f32>, rd: vec3<f32>, px: f32, fp: vec3<f32>, size0: f32, turn: f32) -> vec4<f32> {
    var res = res_in;
    var tf: f32;
    let df = rayPt(ro, rd, fp, &tf);
    if df < size0 * 1.3 {
        let q = ro + rd * tf - fp;
        let fu = normalize(cross(rd, select(vec3<f32>(1.0, 0.0, 0.0), vec3<f32>(0.0, 1.0, 0.0), abs(rd.y) < 0.9)));
        let p = rot(turn + 0.15 * sin(uTime * 0.7)) * vec2(dot(q, fu), dot(q, cross(rd, fu)));
        let size = size0 * (1.0 + 0.04 * sin(uTime * 1.3 + turn));
        let shape = vb_flower(p / size, px / size);
        let r = length(p) / size;
        // pale at its heart, pink at its petals' ends, a gold heart of stamens
        let petal = mix(VB_PALE, VB_PINK, smoothstep(0.15, 0.9, r));
        let heart = fillD(r - 0.18, px / size);
        let col = mix(petal, vec3<f32>(1.0, 0.8, 0.35), heart);
        res = vec4(mix(res.rgb, col, shape), max(res.a, shape));
    }
    return res;
}

// the branch: a twig of dark cherry wood growing from where the blade leaves the hilt, curving
// out and up, a smaller twig off it with a bud, and two open blossoms; it circles
// nothing, but stands in true 3D beside the blade
fn sig_orbit_solid(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec4<f32> {
    if part(0.0) < 0.5 {
        return vec4<f32>(0.0);
    }
    if fxNear(ro, rd, -0.5, 9.0) > 6.5 {
        return vec4<f32>(0.0);
    }
    let a: vec3<f32> = vec3<f32>(0.45, 0.3, 0.0);
    let m: vec3<f32> = vec3<f32>(2.1, 3.2, 0.4);
    let e: vec3<f32> = vec3<f32>(3.6, 6.0, 0.25);
    let side: vec3<f32> = vec3<f32>(2.7, 4.3, -1.0);
    var s1: f32;
    var s2: f32;
    var s3: f32;
    let d1 = raySeg(ro, rd, a, m, &s1);
    let d2 = raySeg(ro, rd, m, e, &s2);
    let d3 = raySeg(ro, rd, m + (e - m) * 0.3, side, &s3);
    // tapering: thickest at the hilt, thin at the twigs' ends
    let w1 = mix(0.34, 0.24, s1);
    let w2 = mix(0.24, 0.13, s2);
    let w3 = mix(0.15, 0.08, s3);
    let wood = max(max(fillD(d1 - w1, px), fillD(d2 - w2, px)), fillD(d3 - w3, px));
    // bark: lighter along the wood's lit edge, darker rings of grain
    let edge = max(max(d1 / w1, d2 / w2), 0.0);
    let bark = mix(VB_BARK, VB_WOOD, clamp(edge, 0.0, 1.0)) * (0.85 + 0.15 * sin((s1 + s2) * 14.0));
    var res = vec4(bark, wood);
    // the bud at the side twig's end
    var tb: f32;
    let db = rayPt(ro, rd, side, &tb);
    let bud = fillD(db - 0.32, px);
    res = vec4(mix(res.rgb, mix(VB_PINK, VB_PALE, 0.3), bud), max(res.a, bud));
    // the open blossoms: one at the branch's end, a smaller one by its fork
    res = vb_bloom(res, ro, rd, px, e + vec3<f32>(0.25, 0.4, 0.0), 1.45, 0.3);
    res = vb_bloom(res, ro, rd, px, m + vec3<f32>(-0.2, 0.55, 0.5), 0.95, 2.1);
    return res;
}
