// Sensor Sweep: a starship's sensor screen as a blade. A bright sweep runs up the blade again and
// again, and small contacts light up beside it as it passes and fade away.
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let q = fract(uTime / 3.0);
    let sweep = halo(b.y - q * uLength * 1.1, 1.2) + 0.4 * halo(b.y - q * uLength * 1.1 + 2.5, 3.0);
    return g * (0.75 + 0.8 * sweep * part(0.0));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c;
}

// the effects, flat round the blade as Sol's are
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let y0 = L * 0.2;
    let y1 = L * 0.97;
    var fx: vec3<f32> = vec3<f32>(0.0);
    var ta: f32;
    let k = floor(t / 3.0);
    let q = fract(t / 3.0);
    for (var i = 0; i < 6; i++) {
        let fi = f32(i);
        let yb = mix(y0, y1, h11(k * 3.3 + fi * 1.7));
        let age = q - yb / (L * 1.1);
        if age < 0.0 {
            continue;
        }
        let p = vec3((select(1.0, -1.0, h11(k * 1.9 + fi) < 0.5)) * (1.0 + 1.8 * h11(k * 5.1 + fi)), yb, 0.0);
        let d = rayPt(ro, rd, p, &ta);
        fx += vec3<f32>(0.6, 1.0, 0.65) * (halo(d, max(0.07, px)) * 1.4 + halo(d, 0.35) * 0.3) * exp(-age * 3.0) * part(1.0);
    }
    return fx * uFx;
}
