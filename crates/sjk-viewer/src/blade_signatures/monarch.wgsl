// @full 1
// @room 7
// @solid 1

// Monarch: Creyon's Blade Lab design, reworked with its butterflies drawn in full. A thin warm amber
// blade with real monarch butterflies (orange wings, black veins, white-spotted borders) resting on
// it, taking off in looping flights trailed by golden pollen and landing again. A swing scatters
// them all; a clash blows them off in a burst of pollen; every few seconds a swarm of glowing
// butterflies spirals up the blade and bursts off the tip. Ignition: they fly in from all round.
const MN_N: i32 = 10;

// position of butterfly i at time t (SJK units): rests on the blade's edge, flies loops off it
fn mn_pos(fi: f32, t: f32) -> vec2<f32> {
    let L = uLength;
    let side = select(-1.0, 1.0, glsl_mod(fi, 2.0) < 0.5);
    let yh = (0.12 + 0.8 * fract(fi * 0.618 + 0.13)) * L;
    let home = vec2(side * 0.9, yh);
    let rate = 0.13 + 0.05 * h11(fi * 3.7);
    let c = fract(t * rate + h11(fi * 9.1));
    let fly = smoothstep(0.0, 0.1, c) * (1.0 - smoothstep(0.42, 0.56, c));
    let a = c * 6.2832 * 1.3 + fi;
    let loop_ = vec2(side * (2.6 + 2.2 * sin(a)), 2.6 * sin(a * 0.8) + 1.5 * sin(a * 1.9));
    var p = home + loop_ * fly;
    // swing / clash: everyone scatters outward and up, then drifts back
    let sc = max(uSwing, uClash * 1.3);
    let da = 6.2832 * h11(fi * 5.3);
    let dir = normalize(vec2(side * (1.2 + abs(cos(da))), sin(da) + 0.4));
    p += dir * (4.5 + 2.0 * h11(fi * 2.9)) * smoothstep(0.0, 1.0, sc);
    // ignition: they arrive from far off
    let arr = smoothstep(0.0, 2.2, uAge - 0.15 * fi);
    p += dir * 9.0 * (1.0 - arr);
    p.y = clamp(p.y, -1.0, L + 3.0);
    return p;
}

// how much butterfly i is flying (0 resting .. 1 in the air)
fn mn_air(fi: f32, t: f32) -> f32 {
    let c = fract(t * (0.13 + 0.05 * h11(fi * 3.7)) + h11(fi * 9.1));
    return max(smoothstep(0.0, 0.1, c) * (1.0 - smoothstep(0.42, 0.56, c)), max(uSwing, uClash));
}

// a monarch in its own frame: q.y along the body (head +), q.x across; s = size, open = wing opening.
// returns (wing orange amount, black, white spot, body) coverage
fn mn_shape(q: vec2<f32>, s: f32, open: f32, px: f32) -> vec4<f32> {
    let w = abs(q.x) / max(open, 0.12);
    let u = q.y;
    var f = vec2(w - 0.52 * s, u - 0.2 * s);
    f = vec2(f.x * 0.94 - f.y * 0.34, f.x * 0.34 + f.y * 0.94);
    let fore = length(f / vec2(0.56 * s, 0.36 * s)) - 1.0;
    let h = vec2(w - 0.38 * s, u + 0.26 * s);
    let hind = length(h / vec2(0.38 * s, 0.31 * s)) - 1.0;
    let wing = min(fore, hind);
    let ed = px * 1.5 / (s * 0.3 * max(open, 0.12));
    let cov = clamp(0.5 - wing / max(ed, 1.0e-3), 0.0, 1.0) * step(0.02, w + 0.02);
    // black border band, black veins radiating from the root
    let border = smoothstep(-0.36, -0.24, wing);
    let ang = atan2(u + 0.05 * s, w + 0.02);
    let veins = smoothstep(0.78, 0.93, abs(sin(ang * 4.5 + w * 2.0 / s))) * smoothstep(0.08 * s, 0.25 * s, w);
    let black = max(border, veins * 0.85);
    // white spots strung along the border
    let sa = atan2(f.y, f.x) * 7.0;
    let sb = atan2(h.y, h.x) * 6.0;
    let spot = max(smoothstep(0.45, 0.8, cos(sa)) * smoothstep(-0.2, -0.12, fore) * (1.0 - smoothstep(-0.08, -0.02, fore)), smoothstep(0.5, 0.85, cos(sb)) * smoothstep(-0.2, -0.12, hind) * (1.0 - smoothstep(-0.08, -0.02, hind)));
    let body = clamp(0.5 - (length(vec2(q.x * 2.6, clamp(u, -0.42 * s, 0.42 * s) - u)) - 0.12 * s) / px, 0.0, 1.0) * step(-0.5 * s, u) * step(u, 0.5 * s) + clamp(0.5 - (abs(q.x) - 0.05 * s) / px, 0.0, 1.0) * step(-0.42 * s, u) * step(u, 0.42 * s);
    return vec4(cov, black * cov, spot * cov, clamp(body, 0.0, 1.0));
}

// local frame of butterfly i: rotate by its heading
fn mn_frame(b: vec2<f32>, p: vec2<f32>, v: vec2<f32>) -> vec2<f32> {
    let hd = select(vec2<f32>(0.0, 1.0), normalize(v), length(v) > 1.0e-3);
    let d = b - p;
    return vec2(d.x * hd.y - d.y * hd.x, d.x * hd.x + d.y * hd.y);
}

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px_in: f32) -> vec3<f32> {
    var px = px_in;
    let L = uLength;
    px = min(px, 0.06);
    let on = smoothstep(-0.6, 0.3, b.y);
    let edge = 1.0 - smoothstep(7.5, 10.0, abs(b.x));
    let tipF = 1.0 - smoothstep(L + 2.0, L + 4.5, b.y);
    // the blade: warm white core, amber glow, a slow honey shimmer
    let yc = clamp(b.y, 0.0, L - 0.35);
    let d = length(vec2(b.x, b.y - yc));
    let shim = 0.9 + 0.1 * sin(b.y * 0.6 - uTime * 2.2);
    var light = vec3<f32>(1.0, 0.95, 0.82) * exp(-pow(d / 0.36, 2.0)) * 1.5 * on;
    light += vec3<f32>(1.0, 0.55, 0.12) * halo(d, 0.85) * 0.6 * shim * on + vec3<f32>(1.0, 0.45, 0.08) * halo(d, 2.2) * 0.1 * on;
    // butterflies: a warm glow round each, golden pollen trailing the flyers
    for (var i = 0; i < MN_N; i++) {
        let fi = f32(i);
        let p = mn_pos(fi, uTime);
        let air = mn_air(fi, uTime);
        let dd = length(b - p);
        light += vec3<f32>(1.0, 0.5, 0.1) * halo(dd, 1.4) * (0.05 + 0.08 * air);
        for (var k = 1; k < 5; k++) {
            let fk = f32(k);
            let pk = mn_pos(fi, uTime - fk * 0.09) + vec2(0.0, -0.15 * fk) + 0.25 * (vec2(h11(fi + fk * 7.0), h11(fi * 3.0 + fk)) - 0.5) * fk;
            light += vec3<f32>(1.0, 0.82, 0.4) * halo(length(b - pk), 0.09) * (1.1 - fk * 0.22) * air * 0.9;
        }
    }
    // the swarm: every 9 s glowing butterflies spiral up round the blade and burst off the tip
    let sp = glsl_mod(uTime, 9.0) / 3.2;
    if sp < 1.0 {
        for (var k = 0; k < 7; k++) {
            let fk = f32(k);
            let pr = sp * 1.35 - fk * 0.06;
            if pr < 0.0 || pr > 1.25 {
                continue;
            }
            let y = pr * L;
            let burst = max(pr - 0.95, 0.0) * 14.0;
            let ang = pr * 14.0 + fk * 0.9;
            let p = vec2(2.0 * sin(ang) + sign(sin(fk * 2.1 + 0.3)) * burst, y + burst * 0.6);
            let v = vec2(2.0 * cos(ang) * 14.0, L);
            let q = mn_frame(b, p, v);
            let sh = mn_shape(q, 1.1, 0.25 + 0.75 * abs(sin(uTime * 16.0 + fk)), px);
            let fade = smoothstep(0.0, 0.08, pr) * (1.0 - smoothstep(1.0, 1.25, pr));
            let depth = 0.55 + 0.45 * cos(ang);
            light += (vec3<f32>(1.0, 0.6, 0.12) * sh.x * (1.0 - sh.y) + vec3<f32>(1.0, 0.95, 0.8) * sh.z + vec3<f32>(1.0, 0.7, 0.3) * halo(length(b - p), 0.6) * 0.35) * fade * depth * 1.2;
            light += vec3<f32>(1.0, 0.8, 0.4) * halo(length(b - (p - normalize(v) * 0.9)), 0.12) * fade * 0.6;
        }
    }
    // clash: a pollen burst blown off the blade
    if uClash > 0.01 {
        let a = 1.0 - uClash;
        for (var k = 0; k < 12; k++) {
            let fk = f32(k);
            let an = fk * 0.5236 + 0.3 * h11(fk);
            let p = vec2(0.0, L * 0.55) + vec2(cos(an), sin(an)) * (1.0 + 7.0 * a);
            light += vec3<f32>(1.0, 0.8, 0.35) * halo(length(b - p), 0.14) * uClash * 1.4;
        }
        light += vec3<f32>(1.0, 0.6, 0.2) * halo(length(b - vec2(0.0, L * 0.55)), 2.0) * pow(uClash, 3.0) * 0.6;
    }
    light *= edge * tipF * smoothstep(-3.0, -0.5, b.y);
    return (1.0 - exp(-light * 1.15)) * 1.05 * clamp(uIgn * 1.5, 0.0, 1.0);
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return vec3<f32>(0.0);
}

// the butterflies themselves, as solid wings over the glow
fn sig_solid(o: vec4<f32>, b: vec2<f32>, px_in: f32) -> vec4<f32> {
    var px = px_in;
    px = min(px, 0.06);
    let L = uLength;
    if b.y < -3.0 || b.y > L + 6.0 || abs(b.x) > 10.0 {
        return o;
    }
    var acc = o;
    for (var i = 0; i < MN_N; i++) {
        let fi = f32(i);
        let p = mn_pos(fi, uTime);
        if length(b - p) > 2.4 {
            continue;
        }
        let air = mn_air(fi, uTime);
        var v = mn_pos(fi, uTime + 0.05) - p;
        // resting: heads point up the blade, wings slowly opening; flying: fast flaps
        v = mix(vec2<f32>(0.0, 1.0), v, smoothstep(0.1, 0.4, air));
        let open = mix(0.55 + 0.45 * sin(uTime * 1.6 + fi * 1.7), 0.18 + 0.82 * abs(sin(uTime * 15.0 + fi * 2.3)), smoothstep(0.1, 0.5, air));
        let s = 1.55 + 0.35 * h11(fi * 4.1);
        let q = mn_frame(b, p, v);
        let sh = mn_shape(q, s, open, px);
        let shade = 0.75 + 0.25 * open;
        let wingC = mix(vec3<f32>(0.95, 0.32, 0.02), vec3<f32>(1.0, 0.55, 0.08), smoothstep(0.0, 0.6 * s, abs(q.x))) * shade * 1.15;
        var col = mix(wingC, vec3<f32>(0.03, 0.02, 0.02), sh.y);
        col = mix(col, vec3<f32>(1.0, 0.97, 0.9), sh.z);
        col = mix(col, vec3<f32>(0.04, 0.03, 0.03), sh.w);
        let a = max(sh.x, sh.w) * 0.97 * clamp(uIgn * 1.5, 0.0, 1.0);
        acc = vec4(mix(acc.rgb, col, a), max(acc.a, a));
    }
    return acc;
}

// GLSL's mod: x - y * floor(x / y) (WGSL's % truncates)
fn glsl_mod(x: f32, y: f32) -> f32 {
    return x - y * floor(x / y);
}
