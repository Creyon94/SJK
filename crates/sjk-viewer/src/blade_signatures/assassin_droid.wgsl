fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let y0 = L * 0.2;
    let y1 = L * 0.97;
    var fx: vec3<f32> = vec3<f32>(0.0);
    let red: vec3<f32> = vec3<f32>(1.0, 0.3, 0.1);
    fx += fxSparks(ro, rd, px, y0, y1, 4.0 + 10.0 * sw, 3.5, 0.7, 4.1, red);
    fx += fxShock(ro, rd, px, L * 0.55, 1.0 - cl, 7.0, red);
    return fx * uFx * part(0.0);
}
