// Assassin Droid: the burning core of an IG assassin droid as a blade. Dark armour plates sit along
// the blade and slide apart in turn to show its hot core; a targeting line sweeps up and down it.
// A swing opens every plate; a clash flashes the core.
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let scan = halo(b.y - (0.5 + 0.5 * sin(uTime * 0.9)) * uLength, 0.4);
    return g * (0.95 + 0.6 * scan + 0.6 * clamp(uClash, 0.0, 1.0));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c;
}

fn sig_solid(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    if uFx < 0.01 || b.y < 0.5 || b.y > uLength - 0.5 {
        return o;
    }
    let k = floor(b.y / 3.0);
    let f = fract(b.y / 3.0);
    let open = smoothstep(0.3, 0.7, sin(uTime * 1.3 + k * 1.7) * 0.5 + 0.5 + clamp(uSwing, 0.0, 1.0));
    let w = 0.75 - 0.5 * open;
    let gap = smoothstep(0.0, 0.08, f) * smoothstep(1.0, 0.92, f);
    let cov = fillD(abs(abs(b.x) - w) - 0.18, px) * gap * (1.0 - open * 0.85);
    let plate = vec3<f32>(0.12, 0.12, 0.14) * (0.7 + 0.3 * sign(b.x)) + vec3<f32>(0.6, 0.15, 0.05) * halo(abs(b.x) - w + 0.18, 0.05);
    return vec4(mix(o.rgb, plate, cov), max(o.a, cov));
}

