// Temple Mosaic: an old Jedi Temple's tiled floor as a blade. Small tiles of gold, teal and red
// with dark joints between them, each catching the light on its own now and then, and a warm glow
// round the blade. A clash flares it.
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let q = vec2(b.x * 3.0, b.y * 0.8);
    let id = floor(q);
    let f = fract(q);
    let h = h21(id);
    let tile = select((select(vec3<f32>(0.95, 0.4, 0.3), vec3<f32>(0.35, 0.8, 0.85), h < 0.66)), vec3<f32>(1.0, 0.75, 0.35), h < 0.33);
    let grout = smoothstep(0.0, 0.12, min(min(f.x, 1.0 - f.x), min(f.y, 1.0 - f.y)));
    let glint = pow(0.5 + 0.5 * sin(uTime * 1.5 + h * 40.0), 16.0);
    return recol(g, tile) * (0.55 + 0.45 * grout) * (1.0 + 1.2 * glint * part(0.0));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c;
}

// the effects, flat round the blade as Sol's are
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let y0 = L * 0.2;
    let y1 = L * 0.97;
    var fx: vec3<f32> = vec3<f32>(0.0);
    let warm: vec3<f32> = vec3<f32>(1.0, 0.75, 0.4);
    fx += fxAura(ro, rd, y0, y1, 2.0, warm) * 0.5;
    return fx * uFx * part(0.0);
}
