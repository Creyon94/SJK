// Dyson Sphere: a captive sun harnessed by a megastructure. The blade is a burning column of
// star-stuff, a white-hot core in boiling golden plasma. Round it hangs a lattice of thin energy
// hoops at five heights, each tilted differently and turning at its own speed like a vast
// harvesting machine; pulses of collected energy race round the hoops and up thin collector
// beams from the star to each hoop, and solar flares arc out of the star in loops of plasma that
// leap up to the hoops. A swing spins the whole structure up and throws more flares; a clash
// overloads it, every hoop blazing at once.
fn ds_top() -> f32 {
    return uLength * clamp(uAge / 0.45, 0.0, 1.0);
}

// hoop k: centre height, radius, tilt, how fast its tilt turns round
fn ds_hy(k: f32) -> f32 {
    return uLength * (0.14 + 0.18 * k) + 0.4 * sin(uTime * 0.5 + k * 1.7);
}

fn ds_hr(k: f32) -> f32 {
    return 2.2 + 2.8 * sin(3.1416 * (0.1 + 0.2 * k));
}

fn ds_tilt(k: f32) -> f32 {
    return 0.42 * sin(k * 2.3 + 0.6) + 0.12 * sin(uTime * 0.4 + k);
}

fn ds_prec(k: f32) -> f32 {
    return uTime * (0.25 + 0.12 * k) * (select(-1.0, 1.0, glsl_mod(k, 2.0) < 0.5)) * (1.0 + 1.5 * clamp(uSwing, 0.0, 1.0)) + k * 1.3;
}

// a point on hoop k at angle th (radians), with the hoop grown by g
fn ds_pt(k: f32, th: f32, g: f32) -> vec3<f32> {
    let tl = ds_tilt(k);
    let pr = ds_prec(k);
    let n = vec3(sin(tl) * cos(pr), cos(tl), sin(tl) * sin(pr));
    let u = normalize(cross(n, vec3<f32>(0.0, 0.0, 1.0)) + vec3<f32>(0.0, 0.0, 1.0e-4));
    let v = cross(n, u);
    return vec3(0.0, ds_hy(k), 0.0) + (u * cos(th) + v * sin(th)) * ds_hr(k) * g;
}

fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let top = ds_top();
    var s: f32;
    var tq: f32;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let gold: vec3<f32> = vec3<f32>(1.0, 0.72, 0.3);
    let white: vec3<f32> = vec3<f32>(1.0, 0.96, 0.86);
    // ---- the star column: a white-hot core in a glowing golden body
    let d = raySeg(ro, rd, vec3<f32>(0.0, -0.6, 0.0), vec3(0.0, max(top, -0.5), 0.0), &s);
    let y = mix(-0.6, top, s);
    let boil = 0.8 + 0.2 * sin(y * 1.1 - uTime * 5.0) + 0.15 * sin(y * 0.31 + uTime * 1.7);
    var light = white * exp(-pow(d / max(0.45, px), 2.0)) * 1.5 + gold * halo(d, 1.0) * 0.75 * boil + gold * halo(d, 2.8) * 0.16 * (1.0 + 0.6 * cl);
    var fx: vec3<f32> = vec3<f32>(0.0);
    // boiling plasma round the core: granules and tongues of flame licking up the column
    let m = marchSteps(ro, rd, 1.5, 0.0, max(top, 0.01), 16.0);
    if m.y > m.x {
        var t = m.x + m.z * h21(rd.xy * 517.0);
        for (var i = 0; i < 16; i++) {
            let p = ro + rd * t;
            let r = length(p.xz);
            let n1 = fbm3(vec2(p.x * 1.8 + p.z * 0.9, p.y * 0.55 - uTime * 2.2));
            let n2 = fbm3(vec2(p.z * 1.8 - p.x * 0.9 + 4.0, p.y * 0.55 - uTime * 1.7));
            let fl = smoothstep(0.35, 0.85, n1 * n2 * 2.2);
            let dens = fl * exp(-pow(max(r - 0.45, 0.0) / 0.5, 2.0)) * smoothstep(0.0, 1.0, p.y) * (1.0 - smoothstep(top - 1.5, top, p.y));
            light += mix(gold, white, exp(-r * 2.0)) * dens * m.z * 1.3;
            t += m.z;
        }
    }
    // ---- the hoops: thin rings of light, each with pulses of energy racing round it
    for (var k = 0; k < 5; k++) {
        let fk = f32(k);
        let hy = ds_hy(fk);
        let R = ds_hr(fk);
        let g = smoothstep(hy - 0.5, hy + 3.0, top);
        if g < 0.01 {
            continue;
        }
        let dc = rayPt(ro, rd, vec3(0.0, hy, 0.0), &tq);
        if dc > R * g + 1.2 {
            continue;
        }
        let flow = (select(-1.0, 1.0, glsl_mod(fk, 2.0) < 0.5)) * uTime * (2.0 + 2.5 * sw);
        var prev = ds_pt(fk, 0.0, g);
        var best: f32 = 1.0e3;
        var bth: f32 = 0.0;
        for (var i = 1; i <= 20; i++) {
            let th = f32(i) * 0.31416;
            let p = ds_pt(fk, th, g);
            let dh = raySeg(ro, rd, prev, p, &s);
            if dh < best {
                best = dh;
                bth = th - 0.31416 * (1.0 - s);
            }
            prev = p;
        }
        let pulse = 0.35 + 0.65 * pow(0.5 + 0.5 * sin(bth * 3.0 - flow * 2.0), 6.0) + 0.3 * pow(0.5 + 0.5 * sin(bth * 7.0 + flow * 1.3), 8.0);
        let hot = 1.0 + 2.0 * cl;
        fx += (white * halo(best, max(0.04, px)) * 1.4 * pulse + gold * halo(best, 0.22) * 0.45 * (0.5 + 0.5 * pulse) + gold * halo(best, 0.8) * 0.07) * g * hot;
        // collector beams: thin rays from the star out to the hoop, energy flowing out along them
        for (var j = 0; j < 3; j++) {
            let th = f32(j) * 2.0944 + fk * 0.7 + uTime * 0.3;
            let p = ds_pt(fk, th, g);
            let a = normalize(vec3(p.x, 0.0, p.z)) * 0.5 + vec3(0.0, p.y - 1.5, 0.0);
            let db = raySeg(ro, rd, a, p, &s);
            let fl = 0.08 + 0.92 * pow(0.5 + 0.5 * sin(s * 9.0 - uTime * (10.0 + 6.0 * sw) + fk + f32(j) * 2.0), 6.0);
            fx += (white * halo(db, max(0.03, px)) * 1.1 + gold * halo(db, 0.18) * 0.35) * fl * g * (1.0 - 0.5 * s) * hot;
        }
    }
    // ---- solar flares: loops of plasma leaping from the star up to a hoop and falling back
    for (var i = 0; i < 3; i++) {
        let fi = f32(i);
        let ph = uTime * (0.45 + 0.15 * fi) * (1.0 + 0.8 * sw) + h11(fi * 5.3);
        let cy = floor(ph);
        let f = fract(ph);
        var k = floor(h11(cy * 2.9 + fi) * 4.99);
        let hy = ds_hy(k);
        if hy > top - 1.0 {
            continue;
        }
        let th = 6.2832 * h11(cy * 1.7 + fi * 3.1);
        let b = ds_pt(k, th, 1.0);
        let a = vec3(0.0, hy - 2.5 - 2.0 * h11(cy * 3.3 + fi), 0.0) + normalize(vec3(b.x, 0.0, b.z)) * 0.45;
        let mid = (a + b) * 0.5 + normalize(vec3(b.x, 0.0, b.z)) * (1.2 + 1.0 * h11(cy + fi)) + vec3<f32>(0.0, -0.3, 0.0);
        let grow = smoothstep(0.0, 0.45, f);
        let life = 1.0 - smoothstep(0.65, 1.0, f);
        var prev = a;
        for (var j = 1; j <= 10; j++) {
            let u = f32(j) / 10.0;
            if u - 0.1 > grow {
                break;
            }
            let p = mix(mix(a, mid, u), mix(mid, b, u), u);
            let df = raySeg(ro, rd, prev, p, &s);
            let uu = u - 0.1 * (1.0 - s);
            let tipf = 1.0 - smoothstep(grow - 0.1, grow, uu);
            let knot = 0.7 + 0.3 * sin(uu * 20.0 - uTime * 14.0);
            fx += mix(white, gold, 0.4) * (halo(df, max(0.09, px)) * 1.6 * knot + halo(df, 0.45) * 0.45) * life * mix(1.0, tipf, step(grow, 0.99));
            prev = p;
        }
    }
    light += fx * uFx;
    return (1.0 - exp(-light * 1.1)) * 1.05;
}

