// Dyson Sphere: the blade is a star caged in a megastructure: a white-gold plasma core seen
// through a lattice of dark hexagonal panels along the whole blade. The panels slide open and shut
// in waves, light pouring through the gaps; on a swing every panel opens and the star blazes.
fn ds_d(b: vec2<f32>) -> f32 {
    return length(vec2(b.x, max(b.y - uLength, 0.0) + max(-b.y, 0.0)));
}

// hex cell coordinates of p: (cell centre offset, id)
fn ds_hex(p: vec2<f32>) -> vec4<f32> {
    let s: vec2<f32> = vec2<f32>(1.0, 1.732);
    let a = glsl_mod_vec2(p, s) - s * 0.5;
    let c = glsl_mod_vec2(p - s * 0.5, s) - s * 0.5;
    let g = select(c, a, dot(a, a) < dot(c, c));
    return vec4(g, p - g);
}

// how open the panel `id` is (0 shut, 1 open)
fn ds_open(id: vec2<f32>) -> f32 {
    let wave = sin(id.y * 0.35 - uTime * 1.3 + h21(id) * 2.0);
    return clamp(smoothstep(0.2, 0.9, wave) + uSwing * 1.5 + uClash, 0.0, 1.0);
}

fn dyson_sphere_glow0(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let d = ds_d(b);
    let star: vec3<f32> = vec3<f32>(1.0, 0.82, 0.45);
    let core = fillD(d - 0.35, px);
    let flare = fbm3(vec2(b.x * 3.0, b.y * 0.6 - uTime * 1.5));
    var light = mix(star, vec3<f32>(1.0, 0.98, 0.9), core) * (fillD(d - 0.8, px) * (0.7 + 0.5 * flare) + core * 0.6);
    let h = ds_hex(vec2(b.x * 1.6, b.y * 1.6));
    let open = ds_open(h.zw);
    let gap = smoothstep(0.42, 0.36, length(h.xy)) * open;
    light += star * halo(d - 0.8, 1.2) * (0.25 + 0.6 * open) * step(0.0, b.y);
    light += star * gap * fillD(d - 0.95, px) * 1.2;
    return light;
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return vec3<f32>(0.0);
}

// the panels: dark metal hexes with lit seams, sliding aside as they open
fn sig_solid(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let d = ds_d(b);
    if d > 1.0 || b.y < 0.0 {
        return o;
    }
    let h = ds_hex(vec2(b.x * 1.6, b.y * 1.6));
    let open = ds_open(h.zw);
    let rad = length(h.xy);
    let panel = fillD(rad - mix(0.47, 0.12, open), px * 1.6) * fillD(d - 0.95, px);
    let seam = smoothstep(0.06, 0.0, abs(rad - mix(0.47, 0.12, open))) * panel;
    let metal = mix(vec3<f32>(0.07, 0.06, 0.05), vec3<f32>(0.32, 0.27, 0.2), 0.5 + 0.5 * h.y * 3.0);
    let c = mix(metal, vec3<f32>(1.0, 0.8, 0.4), seam * 0.8);
    return vec4(mix(o.rgb, c, panel), max(o.a, panel * 0.95));
}

// ==== show (added) ====
// Dyson Sphere show: collector satellites orbit round the blade on tilted paths, each catching a
// thin beam of starlight from the blade; solar flares burst out through the open panel gaps as
// plasma jets that curl and fade, and a slow ring of hexagon panels turns round it. A swing makes
// every flare jet out; a clash blasts a hexagonal shockwave.
fn dsHex(p_in: vec2<f32>) -> f32 {
    var p = p_in;
    p = abs(p);
    return max(p.x * 0.866 + p.y * 0.5, p.y);
}

fn dyson_sphere_show(b: vec2<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let gold: vec3<f32> = vec3<f32>(1.0, 0.78, 0.35);
    let white: vec3<f32> = vec3<f32>(1.0, 0.95, 0.85);
    var light: vec3<f32> = vec3<f32>(0.0);
    for (var i = 0; i < 6; i++) {
        let fi = f32(i);
        let a = uTime * (0.5 + 0.2 * fi) + fi * 1.7;
        let R = 3.0 + 1.0 * h11(fi * 3.0);
        let yc = (0.15 + 0.13 * fi) * L;
        let p = vec2(R * sin(a), yc + R * 0.25 * cos(a));
        let front = 0.4 + 0.6 * step(0.0, cos(a));
        let hx = abs(dsHex((b - p) / 0.35) - 1.0) * 0.35;
        light += gold * (halo(hx, 0.03 + px) * 1.4 + fillD(dsHex((b - p) / 0.35) * 0.35 - 0.35, px) * 0.25) * front;
        let bp = vec2(0.0, p.y);
        light += white * halo(sdSeg(b, bp, p), 0.02 + px) * 0.5 * front * (0.6 + 0.4 * sin(uTime * 7.0 + fi));
    }
    for (var i = 0; i < 6; i++) {
        let fi = f32(i);
        let ph = uTime * (0.5 + 0.3 * h11(fi * 2.7)) + h11(fi * 6.1);
        let cy = floor(ph);
        let f = fract(ph);
        if h11(cy * 3.7 + fi) > 0.55 + 0.45 * sw {
            continue;
        }
        let s = select(1.0, -1.0, h11(cy * 1.9 + fi) < 0.5);
        let y0 = (0.1 + 0.8 * h11(cy * 2.3 + fi)) * L;
        let len = (2.5 + 3.5 * h11(cy + fi)) * smoothstep(0.0, 0.35, f);
        let u = (b.x * s - 0.5) / max(len, 0.01);
        if u < 0.0 || u > 1.0 {
            continue;
        }
        let curl = u * u * 2.0 * (h11(cy * 5.0 + fi) - 0.5) + 0.3 * sin(u * 8.0 - uTime * 12.0) * u;
        let dy = b.y - y0 - curl;
        let th = 0.12 + 0.3 * u;
        light += mix(white, vec3<f32>(1.0, 0.45, 0.1), u) * exp(-pow(dy / th, 2.0)) * (1.0 - u) * (1.0 - f) * 1.6;
    }
    for (var k = 0; k < 2; k++) {
        let yc = L * (0.3 + 0.4 * f32(k));
        let q = vec2(b.x, (b.y - yc) / 0.28);
        let r = length(q);
        let ang = atan2(q.y, q.x) + uTime * 0.4 * (select(-1.0, 1.0, k == 0));
        let cells = step(0.15, abs(fract(ang * 12.0 / 6.2832) - 0.5)) * smoothstep(0.35, 0.0, abs(r - 4.5));
        let behind = step(0.0, q.y);
        light += gold * cells * 0.35 * mix(1.0, 1.0 - exp(-pow(b.x / 0.5, 2.0)), behind);
    }
    if cl > 0.01 {
        let o = vec2(0.0, L * 0.6);
        let h = abs(dsHex((b - o) / (1.0 + 7.0 * (1.0 - cl))) - 1.0) * (1.0 + 7.0 * (1.0 - cl));
        light += white * halo(h, 0.15) * cl * 1.6;
    }
    let edge = 1.0 - smoothstep(8.5, 10.2, abs(b.x));
    light *= edge * (1.0 - smoothstep(L + 0.5, L + 3.5, b.y)) * smoothstep(-3.0, -0.5, b.y);
    return (1.0 - exp(-light * 1.15)) * 1.05;
}

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    return dyson_sphere_glow0(g, b, r, px) + dyson_sphere_show(b, min(px, 0.06));
}

// GLSL's mod: x - y * floor(x / y) (WGSL's % truncates)
fn glsl_mod_vec2(x: vec2<f32>, y: vec2<f32>) -> vec2<f32> {
    return x - y * floor(x / y);
}
