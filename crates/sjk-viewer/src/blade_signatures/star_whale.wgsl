// @room 8
// @palette {"corona.rim_cool":[0.04,0.30,0.45],"corona.rim_hot":[0.25,0.85,0.95],"corona.inner":[0.75,1.0,1.0],"core.white":[0.92,1.0,1.0],"core.fringe_cool":[0.20,0.70,0.95],"core.fringe_hot":[0.70,1.0,1.0],"light.color":[0.30,0.85,0.95],"trail":[0.35,0.88,0.95]}

// Star Whale: a thin aqua blade with a pod of whales made of stars swimming round it: a big humpback
// and two calves on their own wider, faster circles, bodies of deep-blue nebula packed with stars,
// starlit outlines, fins sweeping, flukes beating. Each trails rising bubbles; spray and mist droplets
// come off the blade; once a lap the big one blows a fountain of stars. A swing throws an arc of
// water off the blade; a clash makes the big whale breach outward in a splash of droplets.
const SW_R: f32 = 3.6;
const SW_T: f32 = 0.85;
const SW_PER: f32 = 12.0;

fn sw_a(dt: f32) -> f32 {
    return (uTime + dt - 5.9) * 6.28318 / SW_PER;
}

fn sw_ai(dt: f32, per: f32, ph: f32) -> f32 {
    return (uTime + dt - 5.9 + ph) * 6.28318 / per;
}

fn sw_yc() -> f32 {
    return uLength * 0.52 + uLength * 0.16 * sin(uTime * 0.09 + 1.0);
}

// projected position (xy) and depth (z) on the orbit at angle a
fn sw_pos(a: f32) -> vec3<f32> {
    return vec3(SW_R * sin(a), sw_yc() - SW_R * cos(a) * sin(SW_T), SW_R * cos(a) * cos(SW_T));
}

fn sw_posi(a: f32, R: f32, yo: f32) -> vec3<f32> {
    return vec3(R * sin(a), sw_yc() + yo - R * cos(a) * sin(SW_T), R * cos(a) * cos(SW_T));
}

fn sw_spout() -> f32 {
    return glsl_mod(uTime - 5.0, SW_PER);
}

// the whale's shape in its own frame (u forward, v toward its back), about 6 long: signed distance
fn sw_shape(q_in: vec2<f32>, fin: ptr<function, f32>, fluke: ptr<function, f32>) -> f32 {
    var q = q_in;
    let t = uTime;
    // the body wave: the tail stock and flukes beat up and down
    let tw = max(-q.x - 0.6, 0.0);
    q.y -= sin(t * 1.6) * 0.10 * tw * tw;
    let body = sdEll(q - vec2<f32>(0.55, 0.0), vec2<f32>(2.25, 0.68));
    // flatten the belly behind the jaw, a stout head
    let stock = sdSeg(q, vec2<f32>(-0.6, 0.05), vec2<f32>(-2.65, 0.12)) - mix(0.42, 0.10, clamp((-q.x - 0.6) / 2.0, 0.0, 1.0));
    let k: f32 = 0.35;
    let hb = clamp(0.5 + 0.5 * (stock - body) / k, 0.0, 1.0);
    var d = mix(stock, body, hb) - k * hb * (1.0 - hb);
    // the dorsal fin: a small hooked bump
    let dq = q - vec2<f32>(-1.05, 0.40);
    let dors = sdEll(rot(0.6) * dq, vec2<f32>(0.30, 0.13));
    d = min(d, dors);
    // the flukes: two swept lobes at the end of the stock, beating with it
    var fq = q - vec2<f32>(-2.75, 0.12);
    fq = rot(sin(t * 1.6 - 0.6) * 0.35) * fq;
    let l1 = sdEll(rot(0.55) * (fq - vec2<f32>(-0.25, 0.32)), vec2<f32>(0.48, 0.14));
    let l2 = sdEll(rot(-0.55) * (fq - vec2<f32>(-0.25, -0.32)), vec2<f32>(0.48, 0.14));
    (*fluke) = min(l1, l2);
    d = min(d, (*fluke));
    // the long pectoral fin, sweeping slowly
    var pq = q - vec2<f32>(1.0, -0.42);
    pq = rot(-2.2 + 0.25 * sin(t * 0.9)) * pq;
    (*fin) = sdEll(pq - vec2<f32>(0.85, 0.0), vec2(0.95, 0.15 - 0.05 * clamp(pq.x, 0.0, 1.8)));
    return min(d, (*fin));
}

fn sw_star(v: vec2<f32>, s: f32, px: f32) -> f32 {
    let d = length(v);
    return fillD(d - s * 0.35, px) + 0.7 * halo(d, s * 0.9) + 0.5 * (halo(abs(v.x), px + 0.015) * halo(abs(v.y), s * 2.0) + halo(abs(v.y), px + 0.015) * halo(abs(v.x), s * 2.0)) * step(0.15, s);
}

// the whale at b: rgb light, a cover; z its depth
fn sw_whale(b: vec2<f32>, px: f32, z: ptr<function, f32>, R_in: f32, S: f32, per: f32, ph: f32, yo: f32, big: f32) -> vec4<f32> {
    var R = R_in;
    let a = sw_ai(0.0, per, ph);
    R *= 1.0 + 0.35 * uClash * big;
    // the breach: the big one leaps outward
    let P = sw_posi(a, R, yo);
    (*z) = P.z;
    let tg = vec2(R * cos(a), R * sin(a) * sin(SW_T));
    let lam = length(tg) / R;
    let f = normalize(tg);
    var up = vec2(-f.y, f.x);
    let C = vec2(0.0, sw_yc() + yo);
    if dot(up, C - P.xy) < 0.0 {
        up = -up;
    }
    // its back toward the blade: a banked turn
    let q = b - P.xy;
    var w = vec2(dot(q, f) / lam, dot(q, up)) / S;
    w.y -= 0.06 * w.x * w.x;
    // bent round the turn
    if abs(w.x) > 4.5 || abs(w.y) > 2.6 {
        return vec4<f32>(0.0);
    }
    var fin: f32;
    var fluke: f32;
    let d = sw_shape(w, &fin, &fluke) * S;
    let inside = fillD(d, px);
    let t = uTime;
    // nebula fill: deep blue back, paler teal belly
    var neb = mix(vec3<f32>(0.20, 0.60, 0.85), vec3<f32>(0.08, 0.16, 0.55), smoothstep(-0.6, 0.6, w.y));
    neb *= 0.55 + 0.45 * fbm3(w * 1.8 + vec2(t * 0.2, 0.0));
    // packed with tiny stars
    let gp = w * 7.0;
    let gc = floor(gp);
    let st = fillD(length(fract(gp) - h22(gc)) - 0.10, px * 7.0 / S) * step(0.45, h21(gc)) * (0.5 + 0.5 * sin(t * 4.0 + gc.x * 3.1 + gc.y * 1.7));
    // throat grooves along the belly behind the jaw
    let belly = smoothstep(-0.05, -0.35, w.y) * smoothstep(0.3, 0.9, w.x) * smoothstep(2.6, 2.0, w.x);
    let grooves = halo(abs(fract(w.y * 7.0 + w.x * 0.6) - 0.5), 0.08) * belly;
    // the mouth line and the eye
    let mouth = halo(sdSeg(w, vec2<f32>(2.75, -0.02), vec2<f32>(1.45, -0.28)), 0.03 + px);
    var c = neb * inside * 0.75 + vec3<f32>(0.85, 0.95, 1.0) * st * inside * 1.2 + vec3<f32>(0.6, 0.9, 1.0) * grooves * inside * 0.6 + vec3<f32>(0.7, 0.95, 1.0) * mouth * 0.8;
    // the starlit outline and the bright fin edges
    c += vec3<f32>(0.65, 0.92, 1.0) * halo(abs(d), 0.035 + px) * 1.5 + vec3<f32>(0.4, 0.8, 1.0) * halo(max(d, 0.0), 0.22) * 0.45;
    // the key stars: snout, eye, dorsal, fin tip, flukes, blowhole
    var ks = sw_star(w - vec2<f32>(2.80, 0.05), 0.30, px / S) + sw_star(w - vec2<f32>(1.95, 0.10), 0.22, px / S) + sw_star(w - vec2<f32>(-1.25, 0.55), 0.20, px / S) + sw_star(w - vec2<f32>(-3.55, 0.75), 0.22, px / S) + sw_star(w - vec2<f32>(-3.55, -0.55), 0.22, px / S) + sw_star(w - vec2<f32>(1.25, 0.66), 0.16, px / S);
    let ft = vec2<f32>(1.0, -0.42) + rot(2.2 - 0.25 * sin(t * 0.9)) * vec2<f32>(1.75, 0.0);
    ks += sw_star(w - ft, 0.22, px / S);
    c += vec3<f32>(1.0, 0.98, 0.92) * ks * 1.3;
    // the spout: a fountain of stars from the blowhole once a lap
    let sp = sw_spout();
    if sp < 2.2 && big > 0.5 {
        for (var i = 0; i < 16; i++) {
            let fi = f32(i);
            let age = sp - h11(fi * 1.7) * 0.7;
            if age < 0.0 || age > 1.5 {
                continue;
            }
            let v0 = vec2((h11(fi * 3.1) - 0.5) * 1.4, 2.4 + 1.2 * h11(fi * 5.3));
            let sp2 = vec2<f32>(1.25, 0.66) + v0 * age + vec2(0.0, -2.2 * age * age);
            let k = 1.0 - age / 1.5;
            c += vec3<f32>(0.85, 0.97, 1.0) * (fillD(length(w - sp2) - 0.06 * k - 0.02, px / S) + halo(length(w - sp2), 0.15) * 0.6) * k * 1.6;
        }
    }
    let lit = mix(0.42, 1.0, smoothstep(-0.5, 0.5, (*z)));
    return vec4(c * lit, inside);
}

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let L = uLength;
    var z: f32;
    let wh = sw_whale(b, px, &z, SW_R, 1.3, SW_PER, 0.0, 0.0, 1.0);
    var z2: f32;
    var z3: f32;
    let c1 = sw_whale(b, px, &z2, 4.6, 0.78, 8.5, 3.0, 7.0, 0.0);
    let c2 = sw_whale(b, px, &z3, 5.0, 0.7, 7.0, 6.5, -8.0, 0.0);
    // the blade: thin aqua light with a few stars drifting inside
    let bd = length(vec2(b.x, max(b.y - L, 0.0) + max(-b.y, 0.0) * 4.0));
    var blade = vec3<f32>(0.25, 0.85, 0.95) * (halo(bd, 0.8) * 0.75 + halo(bd, 2.0) * 0.12) * smoothstep(-0.3, 0.2, b.y);
    let gp = vec2(b.x * 2.5, b.y * 1.2 - uTime * 0.4);
    let gc = floor(gp);
    blade += vec3<f32>(0.85, 1.0, 1.0) * fillD(length(fract(gp) - h22(gc)) - 0.05, px * 2.5) * step(0.82, h21(gc)) * (1.0 - smoothstep(0.5, 1.0, abs(b.x))) * step(0.0, b.y) * step(b.y, L);
    // the stardust wake left along its orbit
    var wake: vec3<f32> = vec3<f32>(0.0);
    for (var i = 1; i < 12; i++) {
        let fi = f32(i);
        var p = sw_pos(sw_a(-2.0 - fi * 0.18));
        let jit = (h22(vec2(fi, floor(uTime * 3.0))) - 0.5) * 0.5;
        var k = 1.0 - fi / 12.0;
        wake += vec3<f32>(0.7, 0.95, 1.0) * fillD(length(b - p.xy - jit) - 0.05 * k - 0.015, px) * k * mix(0.4, 1.0, smoothstep(-0.5, 0.5, p.z)) * 1.4;
    }
    // bubble trails rising behind each whale: small bright rings that wobble up and pop
    var water: vec3<f32> = vec3<f32>(0.0);
    for (var k = 0; k < 3; k++) {
        let fk = f32(k);
        let Rk = select((select(5.0, 4.6, k == 1)), SW_R, k == 0);
        let pk = select((select(7.0, 8.5, k == 1)), SW_PER, k == 0);
        let hk = select((select(6.5, 3.0, k == 1)), 0.0, k == 0);
        let yk = select((select(-8.0, 7.0, k == 1)), 0.0, k == 0);
        for (var j = 0; j < 5; j++) {
            let fj = f32(j);
            let age = fract(uTime * 0.6 + fj * 0.2 + fk * 0.37);
            var p = sw_posi(sw_ai(-age * 1.4 - 0.3, pk, hk), Rk, yk);
            let bp = p.xy + vec2(0.25 * sin(age * 12.0 + fj), age * 2.5);
            let rad = 0.08 + 0.12 * h11(fj + fk * 5.0) + 0.06 * age;
            let ring = abs(length(b - bp) - rad);
            water += vec3<f32>(0.7, 0.95, 1.0) * (halo(ring, 0.025 + px) + 0.6 * halo(length(b - bp - vec2<f32>(-0.3, 0.3) * rad), 0.03)) * (1.0 - age) * mix(0.45, 1.0, smoothstep(-0.5, 0.5, p.z));
        }
    }
    // spray and mist: droplets flicked off the blade, arcing and fading; more on swing
    for (var i = 0; i < 12; i++) {
        let fi = f32(i);
        let ph = uTime * (0.6 + 0.4 * h11(fi * 2.7)) + h11(fi * 5.9);
        let cy = floor(ph);
        let f = fract(ph);
        if h11(cy * 3.7 + fi) > 0.5 + 0.5 * uSwing {
            continue;
        }
        let s = select(1.0, -1.0, h11(cy * 1.3 + fi) < 0.5);
        let y0 = (0.1 + 0.85 * h11(cy * 2.1 + fi * 3.0)) * L;
        let v = vec2(s * (2.5 + 3.0 * h11(cy + fi * 7.0)), 1.0 + 2.0 * h11(cy * 5.0 + fi));
        var p = vec2(s * 0.3, y0) + v * f - vec2(0.0, 2.6 * f * f);
        let dd = length(b - p);
        water += vec3<f32>(0.75, 0.97, 1.0) * (fillD(dd - 0.07, px) + halo(dd, 0.25) * 0.35) * (1.0 - f) * 1.3;
        water += vec3<f32>(0.35, 0.8, 0.95) * halo(dd, 0.9) * (1.0 - f) * 0.06;
    }
    // swing: an arc of water thrown off the blade
    if uSwing > 0.02 {
        for (var i = 0; i < 18; i++) {
            let fi = f32(i);
            let u = fi / 17.0;
            var p = vec2(1.0 + 4.5 * sin(u * 3.14159) * uSwing, (0.15 + 0.85 * u) * L + 1.5 * sin(u * 3.14159));
            p += (vec2(h11(fi * 3.0), h11(fi * 7.0)) - 0.5) * 0.6;
            water += vec3<f32>(0.75, 0.97, 1.0) * (fillD(length(b - p) - 0.09, px) + halo(length(b - p), 0.3) * 0.3) * uSwing * 1.2;
        }
    }
    // clash: the breach splash, a crown of droplets thrown up round the big whale
    if uClash > 0.01 {
        let P = sw_posi(sw_ai(0.0, SW_PER, 0.0), SW_R * (1.0 + 0.35 * uClash), 0.0);
        let a = 1.0 - uClash;
        for (var i = 0; i < 14; i++) {
            let fi = f32(i);
            let an = fi * 0.449 + 0.3 * h11(fi);
            var p = P.xy + vec2(cos(an), sin(an)) * (0.8 + 4.5 * a) - vec2(0.0, 3.0 * a * a);
            water += vec3<f32>(0.8, 0.97, 1.0) * (fillD(length(b - p) - 0.1, px) + halo(length(b - p), 0.3) * 0.4) * uClash * 1.4;
        }
    }
    let front = smoothstep(-0.2, 0.3, z);
    let pod = wh.rgb + c1.rgb + c2.rgb;
    let cover = max(wh.a * front, max(c1.a * smoothstep(-0.2, 0.3, z2), c2.a * smoothstep(-0.2, 0.3, z3)));
    let edge = 1.0 - smoothstep(9.0, 10.5, abs(b.x));
    let outc = (blade * (1.0 - 0.55 * cover) + pod + wake + water) * edge * smoothstep(-4.0, -1.0, b.y);
    return (1.0 - exp(-outc * 1.1)) * 1.05;
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    var z: f32;
    let wh = sw_whale(b, px, &z, SW_R, 1.3, SW_PER, 0.0, 0.0, 1.0);
    let front = smoothstep(-0.2, 0.3, z);
    return vec3<f32>(0.88, 1.0, 1.0) * (1.0 - smoothstep(0.08, 0.35, abs(b.x))) * step(0.0, b.y) * (1.0 - smoothstep(uLength - 0.6, uLength, b.y)) * (1.0 - 0.85 * wh.a * front);
}

// GLSL's mod: x - y * floor(x / y) (WGSL's % truncates)
fn glsl_mod(x: f32, y: f32) -> f32 {
    return x - y * floor(x / y);
}
