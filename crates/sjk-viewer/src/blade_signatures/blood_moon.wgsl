    fx += fxMotes(ro, rd, px, y0, y1, 0.6, 1.8, 10.0, -0.05, 4.4, red) * 0.8 * part(0.0);
    fx += fxSmoke(ro, rd, y0, y1, 3.6, 2.0, 5.3, dark) * 1.2 * part(1.0);
