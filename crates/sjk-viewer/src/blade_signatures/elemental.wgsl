// Generated by scripts/blade_signatures.py from elemental.glsl: edit that file and run the
// script again.
// @room 8
// @solid 1
// @palette {"corona.rim_cool":[0.35,0.20,0.55],"corona.rim_hot":[0.90,0.60,0.50],"corona.inner":[1.0,0.92,0.85],"core.white":[1.0,0.98,0.95],"core.fringe_cool":[0.50,0.70,1.0],"core.fringe_hot":[1.0,0.65,0.35],"light.color":[0.95,0.75,0.60],"trail":[0.90,0.70,0.60]}

// Elemental: fire, ice, lightning and stone take the blade in turn, four seconds each. Each new ruler
// climbs from the hilt behind a bright seam, overrunning the last one
// while it reigns: a licking flame with rising embers, faceted ice with frost and snow glints, a
// violet core wrapped in crawling arcs, and dark granite split by glowing seams. Swings stoke
// whichever element rules; clashes flash it.
fn L_EL() -> f32 {
    return uLength;
}

const EL_P: f32 = 6.0;

// seconds each element rules (Creyon: change them more slowly)
fn el_u() -> f32 {
    return (uTime - 1.0) / EL_P;
}

fn el_cur() -> f32 {
    return glsl_mod(floor(el_u()), 4.0);
}

fn el_local() -> f32 {
    return fract(el_u()) * EL_P;
}

fn el_front() -> f32 {
    return -1.0 + (uLength + 4.0) * smoothstep(0.0, 1.3, el_local());
}

fn el_tone(k: f32) -> vec3<f32> {
    return select(select(select(vec3<f32>(1.0, 0.72, 0.30), vec3<f32>(0.75, 0.45, 1.0), k < 2.5), vec3<f32>(0.55, 0.88, 1.0), k < 1.5), vec3<f32>(1.0, 0.55, 0.15), k < 0.5);
}

// one element's light at b; s returns how much opaque stone covers it
fn el_draw(k: f32, b: vec2<f32>, px: f32, s: ptr<function, f32>) -> vec3<f32> {
    let t = uTime;
    let L = uLength;
    let ax = abs(b.x);
    let on = smoothstep(-0.2, 0.3, b.y) * (1.0 - smoothstep(L - 0.3, L + 0.6, b.y));
    let bd = length(vec2(b.x, max(b.y - L, 0.0) + max(-b.y, 0.0) * 4.0));
    let st = uSwing + uClash * 0.6;
    (*s) = 0.0;
    var c: vec3<f32> = vec3<f32>(0.0);
    if k < 0.5 {
        // FIRE: a licking flame body, white at the heart, embers rising off it
        let n = fbm3(vec2(b.x * 1.6, b.y * 0.45 - t * 3.2));
        let n2 = vn(vec2(b.x * 3.0, b.y * 1.2 - t * 6.0));
        let w = 0.62 + 0.45 * n + 0.2 * n2 + 0.3 * st;
        let fl = smoothstep(w, w - 0.55, ax) * on;
        let heat = smoothstep(w - 0.2, 0.0, ax);
        c = mix(vec3<f32>(0.85, 0.12, 0.02), vec3<f32>(1.0, 0.55, 0.08), smoothstep(0.0, 0.5, heat));
        c = mix(c, vec3<f32>(1.0, 0.95, 0.7), smoothstep(0.55, 0.95, heat)) * fl * 1.6;
        c += vec3<f32>(1.0, 0.35, 0.05) * halo(bd, 1.5) * 0.5 * on;
        for (var i = 0; i < 10; i++) {
            let fi = f32(i);
            let age = fract(t * 0.6 + h11(fi * 2.1));
            let y = glsl_mod(h11(fi * 7.7) * L + age * 7.0, L);
            let p = vec2((h11(fi * 3.3) - 0.5) * 1.6 + 0.5 * sin(t * 2.0 + fi) * age, y);
            c += vec3<f32>(1.0, 0.6, 0.15) * fillD(length(b - p) - 0.06, px) * (1.0 - age) * 1.8;
        }
    } else if k < 1.5 {
        // ICE: faceted crystal, bright facet edges, frost needles at the rim, snow glints
        var cell: vec2<f32>;
        let e = voro(vec2(b.x * 1.6, b.y * 0.45), &cell);
        let body = fillD(ax - 0.78, px) * on;
        let face = 0.55 + 0.45 * h21(cell);
        c = mix(vec3<f32>(0.25, 0.55, 0.95), vec3<f32>(0.85, 0.97, 1.0), face) * body * 0.75;
        c += vec3<f32>(0.9, 1.0, 1.0) * halo(e, 0.05) * body * 1.2;
        c += vec3<f32>(1.0) * fillD(ax - 0.2, px) * on * 0.8;
        // frost needles: short spikes along both edges
        let yy = b.y * 2.2;
        let id = floor(yy);
        let fy = fract(yy) - 0.5;
        let len = 0.2 + 0.35 * h11(id + step(0.0, b.x) * 31.0) + 0.3 * st;
        let sp = (ax - 0.78) / len;
        let needle = step(0.0, sp) * step(sp, 1.0) * step(abs(fy), 0.18 * (1.0 - sp));
        c += vec3<f32>(0.75, 0.95, 1.0) * needle * on * 0.9;
        c += vec3<f32>(0.5, 0.8, 1.0) * halo(bd, 1.6) * 0.45 * on;
        let gp = b * vec2<f32>(2.0, 1.0);
        let gc = floor(gp);
        let glint = fillD(length(fract(gp) - h22(gc)) - 0.05, px * 2.0) * step(0.7, h21(gc)) * (0.5 + 0.5 * sin(t * 5.0 + gc.x * 13.0 + gc.y * 7.0));
        c += vec3<f32>(1.0) * glint * (1.0 - smoothstep(1.2, 2.4, ax)) * on * 1.5;
    } else if k < 2.5 {
        // LIGHTNING: a violet-white core wrapped in jagged arcs that crawl and re-strike
        let tq = floor(t * 14.0);
        c = vec3<f32>(0.65, 0.45, 1.0) * halo(bd, 1.2) * 0.6 * on + vec3<f32>(0.9, 0.85, 1.0) * fillD(ax - 0.28, px) * on * 1.2;
        for (var i = 0; i < 3; i++) {
            let fi = f32(i);
            let j = b.y * 1.3 + tq * 0.37 + fi * 11.0;
            var x = (vn(vec2(j, fi * 5.0 + tq * 0.11)) - 0.5) * 1.5 + (vn(vec2(j * 4.0, fi + tq)) * 0.5 - 0.25) * 0.6;
            x *= 1.0 + 0.4 * st;
            let bolt = halo(abs(b.x - x), 0.04 + px) * 1.8 + halo(abs(b.x - x), 0.25) * 0.5;
            let live = step(0.25, h11(fi + tq * 0.71));
            c += vec3<f32>(0.85, 0.75, 1.0) * bolt * live * on;
        }
        let fl = 0.8 + 0.4 * h11(tq);
        c *= fl;
    } else {
        // STONE: dark granite, speckled, split by seams of glowing magma-gold
        let body = fillD(ax - 0.82, px) * on;
        var cell: vec2<f32>;
        let e = voro(vec2(b.x * 1.3, b.y * 0.38), &cell);
        let seam = halo(e, 0.06) * (0.7 + 0.6 * vn(vec2(b.y * 0.5 - t * 0.8, cell.x)));
        let pulse = 0.75 + 0.25 * sin(t * 3.0 + b.y * 0.3) + st;
        c = vec3<f32>(1.0, 0.65, 0.20) * seam * body * 1.6 * pulse + vec3<f32>(1.0, 0.55, 0.15) * halo(bd, 1.4) * 0.45 * on;
        (*s) = body * (1.0 - smoothstep(0.1, 0.5, seam));
        // a few grains of grit falling off
        for (var i = 0; i < 6; i++) {
            let fi = f32(i);
            let age = fract(t * 0.5 + h11(fi * 4.1));
            let p = vec2((select(1.0, -1.0, h11(fi * 1.9) < 0.5)) * (0.9 + age * 0.6), h11(fi * 6.3) * L - age * age * 6.0);
            c += vec3<f32>(0.8, 0.6, 0.4) * fillD(length(b - p) - 0.07, px) * (1.0 - age) * 0.8;
        }
    }
    return c;
}

fn el_stoneRgb(b: vec2<f32>) -> f32 {
    let g = floor(b * vec2<f32>(9.0, 7.0));
    return 0.16 + 0.10 * h21(g) + 0.08 * vn(b * vec2<f32>(2.0, 0.7));
}

// both rulers blended across the climbing front
fn el_all(b: vec2<f32>, px: f32, s: ptr<function, f32>) -> vec3<f32> {
    let cur = el_cur();
    let prev = glsl_mod(cur + 3.0, 4.0);
    let f = el_front();
    let m = smoothstep(f + 0.4, f - 0.4, b.y);
    var c: vec3<f32> = vec3<f32>(0.0);
    (*s) = 0.0;
    var s1: f32 = 0.0;
    var s2: f32 = 0.0;
    if m > 0.001 {
        c += el_draw(cur, b, px, &s1) * m;
    }
    if m < 0.999 {
        c += el_draw(prev, b, px, &s2) * (1.0 - m);
    }
    (*s) = s1 * m + s2 * (1.0 - m);
    // the front itself: a bright seam where one element overruns the other
    let L = uLength;
    let band = halo(abs(b.y - f), 0.35) * (1.0 - smoothstep(0.9, 1.6, abs(b.x))) * step(f, L + 1.0);
    c += mix(el_tone(cur), vec3<f32>(1.0), 0.4) * band * 1.5;
    // (no orb or gem on the tip: Creyon's rule, no orbs in the blade)
    return c;
}

fn elemental_glow0(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    var s: f32;
    let c = el_all(b, px, &s);
    let bd = length(vec2(b.x, max(b.y - uLength, 0.0) + max(-b.y, 0.0) * 4.0));
    return c + vec3<f32>(1.0) * uClash * halo(bd, 1.3) * 0.8 + g * 0.05;
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return vec3<f32>(0.0);
}

fn sig_solid(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    var s: f32;
    let c = el_all(b, px, &s);
    if s <= 0.001 {
        return o;
    }
    var rock = vec3(el_stoneRgb(b)) * vec3<f32>(1.0, 0.95, 0.9);
    let rim = smoothstep(0.55, 0.82, abs(b.x));
    rock *= 1.0 + 0.5 * rim;
    let rgb = rock + min(c, vec3<f32>(1.0)) * 0.6;
    return vec4(mix(o.rgb, rgb, s), max(o.a, s));
}

// ==== show (added) ====
// Elemental show: the ruling element throws its own effect off the blade: fire sheds embers and
// curling flame tongues, ice drifts six-armed snowflakes and frost shards, lightning forks bolts off
// to the sides, stone flings rock chips and dust. A swing throws more; a clash bursts the ruler's
// element out in a ring.
fn elemental_show(b: vec2<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let k = el_cur();
    let rise = 0.35 + 0.65 * smoothstep(0.3, 1.6, el_local());
    // the new ruler's show starts as it takes over
    let tone = el_tone(k);
    var light: vec3<f32> = vec3<f32>(0.0);
    for (var i = 0; i < 14; i++) {
        let fi = f32(i);
        let ph = uTime * (0.45 + 0.25 * h11(fi * 2.3)) + h11(fi * 6.7);
        let cy = floor(ph);
        let f = fract(ph);
        let s = select(1.0, -1.0, h11(cy * 3.1 + fi) < 0.5);
        let y0 = (0.08 + 0.85 * h11(cy * 1.7 + fi * 4.0)) * L;
        let fade = (1.0 - f) * smoothstep(0.0, 0.08, f);
        if k < 0.5 {
            // fire: embers rising, flame tongues
            let p = vec2(s * (0.6 + 3.5 * f) + 0.4 * sin(f * 9.0 + fi), y0 + 4.0 * f);
            light += mix(vec3<f32>(1.0, 0.9, 0.5), vec3<f32>(1.0, 0.3, 0.05), f) * (halo(length(b - p), 0.14) * 2.6 + halo(length(b - p), 0.5) * 0.4) * fade;
            let u = (b.x * s - 0.5) / 2.5;
            if u > 0.0 && u < 1.0 && i < 8 {
                let dy = b.y - y0 - 2.5 * u * u - 0.5 * sin(u * 8.0 - uTime * 10.0) * u;
                light += vec3<f32>(1.0, 0.5, 0.1) * exp(-pow(dy / (0.25 * (1.0 - u) + 0.04), 2.0)) * (1.0 - u) * fade * 1.2;
            }
        } else if k < 1.5 {
            // ice: snowflakes and frost shards
            let p = vec2(s * (0.8 + 5.0 * f), y0 - 2.0 * f + 0.5 * sin(f * 6.0 + fi));
            var q = b - p;
            q /= 1.6;
            let r = length(q);
            let a = atan2(q.y, q.x) + uTime * 0.8 + fi;
            let arm = halo(abs(sin(a * 3.0)) * r, 0.03) * step(r, 0.45) + halo(abs(sin(a * 3.0 + 1.57)) * r, 0.02) * step(r, 0.25) * step(0.12, r);
            light += vec3<f32>(0.75, 0.95, 1.0) * (arm * 1.4 + halo(r, 0.08)) * fade;
        } else if k < 2.5 {
            // lightning: forks jumping off the sides
            if i < 10 {
                let on = step(0.35, h11(floor(uTime * 8.0) + fi * 3.0));
                let u = (b.x * s - 0.4) / (3.0 + 3.0 * h11(cy + fi));
                if u > 0.0 && u < 1.0 {
                    let jag = (vn(vec2(u * 12.0, floor(uTime * 12.0) + fi)) - 0.5) * 1.4 * u + (vn(vec2(u * 40.0, floor(uTime * 12.0) + fi * 2.0)) - 0.5) * 0.3;
                    let dy = b.y - y0 - jag - u * 1.5 * (h11(cy * 5.0 + fi) - 0.5) * 2.0;
                    light += mix(vec3<f32>(1.0), vec3<f32>(0.75, 0.5, 1.0), u) * (exp(-pow(dy / 0.06, 2.0)) * 2.4 + halo(abs(dy), 0.4) * 0.35) * on * (1.0 - u * 0.5);
                }
            }
        } else {
            // stone: rock chips flung out, falling, dust
            let v = vec2(s * (3.0 + 3.0 * h11(cy + fi)), 2.0 * h11(cy * 2.0 + fi));
            let p = vec2(s * 0.5, y0) + v * f - vec2(0.0, 4.0 * f * f);
            var q = b - p;
            let an = uTime * 4.0 + fi;
            q = vec2(q.x * cos(an) - q.y * sin(an), q.x * sin(an) + q.y * cos(an));
            let rock = max(abs(q.x) + abs(q.y) * 0.6, abs(q.y)) - 0.38 - 0.12 * h11(fi);
            light += vec3<f32>(0.75, 0.55, 0.35) * (fillD(rock, px) * 1.0 + halo(abs(rock), 0.04 + px) * 1.4) * fade;
            light += vec3<f32>(0.6, 0.5, 0.4) * halo(length(b - p + v * 0.08), 0.5) * 0.15 * fade;
        }
    }
    light *= rise;
    // clash: the ruler's element bursts out in a ring
    if cl > 0.01 {
        let a = 1.0 - cl;
        let o = vec2(0.0, L * 0.6);
        light += tone * (halo(abs(length(b - o) - 1.0 - 6.5 * a), 0.14) * 1.5 + halo(length(b - o), 1.4) * pow(cl, 3.0)) * cl;
    }
    let edge = 1.0 - smoothstep(8.0, 9.8, abs(b.x));
    light *= edge * (1.0 - smoothstep(L + 0.5, L + 3.5, b.y)) * smoothstep(-3.0, -0.5, b.y);
    return (1.0 - exp(-light * 1.15)) * 1.05;
}

// ==== aura (round 7) ====
// Each element wraps the blade the way Sol's Storm blade wraps it in lightning: two strands
// winding round it and effects leaping 6 to 8 units off it. Fire: a flaming ribbon spiralling
// up, tongues licking out and sparks flung off. Ice: a chain of frost shards spiralling round,
// glinting, with cold mist and crystal spikes standing off the blade. Lightning: crackling arcs
// round the blade and great loops jumping out and back, struck anew many times a second.
// Stone: boulders with molten cracks orbiting in a helix, lava drips and dust. The next element
// takes over from the hilt behind the seam.
fn el_aura(k: f32, b: vec2<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    var light: vec3<f32> = vec3<f32>(0.0);
    let along = smoothstep(-0.5, 1.5, b.y) * (1.0 - smoothstep(L - 1.0, L + 2.0, b.y));
    if k < 0.5 {
        // fire: two flame ribbons spiralling up, tongues and sparks
        for (var j = 0; j < 2; j++) {
            let fj = f32(j);
            let h = helix(b.y, 2.4 + 0.6 * sin(b.y * 0.3 - t * 2.0), 1.1, -t * 0.55 + fj * 0.5);
            let d = abs(b.x - h.x);
            let flick = 0.6 + 0.6 * vn(vec2(b.y * 0.9 - t * 6.0, fj * 7.0));
            let front = 0.45 + 0.55 * smoothstep(-0.6, 0.6, h.y);
            light += mix(vec3<f32>(1.0, 0.35, 0.05), vec3<f32>(1.0, 0.85, 0.4), front) * (halo(d, 0.35 * flick) * 1.3 + halo(d, 1.1) * 0.25) * front * along;
        }
        for (var i = 0; i < 10; i++) {
            let fi = f32(i);
            let ph = t * (0.7 + 0.3 * h11(fi * 3.1)) + h11(fi * 7.7);
            let cy = floor(ph);
            let f = fract(ph);
            let s = select(1.0, -1.0, h11(cy + fi * 2.0) < 0.5);
            let y0 = (0.1 + 0.8 * h11(cy * 1.3 + fi)) * L;
            // a tongue licking out and up
            let u = (b.x * s - 1.0) / (4.0 + 3.0 * h11(cy + fi * 5.0));
            if u > 0.0 && u < 1.0 {
                let dy = b.y - y0 - 3.0 * u * u * f - 0.6 * sin(u * 9.0 - t * 12.0 + fi) * u;
                light += mix(vec3<f32>(1.0, 0.8, 0.3), vec3<f32>(1.0, 0.25, 0.02), u) * exp(-pow(dy / (0.45 * (1.0 - u) + 0.05), 2.0)) * (1.0 - u) * (1.0 - f) * smoothstep(0.0, 0.15, f) * 1.3;
            }
            // a spark flung far out
            let p = vec2(s * (1.0 + 7.0 * f), y0 + 5.0 * f - 3.0 * f * f);
            light += vec3<f32>(1.0, 0.7, 0.3) * halo(length(b - p), max(px, 0.06)) * 2.2 * (1.0 - f);
        }
    } else if k < 1.5 {
        // ice: frost shards on two spirals, glinting; crystal spikes off the blade; cold mist
        for (var j = 0; j < 2; j++) {
            let fj = f32(j);
            let ph = -t * 0.25 + fj * 0.5;
            for (var i = 0; i < 9; i++) {
                let fi = f32(i);
                let y = fract(fi / 9.0 + t * 0.035 + fj * 0.05) * (L + 2.0) - 1.0;
                let h = helix(y, 3.0, 0.9, ph);
                var q = b - vec2(h.x, y);
                q = rot(t * 1.5 + fi + fj * 3.0) * q;
                let sh = max(abs(q.x) * 1.6 + abs(q.y) * 0.55, abs(q.y) * 0.9) - 0.8 * (0.7 + 0.3 * h.y);
                let glint = pow(0.5 + 0.5 * sin(t * 5.0 + fi * 2.3 + fj), 8.0);
                light += vec3<f32>(0.6, 0.9, 1.0) * (fillD(sh, px) * 0.7 + halo(abs(sh), 0.05 + px) * 1.4) * (0.5 + 0.5 * h.y) * along + vec3<f32>(1.0) * halo(length(q), 0.12) * glint * 2.0 * along;
            }
        }
        for (var i = 0; i < 8; i++) {
            let fi = f32(i);
            let s = select(1.0, -1.0, glsl_mod(fi, 2.0) < 0.5);
            let y0 = (0.1 + 0.11 * fi) * L;
            let grow = 0.5 + 0.5 * sin(t * 0.8 + fi * 1.7);
            let len = (2.5 + 3.5 * h11(fi * 3.3)) * grow;
            let d = sdSeg(b, vec2(s * 0.6, y0), vec2(s * (0.6 + len), y0 + len * 0.55));
            light += vec3<f32>(0.75, 0.95, 1.0) * (halo(d, 0.05 + px) * 1.2 + halo(d, 0.4) * 0.25) * grow;
        }
        let mist = fbm3(vec2(b.x * 0.5 - t * 0.3, b.y * 0.3 - t * 0.5));
        light += vec3<f32>(0.45, 0.7, 1.0) * mist * mist * 0.35 * exp(-abs(b.x) / 3.0) * along;
    } else if k < 2.5 {
        // lightning: crackling arcs wound round the blade and big loops leaping off it
        for (var j = 0; j < 2; j++) {
            let fj = f32(j);
            let kk = floor(t * 14.0 + fj * 0.5);
            let jit = (vn(vec2(b.y * 1.7, kk * 3.1 + fj * 9.0)) - 0.5) * 1.6;
            let h = helix(b.y, 1.6 + 0.6 * vn(vec2(b.y * 0.5, kk)), 1.5, -t * 0.8 + fj * 0.5);
            let d = abs(b.x - h.x - jit);
            light += mix(vec3<f32>(0.7, 0.45, 1.0), vec3<f32>(1.0), 0.3) * (halo(d, max(px, 0.04)) * 1.5 + halo(d, 0.3) * 0.5) * (0.4 + 0.6 * smoothstep(-0.5, 0.5, h.y)) * along;
        }
        for (var i = 0; i < 6; i++) {
            let fi = f32(i);
            let y0 = (0.06 + 0.15 * fi) * L + 2.0 * h11(floor(t * 1.3 + fi));
            let s = select(1.0, -1.0, h11(floor(t * 2.0) + fi * 4.0) < 0.5);
            let on = step(0.3 - 0.3 * sw, h11(floor(t * 9.0) + fi * 1.9));
            light += arcLoop(b, y0, y0 + 3.0 + 3.0 * h11(fi * 5.1), s, 7.0 + 3.0 * h11(fi + floor(t * 3.0)), fi * 3.7, 9.0, vec3<f32>(0.7, 0.45, 1.0), px) * on;
        }
        for (var i = 0; i < 12; i++) {
            let fi = f32(i);
            let f = fract(t * 0.5 + h11(fi * 2.9));
            let p = vec2((h11(fi * 3.7) - 0.5) * 12.0, f * (L + 4.0) - 2.0);
            light += vec3<f32>(0.85, 0.7, 1.0) * halo(length(b - p), 0.08) * 1.5 * (0.5 + 0.5 * sin(t * 20.0 + fi));
        }
    } else {
        // stone: boulders with molten cracks on a helix round the blade, lava drips, dust
        for (var i = 0; i < 10; i++) {
            let fi = f32(i);
            let y = fract(fi / 10.0 + t * 0.03) * (L + 2.0) - 1.0;
            let h = helix(y, 3.8, 0.8, t * 0.12 + fi * 0.13);
            var q = rot(t * 0.7 * (h11(fi) - 0.5) + fi) * (b - vec2(h.x, y));
            let sz = (1.0 + 0.6 * h11(fi * 3.9)) * (0.75 + 0.25 * h.y);
            let rock = max(abs(q.x) + abs(q.y) * 0.55, abs(q.y) * 1.05) - sz + 0.08 * vn(q * 6.0 + fi);
            let crack = halo(abs(vn(q * 4.0 + fi * 3.0) - 0.5), 0.06) * step(rock, 0.0);
            let rc = vec3<f32>(0.32, 0.26, 0.22) * (0.6 + 0.4 * h.y) + vec3<f32>(1.0, 0.45, 0.1) * crack * 1.6;
            light += rc * fillD(rock, px) * along + vec3<f32>(1.0, 0.5, 0.15) * halo(abs(rock), 0.05 + px) * 0.6 * along;
        }
        for (var i = 0; i < 8; i++) {
            let fi = f32(i);
            let f = fract(t * 0.6 + h11(fi * 5.3));
            let s = select(1.0, -1.0, glsl_mod(fi, 2.0) < 0.5);
            let p = vec2(s * (0.7 + 0.8 * f), (0.2 + 0.09 * fi) * L - 6.0 * f * f);
            light += vec3<f32>(1.0, 0.45, 0.08) * (halo(length((b - p) * vec2<f32>(1.0, 0.6)), 0.14) * 2.0) * (1.0 - f);
        }
        let dust = fbm3(vec2(b.x * 0.6 + t * 0.2, b.y * 0.25));
        light += vec3<f32>(0.7, 0.55, 0.4) * dust * dust * 0.25 * exp(-abs(b.x) / 4.0) * along;
    }
    return light * (1.0 + 0.8 * sw);
}

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px_in: f32) -> vec3<f32> {
    var px = px_in;
    px = min(px, 0.06);
    let k = el_cur();
    // the aura of the ruler, the last one's fading as the new one takes over (from the hilt up)
    let take = smoothstep(0.0, 1.2, el_local());
    var aura = el_aura(k, b, px) * take + el_aura(glsl_mod(k + 3.0, 4.0), b, px) * (1.0 - take);
    let edge = 1.0 - smoothstep(8.5, 10.0, abs(b.x));
    aura *= edge * (1.0 - smoothstep(L_EL() + 1.0, L_EL() + 4.0, b.y)) * smoothstep(-2.5, -0.5, b.y);
    return elemental_glow0(g, b, r, px) + elemental_show(b, px) + (1.0 - exp(-aura * 1.2)) * 1.1;
}

// GLSL's mod: x - y * floor(x / y) (WGSL's % truncates)
fn glsl_mod(x: f32, y: f32) -> f32 {
    return x - y * floor(x / y);
}
