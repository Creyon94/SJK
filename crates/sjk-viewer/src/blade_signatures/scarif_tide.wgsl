// Scarif Tide: the turquoise seas of Scarif as a blade (round 16 rework, Creyon: it did not make
// sense). The blade is clear tropical water: a turquoise body with sunlit caustics, the bright web
// of light the sun throws through shallow water, rippling over it, and sparkles of sun on its
// surface. Round it, a column of sea water spirals up the blade in 3D like a waterspout, its edge
// catching the light, bubbles rise beside it wobbling as they go, and sea spray glitters off it,
// flung out on a swing. A clash sends a splash out.
const SC_SEA: vec3<f32> = vec3<f32>(0.15, 0.85, 0.85);

const SC_FOAM: vec3<f32> = vec3<f32>(0.85, 1.0, 1.0);

// the blade: shallow water lit by the sun, a moving web of caustics over turquoise and sparkles
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let l = lvl(g);
    let q = vec2(b.x * 3.0, b.y * 0.45);
    var cell: vec2<f32>;
    let w1 = voro(q + vec2(0.0, -uTime * 0.35) + 0.3 * vec2(sin(b.y * 0.3 + uTime), 0.0), &cell);
    let w2 = voro(q * 1.7 + vec2(3.1, -uTime * 0.5), &cell);
    let caust = pow(1.0 - smoothstep(0.0, 0.18, w1), 2.0) * 0.7 + pow(1.0 - smoothstep(0.0, 0.12, w2), 2.0) * 0.5;
    let sparkle = step(0.97, h21(floor(vec2(b.x * 16.0, b.y * 3.0)) + floor(uTime * 8.0) * 0.71)) * smoothstep(0.1, 0.4, abs(b.x));
    let c = SC_SEA * (0.75 + 0.2 * sin(b.y * 0.2 - uTime * 0.8)) + SC_FOAM * caust * 0.9 + vec3<f32>(1.0) * sparkle * 1.5;
    return l * c * (1.0 + 0.4 * clamp(uClash, 0.0, 1.0));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c;
}

// bubbles rising beside it, wobbling, each a thin bright ring with a glint, and sea spray (flat,
// facing the camera, as Sol's are)
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let y0 = L * 0.15;
    let y1 = L * 0.97;
    var fx: vec3<f32> = vec3<f32>(0.0);
    var ta: f32;
    if fxNear(ro, rd, y0, y1) < 5.0 {
        for (var i = 0; i < 12; i++) {
            let fi = f32(i);
            let q = fract(t * (0.12 + 0.08 * h11(fi * 2.3)) + h11(fi * 5.9));
            let side = select(1.0, -1.0, h11(fi * 3.7) < 0.5);
            let p = vec3(side * (0.9 + 1.6 * h11(fi * 1.3)) + 0.25 * sin(t * 3.0 + fi * 2.0), mix(y0, y1, q), 0.0);
            let R = 0.12 + 0.22 * h11(fi * 7.1);
            let d = rayPt(ro, rd, p, &ta);
            let ring = halo(abs(d - R), max(0.03, px));
            let glint = halo(length((ro + rd * ta - p).xy - vec2<f32>(-0.4, 0.4) * R), R * 0.3);
            fx += (SC_FOAM * ring * 0.9 + vec3<f32>(1.0) * glint * 1.2 + SC_SEA * halo(d, R * 1.5) * 0.15) * sin(3.1416 * q) * part(1.0);
        }
    }
    fx += fxSparks(ro, rd, px, y0, y1, 6.0 + 18.0 * sw, 3.0, 1.0, 6.1, SC_FOAM) * 0.8 * part(1.0);
    fx += fxMotes(ro, rd, px, y0, y1, 0.8, 3.0, 16.0, 0.05, 2.2, SC_FOAM) * 0.6 * part(1.0);
    if cl > 0.01 {
        fx += fxShock(ro, rd, px, L * 0.55, 1.0 - cl, 6.0, SC_SEA) * 1.2;
    }
    return fx * uFx;
}

// the waterspout: a sheet of sea water spiralling up round the blade, their leading edges
// catching the sun; they circle the blade, so they are drawn in true 3D (Sol's way)
fn sig_orbit(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    if part(0.0) < 0.5 {
        return vec3<f32>(0.0);
    }
    let L = uLength;
    let t = uTime;
    var s: f32;
    let y0 = L * 0.1;
    let y1 = L * 0.95;
    var acc: vec3<f32> = vec3<f32>(0.0);
    if fxNear(ro, rd, y0, y1) > 4.0 {
        return acc;
    }
    for (var j = 0; j < 1; j++) {
        let fj = f32(j);
        var best: f32 = 1.0e3;
        var bf: f32 = 0.0;
        var prev: vec3<f32> = vec3<f32>(0.0);
        for (var i = 0; i <= 26; i++) {
            let f = f32(i) / 26.0;
            let y = mix(y0, y1, f);
            let R = 1.3 + 0.9 * f + 0.15 * sin(f * 14.0 - t * 3.0 + fj * 3.0);
            let p = around(R, f * 1.6 - t * 0.3 + fj * 0.5, y);
            if i > 0 {
                let d = raySeg(ro, rd, prev, p, &s);
                if d < best {
                    best = d;
                    bf = (f32(i) - 1.0 + s) / 26.0;
                }
            }
            prev = p;
        }
        let ends = smoothstep(0.0, 0.08, bf) * (1.0 - smoothstep(0.85, 1.0, bf));
        let crest = pow(0.5 + 0.5 * sin(bf * 30.0 - t * 4.0 + fj * 2.0), 4.0);
        acc += (SC_FOAM * halo(best, max(0.04, px)) * (0.3 + 1.0 * crest) + SC_SEA * halo(best, 0.5) * 0.55 + SC_SEA * halo(best, 1.4) * 0.2) * ends;
    }
    return acc * uFx;
}
