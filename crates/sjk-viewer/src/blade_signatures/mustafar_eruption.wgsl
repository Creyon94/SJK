// Mustafar Eruption: the lava rivers of Mustafar as a blade. Lava flows down it in bright tongues
// that cool to dark glowing rock; embers fall off it and the air shimmers with heat. A swing
// stirs the flow; a clash bursts a ring of fire.
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let n = fbm3(vec2(b.x * 2.0, b.y * 0.3 + uTime * 0.5));
    let rock = smoothstep(0.45, 0.6, n);
    return g * mix(vec3<f32>(1.1), vec3<f32>(0.35, 0.15, 0.1), rock * 0.8);
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c;
}

// the effects, flat round the blade as Sol's are
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let y0 = L * 0.2;
    let y1 = L * 0.97;
    var fx: vec3<f32> = vec3<f32>(0.0);
    let fire: vec3<f32> = vec3<f32>(1.0, 0.45, 0.1);
    fx += fxSparks(ro, rd, px, y0, y1, 8.0 + 10.0 * sw, 4.0, 0.6, 7.7, fire);
    fx += fxShock(ro, rd, px, L * 0.55, 1.0 - cl, 8.0, fire);
    return fx * uFx * part(0.0);
}
