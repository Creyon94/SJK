// Mustafar Eruption: the lava rivers of Mustafar as a blade. Lava flows down it in bright tongues
// that cool to dark glowing rock; lava fountains spit sparks off it, dark ash smoke billows up,
// flakes of ash drift down, embers fall and the air shimmers with heat. A clash flares it.
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let n = fbm3(vec2(b.x * 2.0, b.y * 0.3 + uTime * 0.5));
    let rock = smoothstep(0.45, 0.6, n);
    return g * mix(vec3<f32>(1.1), vec3<f32>(0.35, 0.15, 0.1), rock * 0.8);
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c;
}

// the effects, flat round the blade as Sol's are
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let y0 = L * 0.2;
    let y1 = L * 0.97;
    var fx: vec3<f32> = vec3<f32>(0.0);
    let fire: vec3<f32> = vec3<f32>(1.0, 0.45, 0.1);
    fx += fxSparks(ro, rd, px, y0, y1, 10.0 + 10.0 * sw, 4.5, 0.6, 7.7, fire) * part(0.0);
    fx += fxSmoke(ro, rd, y0, y1, 3.8, 2.0, 1.4, vec3<f32>(0.3, 0.2, 0.18)) * 1.3 * part(1.0);
    fx += fxFlakes(ro, rd, px, y0, y1, 3.5, 12.0, 1.8, 0.2, 0.8, 1.5, 0.6, 3.6, vec3<f32>(0.5, 0.45, 0.42)) * part(2.0);
    // lava fountains: molten drops thrown up off the blade, falling back in arcs
    var lta: f32;
    if fxNear(ro, rd, y0, y1) < 6.0 {
        for (var i = 0; i < 12; i++) {
            let fi = f32(i);
            let cyc = t * 0.45 * (0.8 + 0.4 * h11(fi * 2.9)) + h11(fi * 7.7);
            let k = floor(cyc);
            let q = fract(cyc);
            let y = mix(y0, y1 - 6.0, h11(k * 3.1 + fi));
            let side = select(1.0, -1.0, h11(k * 5.3 + fi) < 0.5);
            let tt = q * 1.6;
            let p = vec3(side * (0.5 + 2.2 * tt), y + 6.0 * tt - 4.5 * tt * tt, 0.0);
            let d = rayPt(ro, rd, p, &lta);
            fx += mix(vec3<f32>(1.0, 0.85, 0.5), vec3<f32>(1.0, 0.4, 0.08), q) * (halo(d, max(0.12, px)) * 1.6 + halo(d, 0.5) * 0.3) * (1.0 - q) * part(0.0);
        }
