// @room 8
// @palette {"corona.rim_cool":[0.04,0.35,0.08],"corona.rim_hot":[0.35,1.0,0.35],"corona.inner":[0.8,1.0,0.75],"core.white":[0.92,1.0,0.9],"core.fringe_cool":[0.2,0.85,0.3],"core.fringe_hot":[0.7,1.0,0.6],"light.color":[0.3,1.0,0.35],"trail":[0.35,1.0,0.4]}

// Witchfire: the dark magick of a witch clan, as a blade. A thin pale-green blade with nine slim
// tendrils of green witchfire rooted at the hilt and wound close round it; every nine seconds, and
// whenever you swing, they fan open behind the blade like a cobra's hood, then wind back in. Green
// flames circle the blade, tongues of fire lick off its sides, ichor mist pours up off it and runes
// of the old magick burn in the air round it and fade. A clash bursts the fire out in a ring.
fn wf_fan() -> f32 {
    let p = glsl_mod(uTime - 9.6, 9.0);
    let show = smoothstep(0.0, 0.9, p) * (1.0 - smoothstep(2.8, 4.0, p));
    return clamp(max(show, uSwing * 1.5 + uClash * 0.5), 0.0, 1.0);
}

// one tail: rgb, cover; z its depth
fn wf_tail(b: vec2<f32>, i: f32, fan: f32, px: f32, z: ptr<function, f32>) -> vec4<f32> {
    let len = (19.0 + 14.0 * fract(i * 0.618 + 0.15)) * (1.0 - 0.18 * fan);
    let s = (b.y - 0.2) / len;
    (*z) = -1.0;
    if s < -0.02 || s > 1.03 {
        return vec4<f32>(0.0);
    }
    let sc = clamp(s, 0.0, 1.0);
    let t = uTime;
    // wound round the blade, close
    let a = i * 0.698 + t * 0.45 + 1.9 * sc + 0.25 * sin(t * 1.4 + i * 1.3 + sc * 4.0);
    let Rc = 0.95 * sin(min(sc * 2.2, 1.0) * 1.5708);
    let xc = Rc * sin(a);
    // fanned: each tail swings out to its own place in a fan behind the blade
    let spread = (i - 4.0) / 4.0;
    let xf = spread * 2.7 * pow(sc, 0.75) + 0.2 * sin(t * 2.0 + i + sc * 5.0) * sc;
    let x = mix(xc, xf, fan);
    (*z) = mix(cos(a), -0.4, fan);
    // the tail's body: slim at the root, bushy past the middle, a pointed tip
    var w = 0.05 + 0.27 * pow(sin(min(sc, 1.0) * 2.75), 0.8) * (1.0 - smoothstep(0.86, 1.0, sc) * 0.6);
    w *= 1.0 + 0.25 * fan;
    let dx = b.x - x;
    let fl = fbm3(vec2(dx * 3.0 + i * 5.0, b.y * 0.9 - t * 3.2));
    let e = abs(dx) - w * (0.65 + 0.55 * fl);
    let body = smoothstep(0.08, -0.05, e);
    // fur streaming toward the tip
    let fur = 0.65 + 0.35 * vn(vec2(dx / max(w, 0.05) * 2.5 + i * 3.0, b.y * 1.8 - t * 5.0));
    var c = mix(vec3<f32>(0.02, 0.18, 0.04), vec3<f32>(0.15, 0.85, 0.25), smoothstep(0.05, 0.55, sc));
    c = mix(c, vec3<f32>(0.55, 1.0, 0.45), smoothstep(0.55, 0.85, sc));
    c = mix(c, vec3<f32>(0.9, 1.0, 0.85), smoothstep(0.88, 0.98, sc + (fl - 0.5) * 0.08));
    c *= fur * (0.85 + 0.15 * sin(t * 12.0 + i * 2.1 + b.y));
    c += vec3<f32>(0.45, 1.0, 0.4) * halo(abs(e), 0.04) * 0.5;
    // a flickering rim
    let base = smoothstep(-0.02, 0.04, s);
    let lit = mix(0.45, 1.0, smoothstep(-0.4, 0.4, (*z)));
    return vec4(c * lit * 0.85, body * base);
}

// the nine, composited back to front without adding up to white
fn wf_all(b: vec2<f32>, px: f32) -> vec4<f32> {
    let fan = wf_fan();
    var col: vec3<f32> = vec3<f32>(0.0);
    var front: f32 = 0.0;
    var cov: f32 = 0.0;
    if abs(b.x) > 3.6 {
        return vec4<f32>(0.0);
    }
    for (var pass_ = 0; pass_ < 2; pass_++) {
        for (var k = 0; k < 9; k++) {
            var z: f32;
            let t = wf_tail(b, f32(k), fan, px, &z);
            if (pass_ == 0) != (z < 0.0) {
                continue;
            }
            col = mix(col, t.rgb, t.a);
            cov = max(cov, t.a);
            if pass_ == 1 {
                front = max(front, t.a);
            }
        }
    }
    return vec4(col, front);
}

fn witchfire_glow0(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let L = uLength;
    let t = wf_all(b, px);
    // the blade: thin lavender-white with a soft blue fox-fire glow
    let bd = length(vec2(b.x, max(b.y - L, 0.0) + max(-b.y, 0.0) * 4.0));
    let blade = vec3<f32>(0.25, 0.9, 0.3) * (halo(bd, 0.85) * 0.75 + halo(bd, 2.0) * 0.25) * smoothstep(-0.3, 0.2, b.y);
    // two onibi wisps circling the upper blade, teardrops trailing down
    var orbs: vec3<f32> = vec3<f32>(0.0);
    for (var i = 0; i < 2; i++) {
        let fi = f32(i);
        let a = uTime * 1.2 + fi * 3.14159;
        let c = vec2(1.6 * sin(a), L * 0.70 + fi * 5.0 + 1.0 * sin(uTime * 0.8 + fi));
        let lit = mix(0.35, 1.0, smoothstep(-0.3, 0.3, cos(a)));
        var q = b - c;
        q.y = select(q.y, q.y * 0.4, q.y < 0.0);
        let d = length(q);
        orbs += (vec3<f32>(0.35, 1.0, 0.35) * halo(d, 0.32) * 0.8 + vec3<f32>(0.85, 1.0, 0.8) * fillD(d - 0.11, px)) * lit;
    }
    return blade * (1.0 - 0.6 * t.a) + t.rgb + orbs + g * 0.05;
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    let t = wf_all(b, px);
    return vec3<f32>(0.85, 1.0, 0.8) * (1.0 - smoothstep(0.10, 0.38, abs(b.x))) * step(0.0, b.y) * (1.0 - smoothstep(uLength - 0.6, uLength, b.y)) * (1.0 - 0.8 * t.a);
}

// ==== show (added) ====
// Kitsune show: blue fox-fire flames (kitsune-bi) float round the blade, each a teardrop flame with
// a flickering tail, bobbing and circling; flame tongues lick off the blade's sides; cherry blossom
// petals swirl past. A swing throws the fox-fires out in a ring; a clash bursts nine flames outward.
fn witchfire_show(b: vec2<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let blue: vec3<f32> = vec3<f32>(0.2, 0.95, 0.3);
    let pale: vec3<f32> = vec3<f32>(0.75, 1.0, 0.65);
    let pink: vec3<f32> = vec3<f32>(0.35, 0.9, 0.5);
    var light: vec3<f32> = vec3<f32>(0.0);
    for (var i = 0; i < 7; i++) {
        let fi = f32(i);
        let a = uTime * (0.5 + 0.1 * fi) + fi * 0.9;
        let R = 3.0 + 1.2 * h11(fi * 3.0) + 2.5 * sw + 3.0 * cl;
        let p = vec2(R * sin(a), (0.12 + 0.12 * fi) * L + 0.8 * sin(uTime * 1.3 + fi));
        let front = 0.45 + 0.55 * step(0.0, cos(a));
        let q = b - p;
        let fl = length(vec2(q.x * 1.3, max(q.y, 0.0) * 0.45 + min(q.y, 0.0) * 1.2)) - 0.45 - 0.1 * sin(uTime * 14.0 + fi + q.y * 6.0);
        light += (pale * fillD(fl + 0.25, px) * 1.2 + blue * fillD(fl, px) * 0.7 + blue * halo(max(fl, 0.0), 0.4) * 0.5) * front;
    }
    for (var i = 0; i < 6; i++) {
        let fi = f32(i);
        let ph = uTime * (0.6 + 0.3 * h11(fi * 2.7)) + h11(fi * 6.1);
        let cy = floor(ph);
        let f = fract(ph);
        let s = select(1.0, -1.0, h11(cy * 3.3 + fi) < 0.5);
        let y0 = (0.1 + 0.8 * h11(cy * 1.9 + fi)) * L;
        let u = (b.x * s - 0.4) / 2.2;
        if u < 0.0 || u > 1.0 {
            continue;
        }
        let dy = b.y - y0 - 1.8 * u * u - 0.4 * sin(u * 7.0 - uTime * 12.0) * u;
        light += mix(pale, blue, u) * exp(-pow(dy / (0.25 * (1.0 - u) + 0.03), 2.0)) * (1.0 - u) * (1.0 - f) * smoothstep(0.0, 0.1, f) * 1.3;
    }
    // ichor mist pouring up off the blade and drifting away
    let mist = fbm3(vec2(b.x * 0.45 + 0.6 * sin(b.y * 0.2 + uTime * 0.7), b.y * 0.22 - uTime * 0.9));
    light += vec3<f32>(0.15, 0.7, 0.2) * mist * mist * 0.9 * exp(-abs(b.x) / 3.5) * smoothstep(-1.0, 3.0, b.y) * (1.0 - smoothstep(L - 2.0, L + 4.0, b.y));
    // runes of the old magick drawn in fire: rings with strokes, appearing round the blade and fading
    for (var i = 0; i < 4; i++) {
        let fi = f32(i);
        let ph = uTime * 0.35 + fi * 0.25;
        let cy = floor(ph);
        let f = fract(ph);
        let s = select(1.0, -1.0, glsl_mod(cy + fi, 2.0) < 0.5);
        let c = vec2(s * (4.0 + 2.0 * h11(cy + fi)), (0.15 + 0.7 * h11(cy * 2.3 + fi)) * L);
        let q = rot(uTime * 0.6 * s) * (b - c);
        let rr = length(q);
        let an = atan2(q.y, q.x);
        let ring = halo(abs(rr - 1.3), 0.05 + px) + halo(abs(rr - 0.95), 0.03 + px) * 0.6;
        let t0: vec2<f32> = vec2<f32>(0.0, 0.9);
        let t1: vec2<f32> = vec2<f32>(0.78, -0.45);
        let t2: vec2<f32> = vec2<f32>(-0.78, -0.45);
        let tri = min(min(sdSeg(q, t0, t1), sdSeg(q, t1, t2)), sdSeg(q, t2, t0));
        let stem = sdSeg(q, vec2<f32>(0.0, -0.45), vec2(0.0, 0.35 + 0.2 * h11(cy + fi * 3.0)));
        let strokes = halo(min(tri, stem), 0.035 + px);
        let vis = smoothstep(0.0, 0.2, f) * (1.0 - smoothstep(0.6, 1.0, f));
        light += pale * (ring + strokes * 0.8) * vis * 1.1;
    }
    if cl > 0.01 {
        let o = vec2(0.0, L * 0.6);
        light += blue * halo(abs(length(b - o) - 1.0 - 6.5 * (1.0 - cl)), 0.15) * cl * 1.5;
    }
    let edge = 1.0 - smoothstep(8.5, 10.2, abs(b.x));
    light *= edge * (1.0 - smoothstep(L + 0.5, L + 3.5, b.y)) * smoothstep(-3.0, -0.5, b.y);
    return (1.0 - exp(-light * 1.15)) * 1.05;
}

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    return witchfire_glow0(g, b, r, px) + witchfire_show(b, min(px, 0.06));
}

// GLSL's mod: x - y * floor(x / y) (WGSL's % truncates)
fn glsl_mod(x: f32, y: f32) -> f32 {
    return x - y * floor(x / y);
}
