// @full 1
// @room 6

// Reactor: Creyon's Blade Lab design, reworked in full. The in-game blade (plasma squeezed by marching
// magnetic rings, a 30 s heat cycle: calm, heating, overload, flash) plus its show off the blade:
// glowing magnetic loops arcing between the rings with plasma flowing along them, plasma venting
// from the rings as it heats, coolant sparks during overload, and a containment shockwave with
// debris at the flash. Swing: the loops stretch and vent harder; clash: a containment breach.
// drawn in game: LAB_THIN 1.35
fn o_sstep(a: f32, b: f32, x: f32) -> f32 {
    let t = clamp((x - a) / (b - a), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

fn o_hash(n: f32) -> f32 {
    return fract(sin(n) * 43758.5453);
}

fn o_hash2(p: vec2<f32>) -> f32 {
    return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);
}

fn o_noise(p: vec2<f32>) -> f32 {
    let i = floor(p);
    var f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(o_hash2(i), o_hash2(i + vec2<f32>(1.0, 0.0)), f.x), mix(o_hash2(i + vec2<f32>(0.0, 1.0)), o_hash2(i + vec2<f32>(1.0)), f.x), f.y);
}

fn o_fbm(p_in: vec2<f32>) -> f32 {
    var p = p_in;
    var s: f32 = 0.0;
    var a: f32 = 0.5;
    for (var i = 0; i < 4; i++) {
        s += a * o_noise(p);
        p *= 2.03;
        a *= 0.5;
    }
    return s;
}

fn o_hsv(h: f32, s: f32, v: f32) -> vec3<f32> {
    let k = clamp(abs(glsl_mod_vec3_float(h * 6.0 + vec3<f32>(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0, vec3(0.0), vec3(1.0));
    return v * mix(vec3<f32>(1.0), k, s);
}

fn o_seg(x: f32, y: f32, L: f32) -> f32 {
    return length(vec2(max(0.0, max(-x, x - L)), y));
}

fn o_saber(g: vec3<f32>, c: vec3<f32>, d: f32, cr: f32, k: f32) -> vec3<f32> {
    let core = o_sstep(cr, cr * 0.35, d);
    let glow_ = exp(-d * k) * 0.55 + exp(-d * k * 0.3) * 0.16;
    return c * core + g * glow_ * (1.0 - core * 0.6);
}

fn o_fx(x: f32, y: f32, L: f32, d: f32, t: f32) -> vec3<f32> {
    let cyc = fract(t / 30.0) * 30.0;
    let cooling = 1.0 - o_sstep(26.0, 30.0, cyc);
    let hx = o_sstep(16.0, 22.0, cyc) * cooling;
    let hy = o_sstep(21.6, 22.4, cyc) * (1.0 - o_sstep(25.6, 26.2, cyc));
    let hz = exp(-max(cyc - 26.0, 0.0) * 4.0) * step(26.0, cyc);
    let N: f32 = 5.0;
    let sp: f32 = 0.1;
    let strobe = hy * (0.5 + 0.5 * step(0.5, fract(t * 2.0)));
    let throb = 1.0 + (0.08 + 0.25 * hx) * sin(t * 5.0);
    let ph = x / max(L, 0.001) * N - t * sp * N;
    let fr_ = fract(ph);
    let r = (0.008 + 0.012 * pow(sin(3.14159 * fr_), 2.0)) * (1.0 + 0.35 * hy) * throb;
    let calm: vec3<f32> = vec3<f32>(0.3, 0.7, 1.0);
    let pc = mix(mix(calm, vec3<f32>(1.0, 0.45, 0.12), hx), vec3<f32>(1.0, 0.18, 0.06), hy);
    let dd = length(vec2(max(0.0, max(-x, x - L)), max(0.0, abs(y) - r * 0.45)));
    let plasma = o_saber(pc * (1.0 + strobe * 0.6), mix(vec3<f32>(1.0), pc, 0.35), dd, r * 0.9, 30.0);
    var rings: f32 = 0.0;
    for (var k = 0; k < 5; k++) {
        let xr = fract((f32(k) + t * sp * N) / N) * L;
        let rr: f32 = 0.026;
        let ay = min(abs(y) / rr, 1.0);
        let arc = xr + 0.004 * sqrt(1.0 - ay * ay);
        rings += exp(-abs(x - arc) * 700.0) * (0.35 + 0.9 * pow(ay, 6.0)) * step(abs(y), rr);
    }
    let rc = mix(mix(vec3<f32>(0.6, 0.95, 1.0), vec3<f32>(1.0, 0.6, 0.3), hx), vec3<f32>(1.0, 0.3, 0.15), hy);
    let flash = vec3<f32>(1.0, 0.95, 0.9) * hz * (exp(-d * 30.0) * 1.5 + exp(-d * 8.0) * 0.4);
    let core = plasma + rc * rings * step(0.0, x) * step(x, L) * (1.0 + strobe) + flash;
    var field: f32 = 0.0;
    for (var i = 0; i < 2; i++) {
        let fi = f32(i);
        let p2 = x * 52.0 - t * 3.0 + fi * 3.14159;
        let yc = 0.017 * sin(p2);
        field += exp(-abs(y - yc) / 0.0012) * (0.25 + 0.75 * (0.5 + 0.5 * cos(p2)));
    }
    field *= step(0.02, x) * step(x, L - 0.02) * (0.35 + 0.65 * hx + 0.5 * hy);
    let fc = mix(vec3<f32>(0.5, 0.85, 1.0), vec3<f32>(1.0, 0.55, 0.25), hx);
    var arcs: f32 = 0.0;
    for (var k = 0; k < 5; k++) {
        let x0 = fract((f32(k) + t * sp * N) / N) * L;
        let x1 = x0 + L / N;
        let cy = floor(t * 7.0 + f32(k) * 1.7);
        let on = step(0.55 - 0.5 * hx, o_hash(cy * 3.1 + f32(k)));
        let side = select(1.0, -1.0, o_hash(cy + f32(k) * 5.0) < 0.5);
        let u = clamp((x - x0) / max(x1 - x0, 0.001), 0.0, 1.0);
        let jag = (o_noise(vec2(x * 300.0, cy)) - 0.5) * 0.008;
        let yc = side * (0.02 + 0.006 * sin(u * 3.14159)) + jag;
        arcs += exp(-abs(y - yc) / 0.0009) * step(x0, x) * step(x, x1) * on;
    }
    arcs *= hx * step(x, L);
    let coil = exp(-length(vec2(x, y) - vec2<f32>(0.03, 0.0)) * 60.0) * (0.6 + 0.4 * sin(t * 6.0));
    return core + fc * field * 0.55 + vec3<f32>(0.85, 0.9, 1.0) * arcs * 0.9 + mix(vec3<f32>(0.4, 0.8, 1.0), vec3<f32>(1.0, 0.5, 0.2), hx) * coil;
}

// the reactor's show off the blade (SJK units)
fn rc_show(b: vec2<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let t = uTime;
    let cyc = fract(t / 30.0) * 30.0;
    let cooling = 1.0 - o_sstep(26.0, 30.0, cyc);
    let hx = o_sstep(16.0, 22.0, cyc) * cooling;
    let hy = o_sstep(21.6, 22.4, cyc) * (1.0 - o_sstep(25.6, 26.2, cyc));
    let hz = exp(-max(cyc - 26.0, 0.0) * 1.6) * step(26.0, cyc);
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let heat = max(hx, cl);
    let calm: vec3<f32> = vec3<f32>(0.3, 0.7, 1.0);
    let hot: vec3<f32> = vec3<f32>(1.0, 0.45, 0.12);
    let crit: vec3<f32> = vec3<f32>(1.0, 0.18, 0.06);
    let pc = mix(mix(calm, hot, hx), crit, hy);
    let N: f32 = 5.0;
    let sp: f32 = 0.1;
    var light: vec3<f32> = vec3<f32>(0.0);
    let side = sign(b.x + 1.0e-5);
    let ax = abs(b.x);
    // magnetic loops: a glowing arch between each pair of rings on both sides, plasma beads flowing along
    for (var k = 0; k < 5; k++) {
        let fk = f32(k);
        let y0 = fract((fk + t * sp * N) / N) * L;
        let y1 = y0 + L / N;
        if y1 > L || y0 < 1.5 {
            continue;
        }
        let mid = (y0 + y1) * 0.5;
        let hw = (y1 - y0) * 0.5;
        let H = (2.2 + 1.6 * hx + 2.0 * sw + 2.5 * cl) * (0.85 + 0.15 * sin(t * 3.0 + fk * 1.7 + side));
        // ellipse arch: (dy/hw)^2 + (x/H)^2 = 1, outside x > 0.5
        let q = vec2((b.y - mid) / hw, (ax - 0.4) / H);
        let e = length(q);
        let dd = abs(e - 1.0) * min(hw, H) * 0.8 + 1.0e3 * step(ax, 0.4);
        let pulse = 0.55 + 0.45 * sin(atan2(q.y, q.x) * 3.0 - t * 6.0 + fk);
        light += pc * (exp(-pow(dd / 0.06, 2.0)) * 0.9 + halo(dd, 0.35) * 0.18) * pulse * (0.45 + 0.55 * hx + 0.6 * sw);
        // plasma beads riding the arch
        for (var j = 0; j < 2; j++) {
            let a = fract(t * 0.45 + f32(j) * 0.5 + fk * 0.23) * 3.14159;
            let pp = vec2(0.4 + H * sin(a), mid - hw * cos(a));
            light += mix(pc, vec3<f32>(1.0), 0.5) * halo(length(vec2(ax, b.y) - pp), 0.13) * 1.4;
        }
    }
    // venting: plasma jets squirting out of the rings, curling and fading (more as it heats)
    for (var k = 0; k < 6; k++) {
        let fk = f32(k);
        let ph = t * 0.7 + h11(fk * 3.3);
        let cy = floor(ph);
        let f = fract(ph);
        if h11(cy * 2.7 + fk) > 0.25 + 0.6 * heat + 0.4 * sw {
            continue;
        }
        let ry = fract((floor(h11(cy + fk * 5.0) * 5.0) + t * sp * N) / N) * L;
        let s = select(1.0, -1.0, h11(cy * 4.9 + fk) < 0.5);
        let len = (2.5 + 3.5 * h11(cy * 1.1 + fk)) * (1.0 + 0.6 * sw) * smoothstep(0.0, 0.4, f);
        let xs = b.x * s - 0.4;
        let u = clamp(xs / len, 0.0, 1.0);
        let curl = (h11(cy * 6.0 + fk) - 0.5) * 2.5 * u * u + sin(u * 9.0 - t * 20.0) * 0.12 * u;
        let dy = b.y - ry - curl;
        let th = 0.08 + 0.35 * u;
        let jet = exp(-pow(dy / th, 2.0)) * step(0.0, xs) * (1.0 - smoothstep(len * 0.7, len, xs)) * (1.0 - f);
        light += mix(vec3<f32>(1.0), pc, smoothstep(0.0, 0.4, u)) * jet * (1.1 - 0.6 * u);
    }
    // overload: coolant sparks spraying off the whole blade
    let spr = max(hy, cl * 0.8);
    if spr > 0.01 {
        for (var k = 0; k < 10; k++) {
            let fk = f32(k);
            let ph = t * 1.8 + h11(fk * 7.0);
            let cy = floor(ph);
            let f = fract(ph);
            let y = h11(cy * 3.0 + fk) * L;
            let s = select(1.0, -1.0, h11(cy + fk * 2.0) < 0.5);
            let dir = normalize(vec2(s, (h11(cy * 5.0 + fk) - 0.5) * 1.2));
            let o = vec2(0.0, y);
            let p = o + dir * f * 7.0;
            light += vec3<f32>(1.0, 0.9, 0.7) * halo(sdSeg(b, o + dir * max(f * 7.0 - 1.2, 0.0), p), 0.05) * (1.0 - f) * spr * 1.6;
        }
    }
    // the flash: a containment shockwave ring and debris; a clash does the same at the strike point
    let sh = max(hz, cl);
    if sh > 0.01 {
        let a = select((1.0 - cl), (cyc - 26.0) / 1.5, hz > cl);
        let o = vec2(0.0, select(L * 0.6, L * 0.5, hz > cl));
        let ring = abs(length((b - o) * vec2<f32>(1.0, 0.55)) - 1.0 - 8.0 * a);
        light += mix(vec3<f32>(1.0, 0.95, 0.9), pc, 0.4) * (halo(ring, 0.15) * 1.6 + halo(ring, 0.7) * 0.3) * sh * (1.0 - smoothstep(0.7, 1.0, a));
        for (var k = 0; k < 8; k++) {
            let fk = f32(k);
            let an = fk * 0.785 + 0.4 * h11(fk);
            let p = o + vec2(cos(an), sin(an)) * (1.0 + 7.0 * a);
            light += vec3<f32>(1.0, 0.7, 0.4) * halo(length(b - p), 0.18) * sh * 1.4;
        }
    }
    let edge = 1.0 - smoothstep(6.5, 8.8, ax);
    return light * edge * smoothstep(-0.5, 1.0, b.y) * (1.0 - smoothstep(L + 0.5, L + 4.0, b.y));
}

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let S: f32 = 1.08 / 40.0;
    let x = b.y * S;
    let y = b.x * S * 1.35;
    let L = uLength * S;
    let d = o_seg(x, y, L);
    let c = o_fx(x, y, L, d, uTime);
    let R: f32 = 0.1;
    let e = 1.0 - o_sstep(R * 0.45, R * 0.98, max(d, abs(y)));
    let show = rc_show(b, min(px, 0.06));
    return (max(c, vec3<f32>(0.0)) * e + (1.0 - exp(-show * 1.2)) * 1.05) * clamp(uIgn * 1.5, 0.0, 1.0);
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return vec3<f32>(0.0);
}

// GLSL's mod: x - y * floor(x / y) (WGSL's % truncates)
fn glsl_mod_vec3_float(x: vec3<f32>, y: f32) -> vec3<f32> {
    return x - y * floor(x / y);
}
