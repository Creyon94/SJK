// Ilum Aurora Storm: the polar sky of Ilum, the kyber world, as a blade. A pale-green blade under
// curtains of aurora that hang round it in 3D: tall ribbons of green fading up to magenta, waving
// slowly and rippling as light runs along them; snow crystals glitter as they whirl round it and
// kyber glints flash in the cold. Every twelve seconds a storm surge sweeps up the blade and the
// curtains flare and spread wide. A swing makes the curtains ripple; a clash flashes them all.
fn ia_top() -> f32 {
    return uLength * clamp(uAge / 0.45, 0.0, 1.0);
}

fn ia_surge() -> f32 {
    let p = glsl_mod(uTime - 4.0, 12.0);
    return smoothstep(0.0, 1.0, p) * (1.0 - smoothstep(3.0, 5.0, p));
}

fn r8_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let t = uTime;
    let top = ia_top();
    var s: f32;
    var ta: f32;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let green: vec3<f32> = vec3<f32>(0.25, 1.0, 0.55);
    let mag: vec3<f32> = vec3<f32>(0.95, 0.3, 0.75);
    var col: vec3<f32> = vec3<f32>(0.0);
    if top < 0.5 {
        return col;
    }
    let su = ia_surge();
    // aurora curtains round the blade (round 12, Creyon: "something seems off"): soft folded
    // sheets of light with a brighter lower edge, rippling, green fading up to magenta; no hard
    // bars. Round 19 (Creyon: from above they were a flat picture following the camera): each
    // hangs on a cylinder round the blade in three dimensions, seen where the ray crosses it
    for (var k = 0; k < 3; k++) {
        let fk = f32(k);
        let Rk = 1.6 + 1.0 * fk;
        let a = dot(rd.xz, rd.xz);
        let b = dot(ro.xz, rd.xz);
        let cc = dot(ro.xz, ro.xz) - Rk * Rk;
        var hh = b * b - a * cc;
        if a < 1.0e-6 || hh <= 0.0 {
            continue;
        }
        hh = sqrt(hh);
        for (var e = 0; e < 2; e++) {
            let tc = select((-b + hh) / a, (-b - hh) / a, e == 0);
            if tc <= 0.0 {
                continue;
            }
            let q = ro + rd * tc;
            let ang = atan2(q.x, q.z);
            // the curtain covers part of the way round, its ends fading, and turns slowly
            var cover = 0.5 + 0.5 * sin(ang * 1.0 + t * 0.12 * (fk + 1.0) + fk * 2.1);
            cover = smoothstep(0.25, 0.75, cover);
            let xs = ang * Rk;
            let yb = uLength * (0.22 + 0.22 * fk) + 1.2 * sin(xs * 0.6 + t * 0.5 + fk * 2.0);
            if yb > top {
                continue;
            }
            let h = q.y - yb;
            let H = 6.0 + 2.0 * su;
            let band = smoothstep(-0.4, 0.8, h) * (1.0 - smoothstep(0.35 * H, H, h));
            let folds = 0.75 + 0.25 * sin(xs * 4.0 + 2.0 * sin(xs * 1.3 + t * 0.6 + fk) + fk * 3.0);
            let run = 0.65 + 0.35 * sin(h * 1.4 - t * 2.0 + xs * 0.8);
            // a sheet seen edge on is thicker
            let nn = normalize(vec3(q.x, 0.0, q.z));
            // seen edge on, a curtain fades (no hard line at its silhouette)
            let thick = smoothstep(0.05, 0.45, abs(dot(nn, rd))) * 1.1;
            let c = mix(green, mag, smoothstep(0.25 * H, H, h));
            col += c * band * cover * folds * run * 0.32 * thick * (select(0.7, 1.0, e == 0)) * (1.0 + 0.8 * su + 1.2 * cl);
        }
    }
    // snow crystals whirling round it
    for (var i = 0; i < 26; i++) {
        let fi = f32(i);
        let r = 0.9 + 3.6 * h11(fi * 3.3);
        let p = around(r, h11(fi * 7.7) + t * (0.2 + 0.2 * h11(fi)), glsl_mod(h11(fi * 5.9) * (top + 2.0) - t * (0.8 + 0.8 * h11(fi * 2.4)), top + 2.0) - 1.0);
        let d = rayPt(ro, rd, p, &ta);
        let gl = pow(0.5 + 0.5 * sin(t * 6.0 + fi * 3.1), 8.0);
        col += vec3<f32>(0.9, 1.0, 1.0) * halo(d, max(0.04, px)) * (0.8 + 1.6 * gl);
    }
    // kyber glints flashing in the cold
    for (var i = 0; i < 4; i++) {
        let fi = f32(i);
        var k = floor(t * 0.8 + fi * 0.25);
        let p = around(0.6 + 1.5 * h11(k * 2.1 + fi), h11(k * 3.7 + fi), (0.1 + 0.8 * h11(k * 5.3 + fi)) * top);
        let f = fract(t * 0.8 + fi * 0.25);
        let d = rayPt(ro, rd, p, &ta);
        col += vec3<f32>(0.85, 1.0, 0.95) * (halo(d, 0.08 + px) * 3.0 + halo(d, 0.5) * 0.4) * exp(-f * 5.0);
    }
    return col * uFx;
}

// the blade: Sol's glow and core from the file, a storm surge of light sweeping up it
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let p = glsl_mod(uTime - 4.0, 12.0);
    let sweep = halo(b.y - p * 14.0 + 2.0, 3.0) * step(p, 3.5);
    return g * (0.9 + 0.1 * sin(b.y * 0.5 - uTime * 1.5) + 1.2 * sweep + 0.5 * clamp(uClash, 0.0, 1.0));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c;
}

