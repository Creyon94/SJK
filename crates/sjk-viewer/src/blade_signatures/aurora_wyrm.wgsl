// Ilum Aurora Storm: the polar sky of Ilum, the kyber world, as a blade. A pale-green blade under
// curtains of aurora that hang round it in 3D: tall ribbons of green fading up to magenta, waving
// slowly and rippling as light runs along them; snow crystals glitter as they whirl round it and
// kyber glints flash in the cold. Every twelve seconds a storm surge sweeps up the blade and the
// curtains flare and spread wide. A swing makes the curtains ripple; a clash flashes them all.
fn ia_top() -> f32 {
    return uLength * clamp(uAge / 0.45, 0.0, 1.0);
}

fn ia_surge() -> f32 {
    let p = glsl_mod(uTime - 4.0, 12.0);
    return smoothstep(0.0, 1.0, p) * (1.0 - smoothstep(3.0, 5.0, p));
}

fn r8_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let t = uTime;
    let top = ia_top();
    var s: f32;
    var ta: f32;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let green: vec3<f32> = vec3<f32>(0.25, 1.0, 0.55);
    let mag: vec3<f32> = vec3<f32>(0.95, 0.3, 0.75);
    var col: vec3<f32> = vec3<f32>(0.0);
    if top < 0.5 {
        return col;
    }
    let su = ia_surge();
    // aurora curtains: each a band of tall rays standing on an arc round the blade
    for (var k = 0; k < 3; k++) {
        let fk = f32(k);
        let R = (2.2 + 0.9 * fk) * (1.0 + 0.4 * su);
        let y0 = uLength * (0.15 + 0.22 * fk);
        let H = 7.0 + 3.0 * su;
        let a0 = fk * 0.33 + t * 0.02 * (select(-1.0, 1.0, glsl_mod(fk, 2.0) < 0.5));
        for (var j = 0; j < 9; j++) {
            let u = f32(j) / 8.0;
            let a = a0 + u * 0.35;
            let wav = 0.25 * sin(u * 7.0 + t * (0.8 + 1.5 * sw) + fk * 2.0);
            let base = around(R + wav, a, y0 + 0.6 * sin(u * 5.0 + t * 0.5));
            if base.y > top {
                continue;
            }
            let tip = base + vec3(0.0, H * (0.6 + 0.4 * sin(u * 9.0 + fk + t * 0.7)), 0.0);
            let d = raySeg(ro, rd, base, tip, &s);
            let run = 0.5 + 0.5 * sin(s * 8.0 - t * 3.0 + u * 6.0);
            let edge = sin(3.1416 * u);
            let c = mix(green, mag, smoothstep(0.35, 1.0, s));
            col += c * (halo(d, 0.22) * 1.4 + halo(d, 0.7) * 0.35) * (0.4 + 0.6 * run) * (1.0 - s) * (0.3 + 0.7 * edge) * (1.0 + 1.2 * su + 1.5 * cl);
        }
    }
    // snow crystals whirling round it
    for (var i = 0; i < 26; i++) {
        let fi = f32(i);
        let r = 0.9 + 3.6 * h11(fi * 3.3);
        let p = around(r, h11(fi * 7.7) + t * (0.2 + 0.2 * h11(fi)) * (1.0 + sw), glsl_mod(h11(fi * 5.9) * (top + 2.0) - t * (0.8 + 0.8 * h11(fi * 2.4)), top + 2.0) - 1.0);
        let d = rayPt(ro, rd, p, &ta);
        let gl = pow(0.5 + 0.5 * sin(t * 6.0 + fi * 3.1), 8.0);
        col += vec3<f32>(0.9, 1.0, 1.0) * halo(d, max(0.04, px)) * (0.8 + 1.6 * gl);
    }
    // kyber glints flashing in the cold
    for (var i = 0; i < 4; i++) {
        let fi = f32(i);
        var k = floor(t * 0.8 + fi * 0.25);
        let p = around(0.6 + 1.5 * h11(k * 2.1 + fi), h11(k * 3.7 + fi), (0.1 + 0.8 * h11(k * 5.3 + fi)) * top);
        let f = fract(t * 0.8 + fi * 0.25);
        let d = rayPt(ro, rd, p, &ta);
        col += vec3<f32>(0.85, 1.0, 0.95) * (halo(d, 0.08 + px) * 3.0 + halo(d, 0.5) * 0.4) * exp(-f * 5.0);
    }
    return col * uFx;
}

// the blade: Sol's glow and core from the file, a storm surge of light sweeping up it
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let p = glsl_mod(uTime - 4.0, 12.0);
    let sweep = halo(b.y - p * 14.0 + 2.0, 3.0) * step(p, 3.5);
    return g * (0.9 + 0.1 * sin(b.y * 0.5 - uTime * 1.5) + 1.2 * sweep + 0.5 * clamp(uClash, 0.0, 1.0));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c;
}

// ---- round 9: the big effects layer ----
// Creyon's round 9: every mythical dramatic, with big effects all round it in 3D (lab.glsl fx*).
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let col = r8_vol(ro, rd, px);
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let y0 = L * 0.2;
    let y1 = L * 0.97;
    var fx: vec3<f32> = vec3<f32>(0.0);
    let green: vec3<f32> = vec3<f32>(0.3, 1.0, 0.6);
    let mag: vec3<f32> = vec3<f32>(0.85, 0.35, 1.0);
    let ice: vec3<f32> = vec3<f32>(0.75, 0.95, 1.0);
    fx += fxArcs(ro, rd, px, y0, y1, 5.0 + 3.0 * sw, 5.0, 1.3 + 1.5 * sw, 1.9, green);
    fx += fxRays(ro, rd, px, y0, y1, 10.0, 7.0, 0.5, 7.7, mix(green, mag, 0.35));
    fx += fxCoils(ro, rd, px, y0, y1, 2.0, 0.8, 0.25, 3.0, mix(green, mag, 0.5 + 0.5 * sin(t * 0.4)));
    fx += fxMotes(ro, rd, px, y0, y1, 1.0, 6.0, 34.0, 0.07, 4.1, ice);
    fx += fxAura(ro, rd, y0, y1, 3.0, green) * 0.9;
    fx += fxShock(ro, rd, px, L * 0.6, 1.0 - cl, 9.0, green) * 1.5;
    return col + fx * uFx;
}
