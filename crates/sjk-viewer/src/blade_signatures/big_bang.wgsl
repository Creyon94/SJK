// Big Bang: a thin white-gold blade holding a young universe. Each ignition starts as one blinding
// point at the hilt that bursts: a fireball races up the blade, cools from white through gold to
// ember red, and condenses into a glowing cosmic web strung with tiny spinning galaxies that keep
// streaming up and away, growing and reddening as space expands. A clash sets off a small new bang.
const BB_K: f32 = 40.0;
const BB_C: f32 = 8.0;
const BB_O: f32 = 0.9;

// log map scale, offset, origin height
// when the fireball front passed height y (seconds of uAge)
fn bb_pass(y: f32) -> f32 {
    return 0.6 + 1.5 * pow(max(y - BB_O, 0.0) / 44.0, 1.4);
}

fn bb_heat(T: f32) -> vec3<f32> {
    var a = mix(vec3<f32>(0.30, 0.02, 0.10), vec3<f32>(1.0, 0.30, 0.06), smoothstep(0.0, 0.35, T));
    a = mix(a, vec3<f32>(1.0, 0.78, 0.35), smoothstep(0.3, 0.65, T));
    return mix(a, vec3<f32>(1.0, 0.98, 0.95), smoothstep(0.65, 1.0, T));
}

// the expanding universe: space flows up from the origin (log map), features grow with height
fn bb_cosmos(b: vec2<f32>, px: f32) -> vec4<f32> {
    let yc = max(b.y - BB_O, -0.5) + BB_C;
    let flow = uTime * 1.1;
    let P = vec2(BB_K * b.x / yc, BB_K * log(yc) - flow) / 3.2;
    // web cells of 3.2 P units
    let ppx = px * BB_K / yc / 3.2;
    // a pixel in cell units
    var cell: vec2<f32>;
    let e = voro(P, &cell);
    let wfil = max(0.05, ppx * 1.2);
    let fil = halo(e, wfil) * (0.05 / wfil) * (0.55 + 0.45 * vn(P * 3.0 + 4.0));
    let knot = halo(e, wfil * 3.0) * smoothstep(0.55, 0.85, vn(P * 1.7));
    // a galaxy in this cell: a tilted two-armed spiral spinning slowly
    let cc = cell + h22(cell);
    let gh = h21(cell + 3.7);
    var lq = P - cc;
    lq = rot(gh * 6.28) * lq;
    lq.y /= mix(0.35, 0.9, h21(cell + 8.1));
    let d = length(lq) / 0.24;
    let ang = atan2(lq.y, lq.x);
    let arms = pow(0.5 + 0.5 * cos(2.0 * ang - 5.0 * log(d + 0.06) + uTime * (0.6 + gh)), 3.0);
    var gal = (arms * smoothstep(1.0, 0.25, d) * 0.9 + halo(d, 0.18) * 2.2 + halo(d, 0.6) * 0.25) * step(0.35, gh);
    gal *= mix(0.25, 1.0, smoothstep(1.5, 4.0, 0.24 / max(ppx, 1.0e-4)));
    // dimmer dots when tiny
    var gcol = mix(vec3<f32>(0.55, 0.75, 1.0), vec3<f32>(1.0, 0.85, 0.6), h21(cell + 1.3));
    gcol = mix(gcol, vec3<f32>(1.0, 0.55, 0.8), step(0.8, h21(cell + 5.5)));
    return vec4(vec3<f32>(0.85, 0.45, 1.0) * fil * 0.9 + vec3<f32>(1.0, 0.8, 0.55) * knot * 0.5 + gcol * gal, fil);
}

fn big_bang_glow0(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let a = uAge;
    let L = uLength;
    let O = vec2(0.0, BB_O);
    let h = clamp(b.y / max(L, 1.0), 0.0, 1.0);
    let ax = abs(b.x);
    let inB = (1.0 - smoothstep(0.8, 1.05, ax)) * smoothstep(-0.2, 0.3, b.y) * (1.0 - smoothstep(L - 0.2, L + 0.9, b.y));
    let tipD = length(vec2(b.x, max(b.y - L, 0.0)));
    let glowD = length(vec2(b.x, max(b.y - L, 0.0) + max(-b.y, 0.0) * 3.0));
    let since = a - bb_pass(b.y);
    let reached = smoothstep(-0.05, 0.05, since);
    // the steady universe: cosmic web + galaxies, hot blue-white near the origin, redshifted toward the tip
    let cz = bb_cosmos(b, px);
    let born = smoothstep(1.0, 3.5, since);
    let tint = mix(vec3<f32>(0.75, 0.85, 1.0), vec3<f32>(1.0, 0.55, 0.35), smoothstep(0.1, 1.0, h));
    let space = vec3<f32>(0.16, 0.05, 0.30) * 0.9 + vec3<f32>(0.9, 0.35, 0.25) * 0.25 * vn(vec2(b.x * 1.5, b.y * 0.4 - uTime * 0.3));
    let cosm = (space + cz.rgb * tint * 1.3) * inB * born;
    // the slow first light: a mottled glow left behind by the fireball, cooling
    let T = exp(-max(since, 0.0) * 0.85);
    let mott = 0.7 + 0.6 * fbm3(vec2(b.x * 2.0, b.y * 0.6 - a * 2.0));
    let fire = bb_heat(T) * T * 1.8 * mott * inB * reached;
    // the burst front: a white shell racing up the blade
    let front = halo(abs(since), 0.09) * step(0.55, a) * (1.0 - smoothstep(1.9, 2.4, a));
    let shell = vec3<f32>(1.0, 0.95, 0.85) * front * (1.0 - smoothstep(0.9, 1.6, ax)) * 2.4;
    // the singularity: a point that swells, then bursts
    let pre = smoothstep(0.0, 0.55, a) * (1.0 - smoothstep(0.55, 0.62, a));
    let burst = exp(-max(a - 0.55, 0.0) * 5.0) * step(0.55, a);
    let dO = length(b - O);
    let point = vec3<f32>(1.0, 0.97, 0.9) * (fillD(dO - 0.12 * pre, px) * pre * 3.0 + halo(dO, 0.25 + 0.2 * pre) * pre * 2.0 + (halo(abs(b.x), px + 0.03) * halo(abs(b.y - O.y), 1.6) + halo(abs(b.y - O.y), px + 0.03) * halo(abs(b.x), 1.2)) * pre * 1.5 + halo(dO, 0.6 + 3.0 * (1.0 - burst)) * burst * 2.5);
    // a clash sets off a small bang at the hilt: a flash and a ring running up
    let cr = (1.0 - uClash) * 16.0;
    let rebang = vec3<f32>(1.0, 0.9, 0.75) * (halo(dO, 0.8) * uClash * 2.0 + halo(abs(b.y - O.y - cr), 0.5) * inB * uClash * 1.5);
    // a heartbeat of the expansion: a soft gold wave rolling up every few seconds
    let wave = halo(abs(fract(log(max(b.y - BB_O, 0.0) + BB_C) * 1.4 - uTime * 0.22) - 0.5), 0.06) * inB * born * 0.35;
    // the outer glow: deep violet space light, warm near the body
    let outer = (vec3<f32>(1.0, 0.6, 0.35) * halo(glowD, 0.9) * 0.35 + vec3<f32>(0.45, 0.15, 0.6) * halo(glowD, 2.0) * 0.35) * smoothstep(-0.3, 0.2, b.y) * mix(born, 1.0, reached * T);
    return outer + cosm + fire + shell + point + rebang + vec3<f32>(1.0, 0.8, 0.5) * wave + g * 0.08 * born;
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    let since = uAge - bb_pass(b.y);
    let on = smoothstep(0.0, 0.5, since);
    let h = clamp(b.y / max(uLength, 1.0), 0.0, 1.0);
    let thin = 1.0 - smoothstep(0.12, 0.45, abs(b.x));
    let col = mix(vec3<f32>(0.95, 0.97, 1.0), vec3<f32>(1.0, 0.82, 0.6), h);
    return col * thin * on * (0.85 + 0.25 * uClash) * (1.0 - smoothstep(uLength - 0.6, uLength + 0.2, b.y));
}

// ==== show (added) ====
// Big Bang show: the young universe keeps expanding off the blade: shells of light ripple outward,
// tiny spiral galaxies and star clusters are flung away and spin as they drift, cosmic dust swirls
// out in arcs, and supernovae pop in the dark. A swing throws a wave of galaxies; a clash is a new
// bang: a white flash, a ring and a shower of stars.
fn big_bang_show(b: vec2<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let gold: vec3<f32> = vec3<f32>(1.0, 0.8, 0.5);
    let blue: vec3<f32> = vec3<f32>(0.55, 0.7, 1.0);
    var light: vec3<f32> = vec3<f32>(0.0);
    for (var j = 0; j < 3; j++) {
        let f = fract(uTime * 0.22 + f32(j) / 3.0);
        let o = vec2(0.0, L * (0.3 + 0.2 * f32(j)));
        let ring = abs(length((b - o) * vec2<f32>(1.0, 0.75)) - 0.8 - 8.0 * f);
        light += mix(vec3<f32>(1.0, 0.95, 0.85), blue, f) * halo(ring, 0.06 + 0.15 * f) * (1.0 - f) * 0.9;
    }
    for (var i = 0; i < 8; i++) {
        let fi = f32(i);
        let ph = uTime * (0.15 + 0.08 * h11(fi * 2.3)) + h11(fi * 6.9);
        let cy = floor(ph);
        let f = fract(ph);
        let an = 6.2832 * h11(cy * 3.1 + fi);
        let p = vec2(0.0, (0.15 + 0.7 * h11(cy * 1.3 + fi)) * L) + vec2(cos(an) * 1.2, sin(an) * 0.8) * (0.6 + 8.0 * f);
        let q = b - p;
        let r = length(q);
        let a = atan2(q.y, q.x);
        let rad = 0.4 + 0.7 * smoothstep(0.0, 0.5, f);
        let arms = 0.5 + 0.5 * cos(2.0 * (a - log(max(r, 0.02)) * 2.5 - uTime * 1.5 * sign(h11(fi) - 0.5)));
        let gc = mix(gold, blue, h11(cy + fi * 3.0));
        let fade = smoothstep(0.0, 0.1, f) * (1.0 - smoothstep(0.7, 1.0, f));
        light += (gc * arms * smoothstep(rad, rad * 0.15, r) * 1.1 + vec3<f32>(1.0) * halo(r, 0.08) * 1.6) * fade;
    }
    for (var i = 0; i < 10; i++) {
        let fi = f32(i);
        let f = fract(uTime * 0.3 + fi / 10.0);
        let a0 = fi * 0.628;
        let a = a0 + f * 2.5;
        let p = vec2(0.0, L * 0.5) + vec2(cos(a), sin(a) * 1.6) * (1.0 + 7.0 * f);
        light += mix(gold, vec3<f32>(0.8, 0.5, 0.9), f) * halo(length(b - p), 0.18) * 0.6 * (1.0 - f);
    }
    for (var i = 0; i < 3; i++) {
        let fi = f32(i);
        let ph = uTime * 0.4 + h11(fi * 4.4);
        let cy = floor(ph);
        let f = fract(ph);
        var c = vec2((h11(cy + fi) - 0.5) * 14.0, (0.1 + 0.8 * h11(cy * 2.0 + fi)) * L);
        c.x += sign(c.x) * 2.0;
        let k = exp(-f * 6.0);
        let q = b - c;
        let r = length(q);
        let a = atan2(q.y, q.x);
        let spk = pow(abs(cos(a * 2.0)), 40.0) * exp(-r / (1.5 * k + 0.1));
        light += vec3<f32>(1.0, 0.95, 0.9) * (halo(r, 0.15 + 0.4 * k) * 2.0 * k + spk * 2.0 * k);
    }
    if cl > 0.01 {
        let a = 1.0 - cl;
        let o = vec2(0.0, L * 0.6);
        light += vec3<f32>(1.0) * halo(length(b - o), 2.0) * pow(cl, 3.0) * 2.0 + gold * halo(abs(length(b - o) - 1.0 - 8.0 * a), 0.15) * cl * 1.5;
        for (var i = 0; i < 12; i++) {
            let fi = f32(i);
            let an = fi * 0.5236;
            light += vec3<f32>(1.0, 0.95, 0.85) * halo(length(b - o - vec2(cos(an), sin(an)) * (1.0 + 7.0 * (1.0 - exp(-3.0 * a)))), 0.1) * cl * 1.8;
        }
    }
    let edge = 1.0 - smoothstep(8.5, 10.2, abs(b.x));
    light *= edge * (1.0 - smoothstep(L + 0.5, L + 3.5, b.y)) * smoothstep(-3.0, -0.5, b.y);
    return (1.0 - exp(-light * 1.15)) * 1.05;
}

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    return big_bang_glow0(g, b, r, px) + big_bang_show(b, min(px, 0.06));
}
