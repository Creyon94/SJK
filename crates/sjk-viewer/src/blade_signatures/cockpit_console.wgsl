    let h = h21(q + vec2<f32>(3.1, 0.0));
    let lamp = select((select(vec3<f32>(1.0, 0.75, 0.2), vec3<f32>(0.3, 1.0, 0.4), h < 0.66)), vec3<f32>(1.0, 0.2, 0.15), h < 0.33);
    let on = step(0.5, h11(h * 91.0 + floor(uTime * (1.0 + 3.0 * h))));
    let dot_ = halo(length(vec2(abs(b.x) - 0.18, (fract(b.y / 1.6) - 0.5) * 1.6)), 0.12);
    return g * 0.9 + lvl(g) * lamp * dot_ * on * 1.4 * part(0.0);
}

