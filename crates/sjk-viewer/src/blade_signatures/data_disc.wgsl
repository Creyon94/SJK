// Data Disc: a spinning data disc as a blade. A disc of fine glowing grooves turns round the
// blade's middle, a bright read-light sweeping round it, and soft bands run up the blade. A
// clash sends an amber ring.
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    return g * (0.9 + 0.12 * bands(b.y, 0.1, 1.0));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c;
}

// the effects, flat round the blade as Sol's are
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let y0 = L * 0.2;
    let y1 = L * 0.97;
    var fx: vec3<f32> = vec3<f32>(0.0);
    let c: vec3<f32> = vec3<f32>(1.0, 0.6, 0.25);
    let yd = L * 0.62;
    let h = rayAt(ro, rd, yd);
    if h.z > 0.0 {
        let r = length(h.xy);
        let ang = atan2(h.y, h.x);
        let on = smoothstep(0.8, 1.0, r) * (1.0 - smoothstep(2.8, 3.1, r));
        let gr = 0.5 + 0.5 * cos(r * 25.0);
        let sweep = pow(0.5 + 0.5 * cos(ang - t * 1.5), 10.0);
        fx += c * on * (0.12 + 0.18 * gr + 0.9 * sweep * gr);
    }
    fx += c * halo(ringD(ro, rd, yd, 3.0), max(0.04, px)) * 0.6;
    // round 14 (Creyon): a chroma for the blade only; its effects keep their own colours
    uKeep += fx * uFx * part(0.0);
    return vec3<f32>(0.0);
}
