// a soft ring (torus) of radius R at height h, thickness w: its density integrated along the ray
fn bww_ring(ro: vec3<f32>, rd: vec3<f32>, h: f32, R: f32, w: f32) -> f32 {
    let sp = raySpan(ro, rd, R + 2.5 * w, h - 2.5 * w, h + 2.5 * w);
