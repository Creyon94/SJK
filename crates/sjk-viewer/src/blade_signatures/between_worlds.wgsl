// Between Worlds: a blade from the World Between Worlds, the path of light through the void
// outside time. A calm white-gold blade stands in its own small starry void. Faint echoes of the
// blade from other moments drift beside it in depth, translucent, fading in and out like ripples
// of time. Voices of light, soft streams, flow along it from both ends, from the hilt up and from
// the tip down, passing each other. Soft portal rings of shimmering light open and close along it,
// and star dust drifts slowly through the dark. A swing scatters the echoes wide; a clash makes
// every portal flash open at once.
// the ray's distance to a ring of radius R round the blade at height h
fn bww_ring(ro: vec3<f32>, rd: vec3<f32>, h: f32, R: f32) -> f32 {
    var best: f32 = 1.0e3;
    let q = rayAt(ro, rd, h);
    if q.z > 0.0 {
        best = abs(length(q.xy) - R);
    }
    let a = dot(rd.xz, rd.xz);
    let b = dot(ro.xz, rd.xz);
    let c = dot(ro.xz, ro.xz) - R * R;
    let dsc = b * b - a * c;
    if dsc > 0.0 && a > 1.0e-6 {
        let k = sqrt(dsc);
        let t0 = (-b - k) / a;
        let t1 = (-b + k) / a;
        if t0 > 0.0 {
            best = min(best, abs(ro.y + rd.y * t0 - h));
        }
        if t1 > 0.0 {
            best = min(best, abs(ro.y + rd.y * t1 - h));
        }
    }
    return best;
}

fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let top = L * clamp(uAge / 0.45, 0.0, 1.0);
    let fxOn = uFx * smoothstep(0.3, 1.2, uAge);
    let gold: vec3<f32> = vec3<f32>(1.0, 0.80, 0.45);
    let pale: vec3<f32> = vec3<f32>(1.0, 0.95, 0.85);
    let dusk: vec3<f32> = vec3<f32>(0.55, 0.45, 0.30);
    // The blade itself is Sol's glow and core from the file (sig_glow, sig_core).
    var light: vec3<f32> = vec3<f32>(0.0);
    if fxOn < 0.001 {
        return light;
    }
    // echoes of the blade from other moments: faint copies offset in depth, drifting and fading
    for (var e = 0; e < 4; e++) {
        let fe = f32(e);
        let per = 6.0 + 1.7 * fe;
        let f = fract(uTime / per + fe * 0.27);
        let vis = smoothstep(0.0, 0.25, f) * (1.0 - smoothstep(0.55, 1.0, f));
        let ang = h11(fe * 3.3 + floor(uTime / per + fe * 0.27) * 1.7);
        let off = (0.9 + 1.6 * f + 2.5 * sw) * (1.0 - 0.6 * cl);
        let a0 = around(off * 0.35, ang, 0.6);
        let a1 = around(off, ang + 0.06 * sin(uTime * 0.3 + fe), min(top, L * (0.92 + 0.05 * sin(uTime * 0.4 + fe))));
        var se: f32;
        let de = raySeg(ro, rd, a0, a1, &se);
        let tf = smoothstep(0.0, 0.08, se) * (1.0 - smoothstep(0.85, 1.0, se));
        let flick = 0.8 + 0.2 * sin(se * 30.0 - uTime * 3.0 + fe);
        let ec = select((select(pale, mix(pale, vec3<f32>(0.75, 0.85, 1.0), 0.5), e == 3)), mix(gold, vec3<f32>(1.0, 0.65, 0.30), 0.6), e == 1);
        light += ec * (exp(-pow(de / max(0.16, px), 2.0)) * 0.55 + halo(de, 0.6) * 0.22) * vis * tf * flick;
    }
    // voices of light: soft streams winding loosely along the blade, two rising from the hilt and
    // two falling from the tip, glowing pulses travelling along them
    for (var k = 0; k < 4; k++) {
        let fk = f32(k);
        let dir = select(-1.0, 1.0, k < 2);
        let rr = 0.75 + 0.35 * fk;
        let turns = (0.55 + 0.18 * fk) * dir;
        let ph = fk * 0.31 + uTime * 0.04 * dir;
        var prev = around(rr * 0.4, ph, 0.0);
        for (var j = 1; j <= 16; j++) {
            let fj = f32(j) / 16.0;
            let y = fj * L;
            let rj = rr * (0.4 + 0.6 * sin(min(fj * 1.6, 1.0) * 1.5708)) * (1.0 - 0.5 * smoothstep(0.85, 1.0, fj)) + 0.10 * sin(fj * 4.0 + uTime * 0.5 + fk);
            let q = around(rj, ph + fj * turns, y);
            if y - L / 16.0 < top {
                var sg: f32;
                let d = raySeg(ro, rd, prev, q, &sg);
                if d < 2.0 {
                    let u = (fj - (1.0 - sg) / 16.0);
                    // travel: rising streams move up, falling ones down
                    let pos = select(1.0 - u, u, dir > 0.0);
                    let pulse = pow(0.5 + 0.5 * sin(pos * 14.0 - uTime * (2.2 + 2.0 * sw) + fk * 1.7), 3.0);
                    let vis = smoothstep(0.0, 0.12, pos) * (1.0 - smoothstep(0.8, 1.0, pos));
                    let vc = select(pale, gold, dir > 0.0);
                    let w = max(px * 0.8, 0.05);
                    light += (vec3<f32>(1.0) * halo(d, w) * 0.45 * pulse + vc * halo(d, max(w * 2.5, 0.14)) * (0.10 + 0.45 * pulse) + vc * halo(d, 0.7) * 0.06 * (0.3 + pulse)) * vis;
                }
            }
            prev = q;
        }
    }
    // portals: soft shimmering rings opening and closing along the blade, a veil of light inside
    for (var k = 0; k < 3; k++) {
        let fk = f32(k);
        let per = 5.5 + 1.9 * fk;
        let f = fract(uTime / per + fk * 0.37);
        var open = sin(clamp(f / 0.7, 0.0, 1.0) * 3.1416);
        open = max(open, cl * 0.45);
        let h = L * (0.25 + 0.27 * fk) + 1.2 * sin(uTime * 0.25 + fk * 2.0);
        if h < top && open > 0.01 {
            let R = 0.6 + 2.4 * open + 4.0 * cl * (1.0 - cl);
            let dr = bww_ring(ro, rd, h, R);
            let sh = 0.7 + 0.3 * sin(uTime * 1.3 + h);
            light += (pale * halo(dr, max(0.05, px)) * 1.2 + mix(gold, pale, 0.5) * halo(dr, 0.3 + 0.3 * open) * 0.45) * open * sh * (0.6 + 0.5 * cl);
        }
    }
    // the starry void: tiny stars round the blade, some slowly drifting, twinkling
    for (var i = 0; i < 34; i++) {
        let fi = f32(i);
        let rr = 1.6 + 3.8 * h11(fi * 2.7);
        let a = h11(fi * 6.1) + uTime * 0.004 * (h11(fi * 4.4) - 0.5);
        let y = glsl_mod(L * h11(fi * 8.3) + uTime * (0.15 + 0.25 * h11(fi * 1.1)) * (select(-1.0, 1.0, i < 17)), L + 2.0) - 0.5;
        let q = around(rr, a, y);
        if q.y < top {
            var tt: f32;
            let d = rayPt(ro, rd, q, &tt);
            let tw = 0.4 + 0.6 * pow(0.5 + 0.5 * sin(uTime * (1.3 + 2.0 * h11(fi * 5.5)) + fi * 3.0), 2.0);
            let edge = smoothstep(-0.5, 1.0, y) * (1.0 - smoothstep(L - 1.0, L + 1.5, y));
            let w = max(px * 0.9, 0.035);
            let sc = select(pale, vec3<f32>(0.80, 0.86, 1.0), h11(fi * 9.9) > 0.6);
            light += (sc * halo(d, w) * 1.4 + sc * halo(d, w * 3.5) * 0.18) * tw * edge;
        }
    }
    return light;
}

// the blade: Sol's glow and core from the file, breathing calmly
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    return g * (0.85 + 0.15 * sin(b.y * 0.5 - uTime * 0.8) + 0.10 * sin(b.y * 0.21 + uTime * 0.5) + 0.5 * clamp(uClash, 0.0, 1.0));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c;
}

// GLSL's mod: x - y * floor(x / y) (WGSL's % truncates)
fn glsl_mod(x: f32, y: f32) -> f32 {
    return x - y * floor(x / y);
}
