// Between Worlds (was Time Fracture): a blade from the space between worlds and times. Echoes of
// the blade stand beside it: an amber one a moment in the past trailing behind and a cyan one a
// moment in the future leading ahead. Two doorways float beside it, triangles of light opening onto
// the stars of other times (Creyon: no clock), and
// star-paths branch out from the blade like the roads of a world between worlds, light running
// along them. Shards of other moments drift away. A swing spreads the echoes wide; a clash freezes
// time: cracks shoot out and the doorways flare.
fn time_fracture_glow0(g: vec3<f32>, b: vec2<f32>, r: f32, px_in: f32) -> vec3<f32> {
    var px = px_in;
    let L = uLength;
    px = min(px, 0.06);
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let amber: vec3<f32> = vec3<f32>(1.0, 0.7, 0.3);
    let cyan: vec3<f32> = vec3<f32>(0.4, 0.9, 1.0);
    let silver: vec3<f32> = vec3<f32>(0.92, 0.95, 1.0);
    let on = smoothstep(-0.5, 0.3, b.y);
    let yc = clamp(b.y, 0.0, L - 0.35);
    let d = length(vec2(b.x, b.y - yc));
    var light = vec3<f32>(1.0) * exp(-pow(d / 0.3, 2.0)) * 1.5 * on + silver * halo(d, 0.8) * 0.5 * on + silver * halo(d, 2.0) * 0.06 * on;
    // the echoes: past (amber, behind) and future (cyan, ahead), leaning away from the hilt
    for (var e = 0; e < 2; e++) {
        let s = select(1.0, -1.0, e == 0);
        let spread = (1.3 + 0.4 * sin(uTime * 0.9 + s) + 2.2 * sw) * (1.0 - cl * 0.8);
        let lean = s * spread * clamp(b.y / L, 0.0, 1.0);
        let ex = b.x - lean - s * 0.2 * smoothstep(0.0, 2.0, b.y);
        let de = length(vec2(ex, b.y - yc));
        let flick = select(0.8 + 0.2 * sin(b.y * 12.0 - uTime * 20.0), 0.75 + 0.25 * step(0.15, h11(floor(uTime * 14.0))), e == 0);
        let ec = select(cyan, amber, e == 0);
        light += ec * (exp(-pow(de / 0.22, 2.0)) * 0.75 + halo(de, 0.6) * 0.25) * flick * on * smoothstep(0.5, 3.0, b.y);
    }
    // two doorways floating beside the blade: triangles of light, a starfield of another time inside
    for (var k = 0; k < 2; k++) {
        let fk = f32(k);
        let sd = select(-1.0, 1.0, k == 0);
        let c = vec2(sd * (4.6 + 0.4 * sin(uTime * 0.5 + fk)), L * (0.62 - 0.3 * fk) + 1.0 * sin(uTime * 0.3 + fk * 2.0));
        let q = rot(0.25 * sin(uTime * 0.4 + fk)) * (b - c);
        let R = 1.9 + 0.3 * cl + 0.25 * sw;
        let t0 = vec2(0.0, R * 1.15);
        let t1 = vec2(R, -R * 0.6);
        let t2 = vec2(-R, -R * 0.6);
        let tri = min(min(sdSeg(q, t0, t1), sdSeg(q, t1, t2)), sdSeg(q, t2, t0));
        let inside = step(-0.6 * R, q.y) * step(abs(q.x), (R * 1.15 - q.y) / 1.75);
        let dc = select(amber, cyan, k == 0);
        light += mix(vec3<f32>(1.0), dc, 0.4) * (halo(tri, 0.05 + px) * 1.6 + halo(tri, 0.45) * 0.3);
        let sp = q * 3.2 + vec2(uTime * 0.35 * sd, 0.0);
        let sc = floor(sp);
        let star = step(0.82, h21(sc + fk * 31.0)) * halo(length(fract(sp) - h22(sc)), 0.05);
        light += (dc * 0.12 + vec3<f32>(1.0) * star * 1.6) * inside * smoothstep(0.0, 0.25, tri);
    }
    // the paths between worlds: lines of starlight branching off the blade into the dark, forking
    // again, lights running out along them and stars hung at their joints
    for (var i = 0; i < 9; i++) {
        let fi = f32(i);
        let ph = uTime * 0.22 + h11(fi * 4.1);
        let cyc = floor(ph);
        let life = fract(ph);
        let grow = smoothstep(0.0, 0.35, life);
        let vis = smoothstep(0.0, 0.1, life) * (1.0 - smoothstep(0.75, 1.0, life));
        let s = select(1.0, -1.0, h11(cyc * 2.7 + fi) < 0.5);
        let y0 = (0.06 + 0.88 * h11(cyc * 1.9 + fi * 3.0)) * L;
        let ang = -0.2 + 0.9 * h11(cyc * 3.3 + fi);
        let a0 = vec2(s * 0.35, y0);
        let a1 = a0 + vec2(s * cos(ang), sin(ang)) * (3.0 + 1.5 * h11(fi + cyc)) * grow;
        let a2 = a1 + vec2(s * cos(ang + 0.5), sin(ang + 0.5)) * (2.5 + 1.5 * h11(fi * 5.0 + cyc)) * grow;
        let a3 = a1 + vec2(s * cos(ang - 0.7), sin(ang - 0.7)) * (2.0 + 1.5 * h11(fi * 7.0 + cyc)) * grow;
        let dp = min(min(sdSeg(b, a0, a1), sdSeg(b, a1, a2)), sdSeg(b, a1, a3));
        let t = fract(uTime * 0.9 + fi * 0.17);
        let pulse = select(mix(a1, select(a3, a2, glsl_mod(fi, 3.0) < 1.5), t * 2.0 - 1.0), mix(a0, a1, t * 2.0), t < 0.5);
        let dashes = 0.55 + 0.45 * sin(length(b - a0) * 6.0 - uTime * 8.0);
        light += (vec3<f32>(0.8, 0.86, 1.0) * (halo(dp, 0.025 + px) * 0.9 * dashes + halo(dp, 0.3) * 0.12) + vec3<f32>(1.0) * halo(length(b - pulse), 0.13) * 1.8) * vis;
        light += vec3<f32>(1.0) * (halo(length(b - a1), 0.1) + halo(length(b - a2), 0.07) + halo(length(b - a3), 0.07)) * 1.3 * vis * grow;
    }
    // star dust drifting in the void
    for (var i = 0; i < 16; i++) {
        let fi = f32(i);
        let p = vec2((h11(fi * 2.3) - 0.5) * 16.0, fract(h11(fi * 5.9) + uTime * 0.02 * (0.5 + h11(fi))) * (L + 6.0) - 3.0);
        light += vec3<f32>(0.9, 0.92, 1.0) * halo(length(b - p), 0.06) * (0.6 + 0.6 * sin(uTime * 3.0 + fi * 2.0));
    }
    // clash: time freezes, cracks shoot out from the strike
    if cl > 0.01 {
        let cq = b - vec2(0.0, L * 0.6);
        let ca = atan2(cq.y, cq.x);
        let cr = length(cq);
        let crack = halo(abs(fract(ca * 7.0 / 6.2832 + 0.15 * vn(vec2(cr * 1.5, 0.0))) - 0.5), 0.03) * step(cr, 1.0 + 8.0 * (1.0 - cl));
        light += mix(amber, cyan, step(0.0, cq.x)) * crack * cl * 1.3 + vec3<f32>(1.0) * halo(abs(cr - 1.0 - 7.0 * (1.0 - cl)), 0.1) * cl;
    }
    let edge = 1.0 - smoothstep(8.5, 10.2, abs(b.x));
    light *= edge * (1.0 - smoothstep(L + 0.5, L + 3.5, b.y)) * smoothstep(-3.0, -0.5, b.y);
    return (1.0 - exp(-light * 1.15)) * 1.05;
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return vec3<f32>(0.0);
}

// ==== show (added) ====
// Time Fracture show: (gears removed) glass shards of other moments breaking off, and
// on the other), glass shards breaking off and drifting with time-echo copies trailing them,
// particles running backward and forward in time; a swing scatters the shards, a clash freezes time
// with a crack pattern shooting out and a ring.
fn tfGear(q: vec2<f32>, rad: f32, teeth: f32, rot_: f32) -> f32 {
    let r = length(q);
    let a = atan2(q.y, q.x) + rot_;
    let tooth = smoothstep(-0.2, 0.2, sin(a * teeth)) * 0.18 * rad;
    let outer = abs(r - rad - tooth) - 0.035;
    let inner = abs(r - rad * 0.45) - 0.03;
    var spokes: f32 = 1.0e3;
    for (var k = 0; k < 4; k++) {
        let sa = f32(k) * 0.785 - rot_;
        let d = vec2(cos(sa), sin(sa));
        spokes = min(spokes, max(abs(q.x * d.y - q.y * d.x) - 0.03, r - rad));
    }
    return min(min(outer, inner), max(spokes, rad * 0.45 - r));
}

fn time_fracture_show(b: vec2<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let amber: vec3<f32> = vec3<f32>(1.0, 0.7, 0.3);
    let cyan: vec3<f32> = vec3<f32>(0.4, 0.9, 1.0);
    var light: vec3<f32> = vec3<f32>(0.0);
    // shards breaking off, each trailed by two fading echoes of itself
    for (var i = 0; i < 8; i++) {
        let fi = f32(i);
        let ph = uTime * (0.3 + 0.15 * h11(fi * 2.7)) + h11(fi * 7.3);
        let cy = floor(ph);
        let f = fract(ph);
        let s = select(1.0, -1.0, h11(cy * 3.9 + fi) < 0.5);
        let v = vec2(s * (3.0 + 3.0 * h11(cy + fi)), 1.5 * (h11(cy * 2.0 + fi) - 0.4));
        let o = vec2(s * 0.4, (0.1 + 0.8 * h11(cy * 1.3 + fi * 5.0)) * L);
        let sc = select(cyan, amber, s < 0.0);
        for (var e = 0; e < 3; e++) {
            let fe = f - f32(e) * 0.07;
            if fe < 0.0 {
                continue;
            }
            let p = o + v * fe;
            var q = b - p;
            let an = uTime * 2.0 + fi - f32(e) * 0.3;
            q = vec2(q.x * cos(an) - q.y * sin(an), q.x * sin(an) + q.y * cos(an));
            let sh = max(abs(q.x) * 1.2 + q.y * 0.4, abs(q.y) * 0.9) - 0.35;
            let k = (1.0 - f) * smoothstep(0.0, 0.08, f) * (select(0.35 / f32(e), 1.0, e == 0));
            light += sc * (clamp(-sh * 8.0, 0.0, 1.0) * 0.5 + halo(abs(sh), 0.03 + px) * 1.2) * k;
        }
    }
    // time particles: amber ones fall back down, cyan ones race up, each with a ghost trail
    for (var i = 0; i < 10; i++) {
        let fi = f32(i);
        let s = select(1.0, -1.0, glsl_mod(fi, 2.0) < 0.5);
        let x = s * (1.0 + 1.6 * h11(fi * 4.7));
        let y = glsl_mod(uTime * (select(-5.0, 7.0, s > 0.0)) + h11(fi * 9.1) * L, L);
        for (var e = 0; e < 4; e++) {
            let ye = y - f32(e) * 0.5 * (select(-1.0, 1.0, s > 0.0));
            light += (select(cyan, amber, s < 0.0)) * halo(length(b - vec2(x, ye)), 0.07) * (1.4 - f32(e) * 0.32);
        }
    }
    let edge = 1.0 - smoothstep(8.5, 10.2, abs(b.x));
    light *= edge * (1.0 - smoothstep(L + 0.5, L + 3.5, b.y)) * smoothstep(-3.0, -0.5, b.y);
    return (1.0 - exp(-light * 1.15)) * 1.05;
}

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    return time_fracture_glow0(g, b, r, px) + time_fracture_show(b, min(px, 0.06));
}

// GLSL's mod: x - y * floor(x / y) (WGSL's % truncates)
fn glsl_mod(x: f32, y: f32) -> f32 {
    return x - y * floor(x / y);
}
