        frost += halo(e, 0.07) * halo(abs(b.y - yc), 2.5 * grow + 0.01) * grow;
    }
    return g * 0.85 + lvl(g) * vec3<f32>(0.85, 0.95, 1.0) * clamp(frost, 0.0, 1.0) * 0.8 * part(0.0);
}

