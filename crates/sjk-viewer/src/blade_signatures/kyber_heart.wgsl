// Generated by scripts/blade_signatures.py from kyber_heart.glsl: edit that file and run the
// script again.
// @part Heart veins
// @part Heartbeat glow
// @veins Kyber veins
// @motes Kyber motes
// @room 10
// @palette {"corona.rim_cool":[0.45,0.04,0.18],"corona.rim_hot":[1.0,0.30,0.50],"corona.inner":[1.0,0.80,0.88],"core.white":[1.0,0.94,0.96],"core.fringe_cool":[0.90,0.20,0.45],"core.fringe_hot":[1.0,0.65,0.78],"light.color":[1.0,0.30,0.50],"trail":[1.0,0.32,0.52]}

// Kyber Heart: a kyber crystal blade that beats like a living heart. The blade is rose-red
// crystal light with a white-hot core, and veins of light wind round it. On every heartbeat,
// lub-dub, a double pulse of light pumps up from the hilt through the veins to the tip: as the
// pulse passes, the blade swells and blazes, and each beat sends a soft glow rolling
// outward from the base of the blade. Between beats the blade dims and rests. Three arteries
// of light wind round it, lifeblood surging up them, and sparks crackle off them. A swing makes
// every beat pump harder and brighter; a clash makes the heart skip: a white flare floods the
// whole blade at once and a strong ring bursts out.
const KH_RATE: f32 = 1.2;

// beats a second (steady: a changing rate makes the phase race)
const KH_V: f32 = 52.0;

// how fast a pulse climbs the blade (units a second)
// the double beat at phase ph of a beat: lub, then a softer dub
fn kh_beatAt(ph: f32) -> f32 {
    return exp(-pow(ph / 0.07, 2.0)) + exp(-pow((ph - 1.0) / 0.07, 2.0)) + 0.65 * exp(-pow((ph - 0.24) / 0.07, 2.0));
}

// the pulse at height y (it left the hilt y/KH_V seconds ago)
fn kh_pulse(y: f32) -> f32 {
    let ph = fract(uTime * KH_RATE - max(y, 0.0) / KH_V * KH_RATE);
    return kh_beatAt(ph);
}

fn r8_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let rose: vec3<f32> = vec3<f32>(1.0, 0.28, 0.48);
    let deep: vec3<f32> = vec3<f32>(0.75, 0.05, 0.2);
    let pale: vec3<f32> = vec3<f32>(1.0, 0.78, 0.86);
    let white: vec3<f32> = vec3<f32>(1.0);
    let top = L * clamp(uAge / 0.45, 0.0, 1.0);
    let fx = uFx;
    let pump = 1.0 + 0.6 * sw;
    // The blade is Sol's glow and core from the file, swelling with each pulse (sig_glow,
    // sig_core); here only the effects, each a piece placed round it in 3D.
    var s: f32;
    var light: vec3<f32> = vec3<f32>(0.0);
    if fx > 0.0 {
        var fxl: vec3<f32> = vec3<f32>(0.0);
        let near = raySegRaw(ro, rd, vec3<f32>(0.0, 0.0, 0.0), vec3(0.0, top, 0.0), &s);
        // ---- the veins: four strands of light wound round the blade, two each way
        if near < 1.8 {
            for (var v = 0; v < 4; v++) {
                let fv = f32(v);
                let dir = select(-1.0, 1.0, v < 2);
                let ph0 = fv * 0.5 + (select(0.25, 0.0, v < 2));
                var prev: vec3<f32> = vec3<f32>(0.0, -0.4, 0.0);
                var best: f32 = 1.0e3;
                var by: f32 = 0.0;
                for (var k = 1; k <= 16; k++) {
                    let f = f32(k) / 16.0;
                    let yy = mix(-0.4, top, f);
                    let pk = kh_pulse(yy) * pump + cl;
                    let r = (0.5 + 0.07 * sin(yy * 0.35 + fv * 2.0) + 0.06 * pk) * smoothstep(-0.4, 1.5, yy) * (1.0 - smoothstep(top - 2.5, top, yy) * 0.8);
                    let q = around(r, ph0 + dir * yy * 0.036, yy);
                    var sv: f32;
                    let dv = raySeg(ro, rd, prev, q, &sv);
                    if dv < best {
                        best = dv;
                        by = mix(prev.y, q.y, sv);
                    }
                    prev = q;
                }
                let pv = kh_pulse(by) * pump + cl * 1.2;
                fxl += (mix(rose, white, min(pv, 1.0)) * halo(best, max(px, 0.03)) * (0.35 + 1.3 * pv) + rose * halo(best, 0.16) * (0.35 + 1.0 * pv)) * smoothstep(-0.4, 0.5, by);
            }
        }
        // (round 13, Creyon: no rings round the blade: the beat shows in the pulse, the glow and the sparks)
        // ---- each beat throws a spray of rose sparks off the blade where the pulse is passing
        let bt = fract(t * KH_RATE) / KH_RATE;
        let bn = floor(t * KH_RATE);
        for (var i = 0; i < 18; i++) {
            let fi = f32(i);
            let y0 = min(bt * KH_V, top) - 1.0 - 6.0 * h11(fi * 3.3 + bn);
            if y0 < 0.5 || y0 > top {
                continue;
            }
            let dir = normalize(vec3(sin(6.2832 * h11(fi * 1.9 + bn)), 0.4 * (h11(fi * 4.4 + bn) - 0.3), cos(6.2832 * h11(fi * 1.9 + bn))));
            let age = bt - y0 / KH_V;
            if age < 0.0 {
                continue;
            }
            var v = (4.0 + 5.0 * h11(fi * 7.1 + bn)) * pump;
            let p0 = vec3(0.0, y0, 0.0) + dir * (0.4 + v * (1.0 - exp(-age * 3.0)) / 3.0);
            let p1 = p0 - dir * (0.3 + 0.6 * exp(-age * 3.0));
            var sk: f32;
            let dk = raySeg(ro, rd, p1, p0, &sk);
            fxl += mix(white, rose, smoothstep(0.0, 0.6, age)) * (halo(dk, max(0.05, px)) * 1.6 + halo(dk, 0.3) * 0.3) * exp(-age * 2.5) * sk;
        }
        // ---- a clash: the heart skips, a white flare floods the blade and a strong ring bursts out
        if cl > 0.01 {
            let R = 1.0 + 6.5 * (1.0 - cl);
            let wr = 0.3 + 0.5 * (1.0 - cl);
            var o = ro - vec3(0.0, L * 0.5, 0.0);
            o.y *= 3.0;
            var dd = rd;
            dd.y *= 3.0;
            dd = normalize(dd);
            let rr = length(o + dd * max(dot(-o, dd), 0.0));
            let sh = clamp(wr / sqrt(max(R * R - rr * rr, wr * wr)), 0.0, 1.0) * smoothstep(R + wr, R - 2.0 * wr, rr) + halo(abs(rr - R), wr * 1.4) * 0.5;
            var tc: f32;
            fxl += (pale * sh * 1.2) * cl + white * halo(rayPtRaw(ro, rd, vec3(0.0, L * 0.5, 0.0), &tc), 1.5) * pow(cl, 2.0) * 0.6;
        }
        light += fxl * fx;
    }
    return light;
}

// the blade: Sol's glow and core from the file, swelling and blazing as each pulse passes and
// dimming between beats
fn sig_glow_own(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let p = kh_pulse(b.y) * (1.0 + 0.6 * clamp(uSwing, 0.0, 1.0)) + 1.2 * clamp(uClash, 0.0, 1.0);
    return g * (0.6 + 0.9 * p);
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    let p = kh_pulse(b.y) + 1.2 * clamp(uClash, 0.0, 1.0);
    return c * (0.85 + 0.5 * p);
}

// ---- round 14 (Creyon): arteries of lifeblood and sparks ----
// Three arteries of light winding slowly round the blade, wider than its veins so they stand
// clear of its glow (the point of artery fv at height y, thinning towards the tip).
fn kh_artery(fv: f32, y: f32, top: f32) -> vec3<f32> {
    let dir = select((select(1.0, -1.0, fv < 1.5)), 1.0, fv < 0.5);
    let r = (1.7 + 0.35 * sin(y * 0.22 + fv * 2.1)) * (1.0 - 0.6 * smoothstep(top - 6.0, top, y));
    return around(r, fv / 3.0 + dir * y * 0.022, y);
}

// Lifeblood: the arteries glow faintly rose, and bright drops of light surge up them without
// pause (a steady clock, so nothing races when turning or running), flaring white as each
// heartbeat passes them; sparks crackle off the arteries and fly out. All of it starts above
// the wearer's head (0.2 of the length) and fades out under the tip.
fn kh_lifeblood(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    var acc: vec3<f32> = vec3<f32>(0.0);
    let L = uLength;
    let t = uTime;
    let top = L * clamp(uAge / 0.45, 0.0, 1.0);
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let pump = 1.0 + 0.6 * sw;
    var s: f32;
    if raySegRaw(ro, rd, vec3<f32>(0.0, 0.0, 0.0), vec3(0.0, top, 0.0), &s) > 6.0 {
        return acc;
    }
    let rose: vec3<f32> = vec3<f32>(1.0, 0.3, 0.5);
    let hot: vec3<f32> = vec3<f32>(1.0, 0.75, 0.85);
    let white: vec3<f32> = vec3<f32>(1.0);
    let y0 = L * 0.2;
    let y1 = max(top - 0.5, y0);
    for (var v = 0; v < 3; v++) {
        let fv = f32(v);
        // the artery: a thin rose line, brighter where the beat is passing
        var prev = kh_artery(fv, y0 - 1.5, top);
        var best: f32 = 1.0e3;
        var by = y0;
        for (var k = 1; k <= 18; k++) {
            let yy = mix(y0 - 1.5, y1, f32(k) / 18.0);
            let q = kh_artery(fv, yy, top);
            var sv: f32;
            let dv = raySeg(ro, rd, prev, q, &sv);
            if dv < best {
                best = dv;
                by = mix(prev.y, q.y, sv);
            }
            prev = q;
        }
        let pb = kh_pulse(by) * pump + cl;
        let fade = smoothstep(y0 - 1.5, y0 + 1.0, by) * (select(0.0, 1.0, by < top));
        acc += (mix(rose, hot, min(pb, 1.0)) * halo(best, max(px, 0.035)) * (0.7 + 1.3 * pb) + rose * halo(best, 0.35) * (0.2 + 0.45 * pb)) * fade;
        // the lifeblood: four drops on each artery, a bright head and a tapering tail
        for (var j = 0; j < 4; j++) {
            let fj = f32(j);
            let f = fract(t * 0.3 + fj / 4.0 + 0.29 * fv);
            let y = mix(y0 - 3.0, L + 2.0, f);
            if y > top + 1.0 {
                continue;
            }
            let a = kh_artery(fv, y - 3.0, top);
            let m = kh_artery(fv, y - 1.4, top);
            let b = kh_artery(fv, y, top);
            var s1: f32;
            var s2: f32;
            let d1 = raySeg(ro, rd, a, m, &s1);
            let d2 = raySeg(ro, rd, m, b, &s2);
            let d = min(d1, d2);
            let tail = select(0.45 * s1, 0.45 + 0.55 * s2, d2 < d1);
            let fd = smoothstep(y0 - 2.0, y0 + 0.5, y) * (1.0 - smoothstep(top - 1.5, top + 1.0, y));
            let pv = kh_pulse(y) * pump + cl;
            let head = halo(length(ro + rd * max(dot(b - ro, rd), 0.0) - b), 0.22);
            acc += (mix(hot, white, min(pv, 1.0)) * halo(d, max(px, 0.06)) * 2.2 + rose * halo(d, 0.4) * 0.6) * tail * tail * fd * (0.8 + 0.8 * pv) + white * head * fd * (0.9 + 1.2 * pv);
        }
    }
    // the crackle: sparks jumping off an artery and flying out, each on its own steady cycle
    for (var i = 0; i < 16; i++) {
        let fi = f32(i);
        let cyc = t * 1.1 * (0.7 + 0.6 * h11(fi * 2.3 + 5.0)) + h11(fi * 6.1 + 1.0);
        var k = floor(cyc);
        let q = fract(cyc);
        if q > 0.4 {
            continue;
        }
        let age = q / 0.4;
        let fv = glsl_mod(fi, 3.0);
        let y = mix(y0, y1, h11(fi * 3.7 + k * 1.31));
        let p = kh_artery(fv, y, top);
        let dir = normalize(normalize(vec3(p.x, 0.0, p.z) + vec3<f32>(1.0e-4, 0.0, 0.0)) + vec3(0.0, 0.8 * (h11(fi * 1.7 + k * 2.9) - 0.25), 0.0));
        let p1 = p + dir * (0.1 + 4.5 * age * pump);
        let p0 = p + dir * (0.1 + 4.5 * max(age - 0.22, 0.0) * pump);
        var sk: f32;
        let dk = raySeg(ro, rd, p0, p1, &sk);
        let fd = smoothstep(y0 - 1.0, y0 + 1.0, y);
        acc += mix(white, rose, age) * (halo(dk, max(px, 0.045)) * 2.2 + halo(dk, 0.25) * 0.4) * (1.0 - age) * (0.4 + 0.6 * sk) * fd;
    }
    return acc;
}

// ---- round 9: the big effects layer ----
// Round 11 (Creyon): its own look, Sol's way: its round-8 effects as part 0, its own parts
// (`part(k)`, the `// @part` lines) and Sol's pieces from its file; nothing shared with the others.
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let col = (r8_vol(ro, rd, px) + kh_lifeblood(ro, rd, px) * uFx) * part(0.0);
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let y0 = L * 0.2;
    let y1 = L * 0.97;
    var fx: vec3<f32> = vec3<f32>(0.0);
    let rose: vec3<f32> = vec3<f32>(1.0, 0.3, 0.5);
    let ph = fract(t * KH_RATE);
    let beat = exp(-ph * 9.0) + 0.6 * exp(-max(ph - 0.22, 0.0) * 9.0) * step(0.22, ph);
    fx += fxFlare(ro, rd, vec3(0.0, L * 0.35, 0.0), px, 0.3, 4.0 + 2.0 * beat, 4.0, 0.785, vec3<f32>(1.0, 0.85, 0.9)) * (0.4 + 1.2 * beat) * part(1.0);
    fx += fxAura(ro, rd, y0, y1, 2.6, rose) * (0.5 + 1.0 * beat) * part(1.0);
    return col + fx * uFx;
}

// round 15 (Creyon: some blades glowed so much their effects hardly showed): its glow at
// 70 %, so what is drawn round it reads
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    return sig_glow_own(g, b, r, px) * 0.7;
}
