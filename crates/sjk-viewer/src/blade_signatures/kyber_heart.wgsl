// @room 7
// @palette {"corona.rim_cool":[0.45,0.04,0.18],"corona.rim_hot":[1.0,0.30,0.50],"corona.inner":[1.0,0.80,0.88],"core.white":[1.0,0.94,0.96],"core.fringe_cool":[0.90,0.20,0.45],"core.fringe_hot":[1.0,0.65,0.78],"light.color":[1.0,0.30,0.50],"trail":[1.0,0.32,0.52]}

// Kyber Heart (was Crystal Heart): a kyber crystal heart. a faceted ruby heart sits on the emitter and beats, lub-dub, swelling and flashing
// on every beat. Each beat sends a pulse of light racing up the veins that branch through the thin
// rose-crystal blade above it. Every ten seconds it surges: three hard beats flood every vein to the
// tip. Swinging quickens the heartbeat; a clash makes it skip and flare.
// Each beat also throws a heart-shaped shockwave out round the blade, curling ribbons of rose light
// peel off it and tiny crystal hearts float away twinkling. Swinging sheds more hearts; a clash
// cracks the heart into flying shards. The blade's tip is rounded.
const CH_S: f32 = 2.2;
const CH_Y: f32 = 0.2;

fn ch_surge() -> f32 {
    let p = glsl_mod(uTime - 10.0, 10.0);
    return smoothstep(0.0, 0.2, p) * (1.0 - smoothstep(2.4, 3.2, p));
}

// A steady beat (a rate that changed with the swing or the surge made the phase race in game).
fn ch_rate() -> f32 {
    return 1.3;
}

fn ch_beatAt(ph_in: f32) -> f32 {
    var ph = ph_in;
    ph = max(ph, 0.0);
    return exp(-ph * 16.0) + 0.6 * exp(-max(ph - 0.22, 0.0) * 16.0) * step(0.22, ph);
}

fn ch_beat() -> f32 {
    let ph = fract(uTime * ch_rate());
    return ch_beatAt(ph) * (1.0 + 0.6 * ch_surge()) + uClash * 0.8;
}

fn ch_dot2(v: vec2<f32>) -> f32 {
    return dot(v, v);
}

fn ch_sdHeart(p_in: vec2<f32>) -> f32 {
    var p = p_in;
    p.x = abs(p.x);
    if p.y + p.x > 1.0 {
        return sqrt(ch_dot2(p - vec2<f32>(0.25, 0.75))) - 0.35355;
    }
    return sqrt(min(ch_dot2(p - vec2<f32>(0.0, 1.0)), ch_dot2(p - 0.5 * max(p.x + p.y, 0.0)))) * sign(p.x - p.y);
}

// the heart: rgb light, a cover
fn ch_heart(b: vec2<f32>, px: f32) -> vec4<f32> {
    let bt = ch_beat();
    let s = CH_S * (1.0 + 0.07 * bt);
    let p = (b - vec2(0.0, CH_Y)) / s;
    let d = ch_sdHeart(p) * s;
    if d > 1.6 {
        return vec4<f32>(0.0);
    }
    // facets: sectors round a point under the cleft, split by an inner girdle
    let fc: vec2<f32> = vec2<f32>(0.0, 0.62);
    let v = p - fc;
    let a = atan2(v.x, v.y);
    let rr = length(v);
    let n: f32 = 9.0;
    let sec = floor((a + 3.14159) / (6.28318 / n));
    let fa = fract((a + 3.14159) / (6.28318 / n));
    let ring = step(0.30, rr);
    let edgeA = min(fa, 1.0 - fa) * (6.28318 / n) * rr * s;
    let edgeR = abs(rr - 0.30) * s;
    let edges = halo(min(edgeA, edgeR), 0.03 + px);
    let shade = 0.45 + 0.55 * h11(sec * 3.7 + ring * 11.0);
    let glint = pow(max(0.0, sin(sec * 1.9 + ring * 2.0 - uTime * 1.3)), 12.0);
    let inside = fillD(d, px);
    var ruby = mix(vec3<f32>(0.55, 0.02, 0.12), vec3<f32>(1.0, 0.25, 0.42), shade);
    ruby = mix(ruby, vec3<f32>(1.0, 0.75, 0.85), glint * 0.8);
    var c = ruby * inside * (0.9 + 0.9 * bt);
    c += vec3<f32>(1.0, 0.85, 0.92) * edges * inside * 0.9;
    c += vec3<f32>(1.0, 0.95, 0.97) * halo(rr, 0.22) * inside * (0.6 + 2.2 * bt);
    // the light at its heart
    c += vec3<f32>(1.0, 0.85, 0.9) * halo(abs(d), 0.03 + px) * 1.3;
    // the outline
    c += vec3<f32>(1.0, 0.25, 0.45) * halo(max(d, 0.0), 0.5 + 0.4 * bt) * (0.4 + 1.0 * bt);
    // the beat's bloom
    return vec4(c, inside);
}

// the veins: five meandering vessels from the heart's cleft, each forking into capillaries
fn ch_veins(b: vec2<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let y0 = CH_Y + CH_S * 0.9;
    if b.y < y0 - 0.5 || b.y > L + 0.5 {
        return vec3<f32>(0.0);
    }
    let rate = ch_rate();
    let h = clamp((b.y - y0) / (L - y0), 0.0, 1.0);
    let cnt: f32 = 0.0;
    var vein: f32 = 0.0;
    // pulses in flight (the last three beats), moving up at 20 units/s
    let ph = uTime * rate;
    var pl: f32 = 0.0;
    for (var j = 0; j < 3; j++) {
        let beatT = (floor(ph) - f32(j)) / rate;
        let yp = y0 + (uTime - beatT) * 20.0;
        pl += halo(abs(b.y - yp), 1.3) * (1.0 + ch_surge());
    }
    let flood = ch_surge() * smoothstep(y0 + glsl_mod(uTime - 10.0, 10.0) * 22.0 + 2.0, y0 + glsl_mod(uTime - 10.0, 10.0) * 22.0 - 2.0, b.y);
    let conv = 1.0 - smoothstep(0.7, 1.0, h);
    // they meet at the tip
    for (var k = 0; k < 5; k++) {
        let fk = f32(k);
        let off = (fk - 2.0) * 0.28;
        let x = (off + 0.22 * sin(b.y * (0.35 + 0.07 * fk) + fk * 1.7) + 0.08 * sin(b.y * 1.3 + fk * 4.0)) * conv * smoothstep(y0 - 0.5, y0 + 2.0, b.y);
        let w = mix(0.07, 0.035, h);
        let d = abs(b.x - x);
        vein = max(vein, fillD(d - w, px) + halo(d, 0.10) * 0.3);
        // a capillary fork every few units
        let cy = (b.y - y0) / 2.6 + fk * 0.37;
        let ci = floor(cy);
        let fy = fract(cy);
        let side = select(1.0, -1.0, h11(ci + fk * 13.0) < 0.5);
        let a0 = vec2(x, b.y - fy * 2.6);
        let a1 = a0 + vec2(side * 0.38, 1.1) * conv;
        let dc = sdSeg(b, a0, a1);
        vein = max(vein, fillD(dc - 0.022, px) * 0.8 + halo(dc, 0.06) * 0.3);
    }
    vein = min(vein, 1.4);
    let base: vec3<f32> = vec3<f32>(0.75, 0.04, 0.16) * 0.8;
    return vein * (base + vec3<f32>(1.0, 0.45, 0.60) * (pl * 1.5 + flood * 1.6));
}

// the heart's show off the blade: beat shockwaves, rose ribbons, floating crystal hearts, clash shards
fn ch_show(b: vec2<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    var light: vec3<f32> = vec3<f32>(0.0);
    let hc = vec2(0.0, CH_Y + CH_S * 0.55);
    let rate = ch_rate();
    // beat shockwaves: heart outlines growing out from the heart and fading, the last two beats
    for (var j = 0; j < 2; j++) {
        let ph = fract(uTime * rate) + f32(j);
        let age = ph / rate;
        let sc = CH_S * (1.0 + 2.6 * age * (1.0 + 0.6 * uSwing));
        let p = (b - vec2(0.0, CH_Y - 0.4 * age * CH_S)) / sc;
        let d = abs(ch_sdHeart(p)) * sc;
        let k = (1.0 - smoothstep(0.0, 1.3, age)) * (1.0 + ch_surge());
        light += vec3<f32>(1.0, 0.35, 0.55) * (halo(d, 0.06 + px) + halo(d, 0.4) * 0.3) * k * 0.9;
    }
    // ribbons of rose light peeling off the blade, curling outward and fading
    for (var i = 0; i < 7; i++) {
        let fi = f32(i);
        let ph = uTime * (0.45 + 0.2 * h11(fi * 2.9)) + h11(fi * 7.1);
        let cy = floor(ph);
        let f = fract(ph);
        let s = select(1.0, -1.0, h11(cy * 3.3 + fi) < 0.5);
        let y0 = (0.15 + 0.75 * h11(cy * 1.7 + fi * 4.0)) * L;
        let len = (3.5 + 3.0 * h11(cy + fi)) * smoothstep(0.0, 0.45, f);
        let xs = b.x * s - 0.6;
        let u = xs / max(len, 0.01);
        if u < 0.0 || u > 1.0 {
            continue;
        }
        let curl = sin(u * 5.0 + cy) * 1.1 * u + u * u * 2.2 * (h11(cy * 5.0 + fi) - 0.3);
        let dy = b.y - y0 - curl;
        let th = 0.05 + 0.05 * u;
        let fade = (1.0 - f) * smoothstep(0.0, 0.08, f) * (1.0 - smoothstep(0.85, 1.0, u));
        light += mix(vec3<f32>(1.0, 0.75, 0.85), vec3<f32>(1.0, 0.25, 0.5), u) * (exp(-pow(dy / th, 2.0)) * 1.4 + halo(abs(dy), 0.3) * 0.2) * fade;
    }
    // tiny crystal hearts floating up and away, twinkling
    for (var i = 0; i < 10; i++) {
        let fi = f32(i);
        let ph = uTime * (0.3 + 0.15 * h11(fi * 3.1)) + h11(fi * 9.3);
        let cy = floor(ph);
        let f = fract(ph);
        let s = select(1.0, -1.0, h11(cy * 2.1 + fi) < 0.5);
        let p = vec2(s * (1.0 + 4.5 * f + 0.5 * sin(f * 9.0 + fi)), (0.12 + 0.8 * h11(cy * 4.3 + fi)) * L + 2.5 * f);
        let sz = 0.35 + 0.25 * h11(fi * 5.0);
        let hd = ch_sdHeart((b - p) / sz + vec2<f32>(0.0, 0.5)) * sz;
        let tw = 0.6 + 0.4 * sin(uTime * 7.0 + fi * 3.0);
        let fade = (1.0 - f) * smoothstep(0.0, 0.1, f);
        light += vec3<f32>(1.0, 0.45, 0.65) * (fillD(hd, px) * 0.9 * tw + halo(max(hd, 0.0), 0.2) * 0.4) * fade;
    }
    // clash: the heart cracks and shards of ruby crystal fly out
    if uClash > 0.01 {
        let a = 1.0 - uClash;
        for (var i = 0; i < 12; i++) {
            let fi = f32(i);
            let an = fi * 0.5236 + 0.4 * h11(fi);
            let p = hc + vec2(cos(an), sin(an)) * (0.8 + 7.0 * (1.0 - exp(-3.0 * a)));
            var q = b - p;
            let rr = uTime * 7.0 + fi;
            q = vec2(q.x * cos(rr) - q.y * sin(rr), q.x * sin(rr) + q.y * cos(rr));
            let sh = max(abs(q.x) * 1.7 + abs(q.y) * 0.6, abs(q.y)) - 0.32;
            light += vec3<f32>(1.0, 0.3, 0.5) * (fillD(sh, px) + halo(max(sh, 0.0), 0.25) * 0.5) * uClash * 1.3;
        }
        light += vec3<f32>(1.0, 0.6, 0.75) * halo(length(b - hc), 1.8) * pow(uClash, 3.0);
    }
    let edge = 1.0 - smoothstep(7.5, 9.0, abs(b.x));
    return light * edge * (1.0 - smoothstep(L + 1.0, L + 4.0, b.y)) * smoothstep(-3.0, -0.5, b.y);
}

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let L = uLength;
    let ax = abs(b.x);
    let on = smoothstep(CH_Y + 1.0, CH_Y + 2.5, b.y);
    // the rose crystal blade: clear glass, long facets catching light
    let facet = halo(abs(fract(b.y * 0.18 + b.x * 0.35) - 0.5), 0.05) * 0.25 + halo(abs(fract(b.y * 0.13 - b.x * 0.4 + 0.3) - 0.5), 0.04) * 0.18;
    let dcap = length(vec2(b.x, max(b.y - (L - 0.8), 0.0)));
    // a rounded tip, never open
    let glass = fillD(dcap - 0.80, px);
    var blade = (vec3<f32>(1.0, 0.40, 0.58) * 0.30 + vec3<f32>(1.0, 0.80, 0.88) * facet * 0.8) * glass * on;
    blade += vec3<f32>(1.0, 0.85, 0.92) * halo(abs(dcap - 0.80), 0.03 + px) * 0.6 * on;
    // the crystal's edge
    let bd = length(vec2(b.x, max(b.y - L, 0.0)));
    let outer = vec3<f32>(1.0, 0.22, 0.45) * (halo(bd, 1.2) * 0.45 + halo(bd, 2.4) * 0.15) * on * (0.85 + 0.35 * ch_beat());
    let hrt = ch_heart(b, px);
    let veins = ch_veins(b, px) * glass * (1.0 - hrt.a);
    // the tip flashes when a surge reaches it
    let tipF = ch_surge() * halo(length(b - vec2(0.0, L - 0.5)), 1.2) * smoothstep(1.4, 2.0, glsl_mod(uTime - 10.0, 10.0));
    let show = ch_show(b, px);
    return (outer + blade) * (1.0 - hrt.a) + veins + hrt.rgb + vec3<f32>(1.0, 0.8, 0.9) * tipF * 1.5 + show;
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    let on = smoothstep(CH_Y + 2.2, CH_Y + 3.4, b.y) * (1.0 - smoothstep(uLength - 0.6, uLength, b.y));
    let dc = length(vec2(b.x, max(b.y - (uLength - 0.9), 0.0)));
    return vec3<f32>(1.0, 0.9, 0.95) * (1.0 - smoothstep(0.04, 0.18, dc)) * smoothstep(CH_Y + 2.2, CH_Y + 3.4, b.y) * 0.45;
}

// GLSL's mod: x - y * floor(x / y) (WGSL's % truncates)
fn glsl_mod(x: f32, y: f32) -> f32 {
    return x - y * floor(x / y);
}
