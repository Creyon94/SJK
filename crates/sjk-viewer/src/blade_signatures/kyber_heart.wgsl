// Kyber Heart: a kyber crystal blade that beats like a living heart. The blade is rose-red
// crystal light with a white-hot core, and veins of light wind round it. On every heartbeat,
// lub-dub, a double pulse of light pumps up from the hilt through the veins to the tip: as the
// pulse passes, the blade swells and blazes, and each beat sends a soft glow rolling
// outward from the base of the blade. Between beats the blade dims and rests. A swing makes
// every beat pump harder and brighter; a clash makes the heart skip: a white flare floods the
// whole blade at once and a strong ring bursts out.
const KH_RATE: f32 = 1.2;

// beats a second (steady: a changing rate makes the phase race)
const KH_V: f32 = 52.0;

// how fast a pulse climbs the blade (units a second)
// the double beat at phase ph of a beat: lub, then a softer dub
fn kh_beatAt(ph: f32) -> f32 {
    return exp(-pow(ph / 0.07, 2.0)) + exp(-pow((ph - 1.0) / 0.07, 2.0)) + 0.65 * exp(-pow((ph - 0.24) / 0.07, 2.0));
}

// the pulse at height y (it left the hilt y/KH_V seconds ago)
fn kh_pulse(y: f32) -> f32 {
    let ph = fract(uTime * KH_RATE - max(y, 0.0) / KH_V * KH_RATE);
    return kh_beatAt(ph);
}

fn r8_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let rose: vec3<f32> = vec3<f32>(1.0, 0.28, 0.48);
    let deep: vec3<f32> = vec3<f32>(0.75, 0.05, 0.2);
    let pale: vec3<f32> = vec3<f32>(1.0, 0.78, 0.86);
    let white: vec3<f32> = vec3<f32>(1.0);
    let top = L * clamp(uAge / 0.45, 0.0, 1.0);
    let fx = uFx;
    let pump = 1.0 + 0.6 * sw;
    // The blade is Sol's glow and core from the file, swelling with each pulse (sig_glow,
    // sig_core); here only the effects, each a piece placed round it in 3D.
    var s: f32;
    var light: vec3<f32> = vec3<f32>(0.0);
    if fx > 0.0 {
        var fxl: vec3<f32> = vec3<f32>(0.0);
        let near = raySeg(ro, rd, vec3<f32>(0.0, 0.0, 0.0), vec3(0.0, top, 0.0), &s);
        // ---- the veins: four strands of light wound round the blade, two each way
        if near < 1.8 {
            for (var v = 0; v < 4; v++) {
                let fv = f32(v);
                let dir = select(-1.0, 1.0, v < 2);
                let ph0 = fv * 0.5 + (select(0.25, 0.0, v < 2));
                var prev: vec3<f32> = vec3<f32>(0.0, -0.4, 0.0);
                var best: f32 = 1.0e3;
                var by: f32 = 0.0;
                for (var k = 1; k <= 16; k++) {
                    let f = f32(k) / 16.0;
                    let yy = mix(-0.4, top, f);
                    let pk = kh_pulse(yy) * pump + cl;
                    let r = (0.5 + 0.07 * sin(yy * 0.35 + fv * 2.0) + 0.06 * pk) * smoothstep(-0.4, 1.5, yy) * (1.0 - smoothstep(top - 2.5, top, yy) * 0.8);
                    let q = around(r, ph0 + dir * yy * 0.036, yy);
                    var sv: f32;
                    let dv = raySeg(ro, rd, prev, q, &sv);
                    if dv < best {
                        best = dv;
                        by = mix(prev.y, q.y, sv);
                    }
                    prev = q;
                }
                let pv = kh_pulse(by) * pump + cl * 1.2;
                fxl += (mix(rose, white, min(pv, 1.0)) * halo(best, max(px, 0.03)) * (0.35 + 1.3 * pv) + rose * halo(best, 0.16) * (0.35 + 1.0 * pv)) * smoothstep(-0.4, 0.5, by);
            }
        }
        // (round 13, Creyon: no rings round the blade: the beat shows in the pulse, the glow and the sparks)
        // ---- each beat throws a spray of rose sparks off the blade where the pulse is passing
        let bt = fract(t * KH_RATE) / KH_RATE;
        let bn = floor(t * KH_RATE);
        for (var i = 0; i < 18; i++) {
            let fi = f32(i);
            let y0 = min(bt * KH_V, top) - 1.0 - 6.0 * h11(fi * 3.3 + bn);
            if y0 < 0.5 || y0 > top {
                continue;
            }
            let dir = normalize(vec3(sin(6.2832 * h11(fi * 1.9 + bn)), 0.4 * (h11(fi * 4.4 + bn) - 0.3), cos(6.2832 * h11(fi * 1.9 + bn))));
            let age = bt - y0 / KH_V;
            if age < 0.0 {
                continue;
            }
            var v = (4.0 + 5.0 * h11(fi * 7.1 + bn)) * pump;
            let p0 = vec3(0.0, y0, 0.0) + dir * (0.4 + v * (1.0 - exp(-age * 3.0)) / 3.0);
            let p1 = p0 - dir * (0.3 + 0.6 * exp(-age * 3.0));
            var sk: f32;
            let dk = raySeg(ro, rd, p1, p0, &sk);
            fxl += mix(white, rose, smoothstep(0.0, 0.6, age)) * (halo(dk, max(0.05, px)) * 1.6 + halo(dk, 0.3) * 0.3) * exp(-age * 2.5) * sk;
        }
        // ---- a clash: the heart skips, a white flare floods the blade and a strong ring bursts out
        if cl > 0.01 {
            let R = 1.0 + 6.5 * (1.0 - cl);
            let wr = 0.3 + 0.5 * (1.0 - cl);
            var o = ro - vec3(0.0, L * 0.5, 0.0);
            o.y *= 3.0;
            var dd = rd;
            dd.y *= 3.0;
            dd = normalize(dd);
            let rr = length(o + dd * max(dot(-o, dd), 0.0));
            let sh = clamp(wr / sqrt(max(R * R - rr * rr, wr * wr)), 0.0, 1.0) * smoothstep(R + wr, R - 2.0 * wr, rr) + halo(abs(rr - R), wr * 1.4) * 0.5;
            var tc: f32;
            fxl += (pale * sh * 1.2) * cl + white * halo(rayPt(ro, rd, vec3(0.0, L * 0.5, 0.0), &tc), 1.5) * pow(cl, 2.0) * 0.6;
        }
        light += fxl * fx;
    }
    return light;
}

// the blade: Sol's glow and core from the file, swelling and blazing as each pulse passes and
// dimming between beats
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let p = kh_pulse(b.y) * (1.0 + 0.6 * clamp(uSwing, 0.0, 1.0)) + 1.2 * clamp(uClash, 0.0, 1.0);
    return g * (0.6 + 0.9 * p);
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    let p = kh_pulse(b.y) + 1.2 * clamp(uClash, 0.0, 1.0);
    return c * (0.85 + 0.5 * p);
}

// ---- round 9: the big effects layer ----
// Round 11 (Creyon): its own look, Sol's way: its round-8 effects as part 0, its own parts
// (`part(k)`, the `// @part` lines) and Sol's pieces from its file; nothing shared with the others.
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let col = r8_vol(ro, rd, px) * part(0.0);
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let y0 = L * 0.2;
    let y1 = L * 0.97;
    var fx: vec3<f32> = vec3<f32>(0.0);
    let rose: vec3<f32> = vec3<f32>(1.0, 0.3, 0.5);
    let ph = fract(t * KH_RATE);
    let beat = exp(-ph * 9.0) + 0.6 * exp(-max(ph - 0.22, 0.0) * 9.0) * step(0.22, ph);
    fx += fxFlare(ro, rd, vec3(0.0, L * 0.35, 0.0), px, 0.3, 4.0 + 2.0 * beat, 4.0, 0.785, vec3<f32>(1.0, 0.85, 0.9)) * (0.4 + 1.2 * beat) * part(1.0);
    fx += fxAura(ro, rd, y0, y1, 2.6, rose) * (0.5 + 1.0 * beat) * part(1.0);
    return col + fx * uFx;
}
