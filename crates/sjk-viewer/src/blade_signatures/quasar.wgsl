// Quasar: a galaxy's engine drawn as a blade. The blade is a thin white-violet relativistic jet with
// bright knots racing up it, wrapped in a twisting violet magnetic helix. Round it floats a tilted
// accretion disk, a ring of hot plasma spiralling in (brighter on the side coming toward you), with
// streams of matter peeling off and falling inward. Knots throw bow-shock arcs as they fly, and
// glowing gas blobs are flung off sideways. A swing flares the jet and flings matter; a clash
// fires a giant knot with a shockwave ring off the disk.
fn qs_d(b: vec2<f32>) -> f32 {
    return length(vec2(b.x, max(b.y - (uLength - 0.3), 0.0)));
}

// the disk: centre height, tilt (the ring's height as a fraction of its width), radius
fn qs_dy() -> f32 {
    return uLength * 0.3 + 1.5 * sin(uTime * 0.25);
}

const QS_T: f32 = 0.3;
const QS_R: f32 = 4.6;

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px_in: f32) -> vec3<f32> {
    var px = px_in;
    let L = uLength;
    px = min(px, 0.06);
    let on = smoothstep(-0.5, 0.3, b.y);
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let d = qs_d(b);
    let vio: vec3<f32> = vec3<f32>(0.6, 0.38, 1.0);
    let hot: vec3<f32> = vec3<f32>(1.0, 0.7, 0.4);
    let white: vec3<f32> = vec3<f32>(0.95, 0.93, 1.0);
    // ---- the jet: a thin white core in a violet sheath, pulsing up
    let pulse = 0.75 + 0.25 * sin(b.y * 0.8 - uTime * 11.0);
    var light = white * exp(-pow(d / 0.3, 2.0)) * 1.5 * on + vio * halo(d, 0.75) * 0.55 * pulse * (1.0 + 0.6 * sw) * on + vio * halo(d, 2.0) * 0.08 * on;
    // knots racing up the jet, each throwing a bow-shock arc out to both sides
    for (var i = 0; i < 5; i++) {
        let fi = f32(i);
        let y = glsl_mod(uTime * 16.0 + fi * L / 5.0, L + 6.0) - 2.0;
        let fade = smoothstep(-1.0, 1.0, y) * (1.0 - smoothstep(L - 2.0, L, y));
        light += white * halo(length(vec2(b.x, (b.y - y) * 0.4)), 0.35) * 2.0 * fade;
        // the bow shock: a chevron of light trailing back from the knot
        let ax = abs(b.x);
        let bs = abs(b.y - (y - 0.55 * ax - 0.06 * ax * ax));
        light += vio * halo(bs, 0.06 + 0.03 * ax) * exp(-ax / 1.6) * smoothstep(0.3, 0.9, ax) * fade * 1.1;
    }
    // the magnetic helix twisting round the jet
    let inb = step(0.0, b.y) * step(b.y, L - 0.5);
    let ph = b.y * 0.9 - uTime * 6.0;
    let hx = (0.9 + 0.25 * sin(b.y * 0.2 + uTime)) * sin(ph);
    let front = 0.5 + 0.5 * cos(ph);
    light += vio * (halo(abs(b.x - hx), 0.05) * 1.8 + halo(abs(b.x - hx), 0.3) * 0.2) * (0.3 + 0.7 * front) * inb;
    // ---- the accretion disk: a tilted ring round the blade, matter spiralling in
    let dy = qs_dy();
    let q = vec2(b.x, (b.y - dy) / QS_T);
    let rr = length(q);
    let ang = atan2(q.y, q.x);
    let behind = step(0.0, q.y);
    // the far half, hidden by the jet
    let hide = mix(1.0, 1.0 - exp(-pow(b.x / 0.5, 2.0)), behind);
    let band = exp(-pow((rr - QS_R) / 1.2, 2.0)) + 0.6 * exp(-pow((rr - QS_R * 0.55) / 0.7, 2.0));
    let spiral = 0.55 + 0.45 * sin(ang * 3.0 + log(max(rr, 0.2)) * 6.0 + uTime * 5.0);
    let doppler = 0.55 + 0.45 * cos(ang + 1.57);
    // the approaching side brighter
    let rim = halo(abs(rr - QS_R - 1.1), 0.05);
    let diskC = mix(hot, vec3<f32>(1.0, 0.95, 0.85), smoothstep(QS_R, 1.0, rr));
    light += (diskC * band * spiral * (0.35 + 0.9 * doppler) + vio * rim * 0.6) * hide * (1.0 + 0.7 * cl) * (1.0 - smoothstep(QS_R + 1.8, QS_R + 2.6, rr));
    // matter streams peeling off the disk and falling inward to the jet
    for (var i = 0; i < 6; i++) {
        let fi = f32(i);
        let f = fract(uTime * 0.5 + fi / 6.0);
        let a = fi * 1.047 + uTime * 1.2 + f * 4.0;
        let rad = mix(QS_R + 1.0, 0.4, f * f);
        let p = vec2(rad * cos(a), dy + rad * sin(a) * QS_T + 3.0 * f * f);
        light += mix(hot, white, f) * (halo(length(b - p), 0.16 + 0.12 * (1.0 - f)) * 2.2 + halo(length(b - p), 0.6) * 0.25) * (0.3 + 0.7 * (1.0 - step(0.0, sin(a)) * step(abs(p.x), 0.6)));
    }
    // gas blobs flung off the jet sideways, glowing and cooling
    for (var i = 0; i < 8; i++) {
        let fi = f32(i);
        let ph2 = uTime * (0.4 + 0.25 * h11(fi * 2.3)) + h11(fi * 6.1);
        let cy = floor(ph2);
        let f = fract(ph2);
        if h11(cy * 3.7 + fi) > 0.8 + 0.2 * sw {
            continue;
        }
        let s = select(1.0, -1.0, h11(cy * 1.9 + fi) < 0.5);
        let p = vec2(s * (0.5 + 6.0 * f), (0.35 + 0.6 * h11(cy * 2.7 + fi)) * L + 3.0 * f);
        let rad = 0.2 + 0.35 * f;
        light += mix(white, vio, f) * (halo(length(b - p), rad) * 2.0 + halo(length(b - p), rad * 3.0) * 0.25) * (1.0 - f);
    }
    // clash: a giant knot and a shockwave ring off the disk
    if cl > 0.01 {
        let a = 1.0 - cl;
        let ring = abs(length(vec2(b.x, (b.y - dy) / QS_T)) - QS_R - 5.0 * a);
        light += white * (halo(ring, 0.15) * 1.6 + halo(ring, 0.6) * 0.3) * cl;
        light += white * halo(length(vec2(b.x, (b.y - L * 0.6) * 0.5)), 1.4) * pow(cl, 3.0) * 1.5;
    }
    let edge = 1.0 - smoothstep(8.5, 10.2, abs(b.x));
    light *= edge * (1.0 - smoothstep(L + 0.5, L + 3.5, b.y)) * smoothstep(-3.0, -0.5, b.y);
    return (1.0 - exp(-light * 1.15)) * 1.05;
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return vec3<f32>(0.0);
}

// GLSL's mod: x - y * floor(x / y) (WGSL's % truncates)
fn glsl_mod(x: f32, y: f32) -> f32 {
    return x - y * floor(x / y);
}
