// Paradox: one thin blade made of two, a molten-orange strand and an ice-cyan strand lying side by
// side inside it. Twists run up the blade and the two swap places, passing through each other where
// they meet, and there they cancel into a black knot rimmed with white. Every nine seconds the whole
// blade turns inside out for a moment: its core goes black and its colours trade sides. Clashes swap
// them at once; swinging twists them faster.
const PD_A: vec3<f32> = vec3<f32>(1.0, 0.40, 0.08);

const PD_B: vec3<f32> = vec3<f32>(0.10, 0.80, 1.0);

fn pd_ph() -> f32 {
    return glsl_mod(uTime - 10.8, 9.0);
}

fn pd_inv() -> f32 {
    let p = pd_ph();
    return smoothstep(0.0, 0.15, p) * (1.0 - smoothstep(1.2, 1.5, p));
}

// the twist angle at height y: a staircase in time, so the strands swap and rest in turn
fn pd_phi(y: f32) -> f32 {
    let u = uTime * 0.28 - y / 15.0 + uSwing * 0.6;
    let s = floor(u) + smoothstep(0.30, 0.70, fract(u));
    return 3.14159 * (s + uClash);
}

fn pd_on(b: vec2<f32>) -> f32 {
    return smoothstep(-0.1, 0.4, b.y) * (1.0 - smoothstep(uLength - 0.6, uLength + 0.3, b.y));
}

// rgb light of both strands; a = how close the crossing is (1 at the knot)
fn pd_strands(b: vec2<f32>, px: f32) -> vec4<f32> {
    let phi = pd_phi(b.y);
    let W: f32 = 0.40;
    let xa = W * cos(phi);
    let za = sin(phi);
    let inv = pd_inv();
    let ca = mix(PD_A, PD_B, inv);
    let cb = mix(PD_B, PD_A, inv);
    let da = abs(b.x - xa);
    let db = abs(b.x + xa);
    let wa = 0.13 + 0.03 * za;
    let wb = 0.13 - 0.03 * za;
    var A = ca * (halo(da, 0.33) * 0.9 + fillD(da - wa, px) * 0.9) + mix(ca, vec3<f32>(1.0), 0.6) * fillD(da - wa * 0.45, px) * 0.9;
    var B = cb * (halo(db, 0.33) * 0.9 + fillD(db - wb, px) * 0.9) + mix(cb, vec3<f32>(1.0), 0.6) * fillD(db - wb * 0.45, px) * 0.9;
    // the one behind is dimmer
    A *= mix(0.55, 1.0, smoothstep(-0.6, 0.6, za));
    B *= mix(0.55, 1.0, smoothstep(-0.6, 0.6, -za));
    let cross = 1.0 - smoothstep(0.05, 0.32, abs(xa));
    return vec4((A + B) * pd_on(b), cross);
}

fn paradox_glow0(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let L = uLength;
    let s = pd_strands(b, px);
    let inv = pd_inv();
    // each side of the glow takes its strand's colour
    let phi = pd_phi(b.y);
    let side = cos(phi) * sign(b.x + 1.0e-4);
    let left = mix(PD_A, PD_B, inv);
    let right = mix(PD_B, PD_A, inv);
    let tint = mix(right, left, smoothstep(-0.4, 0.4, side));
    let bd = length(vec2(b.x, max(b.y - L, 0.0) + max(-b.y, 0.0) * 4.0));
    let glow_ = tint * (halo(bd, 1.1) * 0.45 + halo(bd, 2.3) * 0.2) * smoothstep(-0.3, 0.3, b.y);
    // the crossing: the two cancel, a rim of white light round the void
    let kn = s.a;
    let rim = vec3<f32>(1.0) * halo(abs(abs(b.x) - 0.42), 0.06 + px) * kn * 1.4 * pd_on(b);
    // a sparkle of paradox motes leaking from each knot
    var mote: f32 = 0.0;
    for (var i = 0; i < 6; i++) {
        let fi = f32(i);
        let age = fract(uTime * 0.7 + h11(fi * 3.3));
        let y = h11(fi + floor(uTime * 0.7 + h11(fi * 3.3)) * 7.1) * L;
        let side2 = (select(1.0, -1.0, h11(fi * 5.1) < 0.5));
        let p = vec2(side2 * (0.6 + age * 1.4), y + age * 1.2);
        mote += fillD(length(b - p) - 0.05 * (1.0 - age), px) * (1.0 - age) * (1.0 - smoothstep(0.05, 0.3, abs(cos(pd_phi(y)))));
    }
    return glow_ * (1.0 - 0.6 * kn * pd_on(b)) + s.rgb * (1.0 - 0.8 * kn) + rim + vec3<f32>(0.9, 0.95, 1.0) * mote * 1.2 + mix(vec3<f32>(1.0), tint, 0.4) * uClash * halo(bd, 1.3) * 0.8 + g * 0.05;
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return vec3<f32>(0.0);
}

fn sig_solid(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let s = pd_strands(b, px);
    let on = pd_on(b);
    // the black knot where the strands pass through each other
    let kn = smoothstep(0.35, 0.9, s.a) * (1.0 - smoothstep(0.30, 0.42, abs(b.x))) * on;
    // inside out: the blade's own core goes black for a moment
    let inv = pd_inv();
    let neg = inv * (1.0 - smoothstep(0.10, 0.22, abs(b.x))) * on;
    let a = max(kn * 0.92, neg * 0.95);
    return vec4(mix(o.rgb, vec3<f32>(0.0), a), max(o.a, a));
}

// ==== show (added) ====
// Paradox show: fire and ice off the two strands: on one side molten flames and embers lick away,
// on the other frost crystals and cold mist drift off; every few seconds they swap sides, passing
// through the blade. Impossible triangles float round it, turning. A swing throws fire and frost
// out together; a clash cancels them in a black-and-white flash ring.
fn paradox_show(b: vec2<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let fire: vec3<f32> = vec3<f32>(1.0, 0.5, 0.12);
    let ice: vec3<f32> = vec3<f32>(0.45, 0.9, 1.0);
    var light: vec3<f32> = vec3<f32>(0.0);
    let swap = sign(sin(uTime * 0.7));
    let sm = smoothstep(-0.3, 0.3, sin(uTime * 0.7));
    for (var i = 0; i < 12; i++) {
        let fi = f32(i);
        let ph = uTime * (0.5 + 0.25 * h11(fi * 2.3)) + h11(fi * 6.7);
        let cy = floor(ph);
        let f = fract(ph);
        let isFire = glsl_mod(fi, 2.0);
        let s = (select(-1.0, 1.0, isFire > 0.5)) * mix(-1.0, 1.0, sm);
        let y0 = (0.08 + 0.85 * h11(cy * 1.7 + fi)) * L;
        let fade = (1.0 - f) * smoothstep(0.0, 0.08, f);
        if isFire > 0.5 {
            let p = vec2(s * (0.5 + 4.0 * f) + 0.4 * sin(f * 9.0 + fi), y0 + 3.5 * f);
            light += mix(vec3<f32>(1.0, 0.9, 0.5), fire, f) * (halo(length(b - p), 0.12) * 2.2 + halo(length(b - p), 0.45) * 0.35) * fade;
            let u = (b.x * s - 0.4) / 2.4;
            if u > 0.0 && u < 1.0 {
                let dy = b.y - y0 - 2.0 * u * u - 0.4 * sin(u * 8.0 - uTime * 11.0) * u;
                light += fire * exp(-pow(dy / (0.28 * (1.0 - u) + 0.04), 2.0)) * (1.0 - u) * fade * 1.2;
            }
        } else {
            let p = vec2(s * (0.6 + 4.5 * f), y0 - 1.5 * f);
            var q = (b - p) / 1.3;
            let r = length(q);
            let a = atan2(q.y, q.x) + uTime + fi;
            let arm = halo(abs(sin(a * 3.0)) * r, 0.03) * step(r, 0.4);
            light += ice * (arm * 1.5 + halo(r, 0.07) * 1.2) * fade + ice * halo(length(b - p), 1.0) * 0.08 * fade;
        }
    }
    for (var i = 0; i < 3; i++) {
        let fi = f32(i);
        let c = vec2((select(1.0, -1.0, glsl_mod(fi, 2.0) < 0.5)) * (4.0 + 0.5 * sin(uTime + fi)), (0.25 + 0.25 * fi) * L);
        var q = b - c;
        let an = uTime * 0.6 + fi * 2.0;
        q = vec2(q.x * cos(an) - q.y * sin(an), q.x * sin(an) + q.y * cos(an));
        var d: f32 = 1.0e3;
        for (var k = 0; k < 3; k++) {
            let a0 = f32(k) * 2.094;
            let a1 = a0 + 2.094;
            let p0 = vec2(cos(a0), sin(a0)) * 1.1;
            let p1 = vec2(cos(a1), sin(a1)) * 1.1;
            let p2 = p0 * 0.55;
            let p3 = p1 * 0.55 + (p0 - p1) * 0.12;
            d = min(d, min(sdSeg(q, p0, p1), sdSeg(q, p2, p3)));
            d = min(d, sdSeg(q, p0, p2 + (p1 - p0) * 0.1));
        }
        light += mix(fire, ice, 0.5 + 0.5 * sin(uTime + fi)) * (exp(-pow(d / 0.04, 2.0)) * 1.2 + halo(d, 0.2) * 0.15);
    }
    if cl > 0.01 {
        let o = vec2(0.0, L * 0.6);
        let rr = abs(length(b - o) - 1.0 - 7.0 * (1.0 - cl));
        light += vec3<f32>(1.0) * halo(rr, 0.1) * cl * 1.6 + mix(fire, ice, step(0.0, b.x - o.x)) * halo(rr - 0.4, 0.2) * cl;
    }
    let edge = 1.0 - smoothstep(8.5, 10.2, abs(b.x));
    light *= edge * (1.0 - smoothstep(L + 0.5, L + 3.5, b.y)) * smoothstep(-3.0, -0.5, b.y);
    return (1.0 - exp(-light * 1.15)) * 1.05;
}

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    return paradox_glow0(g, b, r, px) + paradox_show(b, min(px, 0.06));
}

// GLSL's mod: x - y * floor(x / y) (WGSL's % truncates)
fn glsl_mod(x: f32, y: f32) -> f32 {
    return x - y * floor(x / y);
}
